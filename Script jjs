loadModule("Movement", Tab_Movement, function()
local function safeGetService(name)
    local service = game:GetService(name)
    return (cloneref and cloneref(service)) or service
end

return function(MovementTab)
    local Players = safeGetService("Players")
    local ReplicatedStorage = safeGetService("ReplicatedStorage")
    local Workspace = safeGetService("Workspace")
    local RunService = safeGetService("RunService")
    local UserInputService = safeGetService("UserInputService")
    local VirtualInputManager = safeGetService("VirtualInputManager")

    local LocalPlayer = Players.LocalPlayer
    local Camera = Workspace.CurrentCamera

    Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        if Workspace.CurrentCamera then
            Camera = Workspace.CurrentCamera
        end
    end)

    local BASE_JUMP_VELOCITY = 40.0

    local Settings = {
        InfDashEnabled = false,
        DashKeybind = Enum.KeyCode.Q,
        CooldownTime = 1.2,
        DashDuration = 0.85,
        CFrameSpeed = 65,
        M1PreTriggerTime = 0.15,
        AutoM1OnDash = true,

        QuickRollsEnabled = false,
        JumpPowerMultiplier = 1.70,

        SpeedDemonEnabled = false,
        SpeedDemonJumpMult = 2.0,
        SpeedDemonSpeedMult = 1.2
    }

    local State = {
        IsDashing = false,
        LastExecuted = 0,
        ScreenGuiInstance = nil,
        ActiveConnections = {}
    }

    local CharacterAnimMap = {
        ["ryu"]        = "83782195794718",
        ["locust"]     = "130284226842903",
        ["charles"]    = "14059732023798",
        ["hakari"]     = "99451940496871",
        ["hiromi"]     = "132855702748568",
        ["higuruma"]   = "132855702748568",
        ["itadori"]    = "110978068388232",
        ["gojo"]       = "110978068388232",
        ["megumi"]     = "110978068388232",
        ["mahito"]     = "110978068388232",
        ["sukuna"]     = "110978068388232"
    }
    local DefaultDashAnim = "110978068388232"

    local function ResolveKeyCode(val)
        if typeof(val) == "EnumItem" then
            return val
        end
        if type(val) == "string" and Enum.KeyCode[val] then
            return Enum.KeyCode[val]
        end
        return nil
    end

    local function GetSafeGuiParent()
        local success, parent = pcall(function()
            if gethui then return gethui() end
            return game:GetService("CoreGui")
        end)
        if success and parent then return parent end
        return LocalPlayer:WaitForChild("PlayerGui")
    end

    local function ResetVelocity(hrp)
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end

    local function GetCurrentMoveset()
        local char = LocalPlayer.Character
        if not char then return "Itadori" end
        local ms = char:GetAttribute("Moveset") or LocalPlayer:GetAttribute("Moveset")
        if ms and tostring(ms) ~= "" then return tostring(ms) end

        local movesetFolder = char:FindFirstChild("Moveset")
        if movesetFolder then
            return movesetFolder:IsA("StringValue") and movesetFolder.Value or movesetFolder.Name
        end
        return "Itadori"
    end

    local function GetDynamicDashAnim()
        local moveset = GetCurrentMoveset()
        local cleanKey = string.lower(moveset):gsub("%s+", ""):gsub("[^%a%d]", "")
        return CharacterAnimMap[cleanKey] or DefaultDashAnim
    end

    local function FireXenoM1(targetModel)
        local char = LocalPlayer.Character
        if not char then return end

        local moveset = GetCurrentMoveset()
        local rawName = (moveset == "Makora" and "Mahoraga") or moveset
        local cleanName = string.gsub(rawName, "%s+", "")

        local knit = ReplicatedStorage:FindFirstChild("Knit")
        local services = knit and knit:FindFirstChild("Knit") and knit.Knit:FindFirstChild("Services")
        local svc = services and services:FindFirstChild(cleanName .. "Service")
        local re = svc and svc:FindFirstChild("RE")
        local activated = re and re:FindFirstChild("Activated")

        if activated then
            pcall(function()
                activated:FireServer(false, targetModel)
            end)
        else
            pcall(function()
                if services then
                    for _, s in ipairs(services:GetChildren()) do
                        if string.find(s.Name, "Service") and s:FindFirstChild("RE") then
                            local act = s.RE:FindFirstChild("Activated")
                            if act then
                                act:FireServer(false, targetModel)
                                break
                            end
                        end
                    end
                end
            end)
        end

        if UserInputService.KeyboardEnabled and UserInputService.MouseEnabled then
            if mouse1click then
                pcall(mouse1click)
            elseif VirtualInputManager then
                pcall(function()
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                    task.wait(0.02)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                end)
            end
        end
    end

    local function GetNearestEnemy(maxDistance)
        local nearest, shortestDist = nil, maxDistance or 50
        local char = LocalPlayer.Character
        if not char then return nil end
        local myHRP = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
        if not myHRP then return nil end

        local searchFolder = Workspace:FindFirstChild("Characters") or Workspace
        for _, obj in ipairs(searchFolder:GetChildren()) do
            if obj:IsA("Model") and obj ~= char then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local targetHRP = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                if hum and targetHRP and hum.Health > 0 and not obj:FindFirstChildOfClass("ForceField") then
                    local dist = (targetHRP.Position - myHRP.Position).Magnitude
                    if dist <= shortestDist then
                        shortestDist = dist
                        nearest = obj
                    end
                end
            end
        end
        return nearest
    end

    local function GetActiveJumpMultiplier()
        if Settings.SpeedDemonEnabled then
            return Settings.SpeedDemonJumpMult
        elseif Settings.QuickRollsEnabled then
            return Settings.JumpPowerMultiplier
        end
        return 1.0
    end

    local function HookCharacter(char)
        if not char then return end
        local hum = char:WaitForChild("Humanoid", 5)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if not hum or not hrp then return end

        for _, conn in ipairs(State.ActiveConnections) do
            pcall(function() conn:Disconnect() end)
        end
        State.ActiveConnections = {}

        local jumpConn = hum.StateChanged:Connect(function(_, newState)
            if newState == Enum.HumanoidStateType.Jumping then
                local mult = GetActiveJumpMultiplier()
                if mult > 1.0 then
                    local targetY = BASE_JUMP_VELOCITY * math.sqrt(mult)
                    local frames = 2
                    local stepConn
                    local stepEvent = RunService.PreSimulation or RunService.Stepped or RunService.Heartbeat
                    stepConn = stepEvent:Connect(function()
                        if frames <= 0 or not hrp or not hrp.Parent then
                            stepConn:Disconnect()
                            return
                        end
                        hrp.AssemblyLinearVelocity = Vector3.new(
                            hrp.AssemblyLinearVelocity.X,
                            targetY,
                            hrp.AssemblyLinearVelocity.Z
                        )
                        frames = frames - 1
                    end)
                end
            end
        end)

        table.insert(State.ActiveConnections, jumpConn)
    end

    local function ExecuteInfDash()
        if not Settings.InfDashEnabled or State.IsDashing then return end
        local now = os.clock()
        if now - State.LastExecuted < Settings.CooldownTime then return end

        local char = LocalPlayer.Character
        local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        State.IsDashing = true
        State.LastExecuted = now

        local initialHealth = hum.Health
        local animId = GetDynamicDashAnim()
        local track = nil

        pcall(function()
            local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
            local anim = Instance.new("Animation")
            anim.AnimationId = "rbxassetid://" .. animId
            track = animator:LoadAnimation(anim)
            track.Priority = Enum.AnimationPriority.Action
            track:Play()
        end)

        local startTime = os.clock()
        local m1Triggered = false
        local m1Time = 0
        local lockedEnemy = nil
        local connection

        connection = RunService.Heartbeat:Connect(function(dt)
            local nowTime = os.clock()
            local elapsed = nowTime - startTime

            local isStunned = false
            local infoFolder = char:FindFirstChild("Info")
            if infoFolder then
                if infoFolder:FindFirstChild("Stun") or infoFolder:FindFirstChild("Knockback") then
                    isStunned = true
                end
            end
            if (char:GetAttribute("Ragdoll") or 0) > 0 then
                isStunned = true
            end

            local wasHit = (hum.Health < initialHealth) or isStunned
            local timeExpired = elapsed >= Settings.DashDuration
            local m1Finished = m1Triggered and ((nowTime - m1Time) >= 0.20)

            local reachedTarget = false
            if lockedEnemy and lockedEnemy.Parent then
                local eHrp = lockedEnemy:FindFirstChild("HumanoidRootPart") or lockedEnemy:FindFirstChild("Torso")
                if eHrp then
                    local currentDist = (eHrp.Position - hrp.Position).Magnitude
                    if currentDist <= 1.0 then
                        reachedTarget = true
                    end
                end
            end

            if timeExpired or wasHit or m1Finished or reachedTarget or not hrp.Parent or hum.Health <= 0 then
                connection:Disconnect()
                if track then track:Stop(0.1) end
                ResetVelocity(hrp)
                State.IsDashing = false
                return
            end

            local camLook = Camera.CFrame.LookVector
            local moveDir = Vector3.new(camLook.X, 0, camLook.Z)
            if moveDir.Magnitude > 0.01 then
                moveDir = moveDir.Unit
            else
                moveDir = hrp.CFrame.LookVector
            end

            if lockedEnemy and lockedEnemy.Parent then
                local eHrp = lockedEnemy:FindFirstChild("HumanoidRootPart") or lockedEnemy:FindFirstChild("Torso")
                if eHrp then
                    local dirToEnemy = (eHrp.Position - hrp.Position)
                    local flatDir = Vector3.new(dirToEnemy.X, 0, dirToEnemy.Z)
                    if flatDir.Magnitude > 0.05 then
                        moveDir = flatDir.Unit
                    end
                end
            end

            local activeSpeed = Settings.CFrameSpeed
            if Settings.SpeedDemonEnabled then
                activeSpeed = activeSpeed * Settings.SpeedDemonSpeedMult
            end

            local step = moveDir * (activeSpeed * dt)
            hrp.CFrame = CFrame.new(hrp.Position + step) * CFrame.lookAt(Vector3.zero, moveDir).Rotation
            ResetVelocity(hrp)

            if Settings.AutoM1OnDash and not m1Triggered then
                local enemy = GetNearestEnemy(35)
                if enemy then
                    local eHrp = enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChild("Torso")
                    if eHrp then
                        local toEnemy = (eHrp.Position - hrp.Position)
                        local dist = toEnemy.Magnitude
                        local dirToEnemy = toEnemy.Unit

                        if moveDir:Dot(dirToEnemy) >= 0.60 then
                            local closingSpeed = math.max(activeSpeed, 10)
                            local timeToImpact = dist / closingSpeed

                            if timeToImpact <= Settings.M1PreTriggerTime or dist <= 7.0 then
                                m1Triggered = true
                                m1Time = os.clock()
                                lockedEnemy = enemy
                                FireXenoM1(enemy)
                            end
                        end
                    end
                end
            end
        end)
