    -- UI REGISTRATION (RAYFIELD / FLUENT / LINORIA)
    ---------------------------------------------------------------------------
    PremiumTab:CreateSection("Bypass & Stealth")

    PremiumTab:CreateToggle({
        Name = "AC Bypass",
        CurrentValue = false,
        Callback = secureAction(function(val)
            toggleACBypass(val)
        end)
    })

    PremiumTab:CreateToggle({
        Name = "True Desync Invisibility",
        CurrentValue = false,
        Callback = secureAction(function(val)
            if val then
                startInvisibility(LocalPlayer.Character)
            else
                stopInvisibility()
            end
        end)
    })

    PremiumTab:CreateSection("Stand Management")

    PremiumTab:CreateToggle({
        Name = "Enable Stand Mode",
        CurrentValue = false,
        Callback = secureAction(function(val)
            standEnabled = val
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if standEnabled then
                if hum then hum.PlatformStand = true end
                if hrp then
                    if not standBP then
                        standBP = Instance.new("BodyPosition", hrp)
                        standBP.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                        standBP.P = 140000
                        standBP.D = 1800
                    end
                    if not standBG then
                        standBG = Instance.new("BodyGyro", hrp)
                        standBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
                        standBG.P = 2e6
                        standBG.D = 120
                    end
                end
                createStandMobileGui()
                if not standVanished then playStandIdle() end
            else
                stopStandIdle()
                if hum then hum.PlatformStand = false end
                if standBP then standBP:Destroy() standBP = nil end
                if standBG then standBG:Destroy() standBG = nil end
                destroyStandMobileGui()
            end
        end)
    })

    PremiumTab:CreateInput({
        Name = "Master Target Player",
        PlaceholderText = "Username or Display Name...",
        RemoveTextAfterFocusLost = false,
        Callback = secureAction(function(text)
            standTargetName = text
        end)
    })

    PremiumTab:CreateDropdown({
        Name = "Stand Position Side",
        Options = {"Right", "Left"},
        CurrentOption = "Right",
        Callback = secureAction(function(opt)
            local chosen = type(opt) == "table" and opt[1] or opt
            standPositionSide = chosen
            standActiveOffset = (standPositionSide == "Left") and LEFT_OFFSET or RIGHT_OFFSET
        end)
    })
end

