        local shortestDist = maxRange

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local tChar = player.Character
                if not isTargetInvalid(tChar) and not tChar:FindFirstChildOfClass("ForceField") then
                    local hrp = tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("Torso")
                    if hrp then
                        local dist = (hrp.Position - myPos).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            nearest = tChar
                        end
                    end
                end
            end
        end

        if not nearest then
            local liveFolder = workspace:FindFirstChild("Live") or workspace:FindFirstChild("Characters")
            if liveFolder then
                for _, model in ipairs(liveFolder:GetChildren()) do
                    if model:IsA("Model") and model ~= char and not Players:GetPlayerFromCharacter(model) then
                        if not isTargetInvalid(model) and not model:FindFirstChildOfClass("ForceField") then
                            local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
                            if hrp then
                                local dist = (hrp.Position - myPos).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    nearest = model
                                end
                            end
