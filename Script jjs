                            local bSize = btn.AbsoluteSize

                            local targetX = math.clamp(startPos.X.Offset + delta.X, 0, math.max(0, vp.X - bSize.X))
                            local targetY = math.clamp(startPos.Y.Offset + delta.Y, 0, math.max(0, vp.Y - bSize.Y))
                            btn.Position = UDim2.new(startPos.X.Scale, targetX, startPos.Y.Scale, targetY)
                        end
                    end
