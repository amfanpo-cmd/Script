            local Binding = false
            local lastKeyTriggerTime = 0
            local flag = Config.Flag or (type(IdOrConfig) == "string" and IdOrConfig)

            local KeybindObject = {}
            KeybindObject.GetKey = function()
                return CurrentKey
            end
            KeybindObject.SetToNone = function()
                CurrentKey = "None"
                KeyBtn.Text = "None"
                KeyBtn.TextColor3 = Rayfield.Theme.TextDark
                if flag then Rayfield.Flags[flag] = "None" end
                if Config.ChangedCallback then
                    pcall(Config.ChangedCallback, "None")
                end
            end
            KeybindObject.CancelBinding = function()
                Binding = false
                KeyBtn.Text = CurrentKey
                KeyBtn.TextColor3 = Rayfield.Theme.TextDark
            end

            registerKeybind(KeybindObject)
            enforceAntiOverlap(KeybindObject, CurrentKey)

            KeyBtn.MouseButton1Click:Connect(function()
                if ActiveBindingKeybind and ActiveBindingKeybind ~= KeybindObject then
                    ActiveBindingKeybind.CancelBinding()
                end
                ActiveBindingKeybind = KeybindObject
                Binding = true
                KeyBtn.Text = "..."
                KeyBtn.TextColor3 = Rayfield.Theme.Text
            end)

            local keyConn
            keyConn = UserInputService.InputBegan:Connect(function(input, gpe)
                if Binding then
                    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode and input.KeyCode ~= Enum.KeyCode.Unknown then
                        Binding = false
                        ActiveBindingKeybind = nil
                        local chosenKey = input.KeyCode.Name

                        if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
                            chosenKey = "None"
                        end

                        CurrentKey = chosenKey
                        KeyBtn.Text = CurrentKey
                        KeyBtn.TextColor3 = Rayfield.Theme.TextDark
                        if flag then Rayfield.Flags[flag] = CurrentKey end

                        enforceAntiOverlap(KeybindObject, CurrentKey)

                        if Config.ChangedCallback then
                            pcall(Config.ChangedCallback, CurrentKey)
                        end
                        return
                    elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
                        Binding = false
                        ActiveBindingKeybind = nil
                        KeyBtn.Text = CurrentKey
                        KeyBtn.TextColor3 = Rayfield.Theme.TextDark
                        return
                    end
                end

                if gpe or UserInputService:GetFocusedTextBox() ~= nil then return end

                if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode and input.KeyCode ~= Enum.KeyCode.Unknown then
                    if CurrentKey ~= "None" and input.KeyCode.Name == CurrentKey then
                        local now = os.clock()
                        if (now - lastKeyTriggerTime) > 0.15 then
                            lastKeyTriggerTime = now
                            notifyFeatureActivated()
                            if Config.Callback then
                                task.spawn(function()
                                    pcall(Config.Callback, CurrentKey)
                                end)
                            elseif Config.ChangedCallback then
                                task.spawn(function()
                                    pcall(Config.ChangedCallback, CurrentKey)
                                end)
                            end
                        end
                    end
                end
            end)

            if flag then Rayfield.Flags[flag] = CurrentKey end
            queuePageUpdate()

            return {
                Set = function(_, newKey)
                    local resolved = typeof(newKey) == "EnumItem" and newKey.Name or tostring(newKey)
