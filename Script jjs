                severingVal:SetAttribute("Service", "SeveringPathService")
                severingVal:SetAttribute("Tip", "DIRECTION")
                severingVal.Parent = movesetFolder
            end
        end
    end

    local function ExecuteGetsugaSequence()
        CleanPlayerEffects()

        local targetChar = GetValidTarget()
        if not targetChar or not targetChar:FindFirstChild("HumanoidRootPart") then 
            return false, 0
        end

        local myChar = LocalPlayer.Character
        if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return false, 0 end

        local myHRP = myChar.HumanoidRootPart
        local targetHRP = targetChar.HumanoidRootPart
        local startTime = os.clock()

        StartTargetLock(targetHRP)

        local humanoid = myChar:FindFirstChildOfClass("Humanoid")
        local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
        local freezeTrack = nil

        if animator then
            pcall(function()
                local anim1 = Instance.new("Animation")
                anim1.AnimationId = "rbxassetid://89582140026963"
                freezeTrack = animator:LoadAnimation(anim1)
                activeTracks[freezeTrack] = true
                freezeTrack:Play()
                freezeTrack.TimePosition = 1.28
                freezeTrack:AdjustSpeed(0)
            end)
        end

        local targetCF = targetHRP.CFrame
        local currentDist = (targetHRP.Position - myHRP.Position).Magnitude
        local distHalf = currentDist / 2

        local tp1Pos = targetCF.Position + (targetCF.RightVector * -20) + (targetCF.LookVector * distHalf)
        myHRP.CFrame = CFrame.lookAt(tp1Pos, targetHRP.Position)
        pcall(function() loadstring(game:HttpGet("https://pastebin.com/raw/0Z3PiuQ8"))() end)

        task.wait(0.5)

        if not targetHRP or not targetHRP.Parent or not myHRP or not myHRP.Parent then 
            if freezeTrack then freezeTrack:Stop() end
            StopTargetLock()
            local elapsed = os.clock() - startTime
            return false, (elapsed >= 0.7) and 15 or 3
        end

        if targetHRP and targetHRP.Parent then
            targetCF = targetHRP.CFrame
            local tp2Pos = targetCF.Position - (targetCF.LookVector * 3)
            myHRP.CFrame = CFrame.lookAt(tp2Pos, targetHRP.Position)
        end

        pcall(function()
            local Event = ReplicatedStorage.Knit.Knit.Services.SeveringPathService.RE.Activated
            local severingObj = myChar:FindFirstChild("Moveset") and myChar.Moveset:FindFirstChild("Severing Path")
            if Event and severingObj then
                Event:FireServer(severingObj, Vector3.new(0, 0, 0))
            end
        end)

        pcall(function() loadstring(game:HttpGet(MOVE1_HIT_VFX_URL))() end)

        if freezeTrack then freezeTrack:Stop() end

        if animator then
            pcall(function()
                local anim2 = Instance.new("Animation")
                anim2.AnimationId = "rbxassetid://76118979198026"
                local track2 = animator:LoadAnimation(anim2)
                activeTracks[track2] = true
                track2:Play()
                track2.TimePosition = 0
                track2:AdjustSpeed(1.1)

                task.delay(0.5, function()
                    if track2 and track2.IsPlaying then track2:Stop() end
                end)
            end)
        end

        StopTargetLock()

        local totalElapsed = os.clock() - startTime
        return true, (totalElapsed >= 0.7) and 15 or 3
    end

    ----------------------------------------------------------------------------
    -- INITIALIZE UPON TRIGGER
    ----------------------------------------------------------------------------
    local function Init()
        StopAllEffects()
        SetupMovesetValues()
        MovesetLib:HideDefaultMoves()
        SetupCustomUltimateBar()
        UpdateUltBarFill()

        if LocalPlayer.Character then
            SetupAnimationMonitor(LocalPlayer.Character)
            ListenForIchigoEquip(LocalPlayer.Character)
            PlayRespawnOrEquipEffect(LocalPlayer.Character)
        end

