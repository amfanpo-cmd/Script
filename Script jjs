    ---------------------------------------------------------------------------
    -- FEATURE 2B: Blind Rage Downward Slam
    ---------------------------------------------------------------------------
    local function engageBlindRageDownwardSlam(track)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        local triggered = false
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if not Settings.BlindRageDownwardSlam or not track.IsPlaying or not hrp.Parent then
                conn:Disconnect()
                return
            end

            if track.TimePosition >= 2.9 and not triggered then
                triggered = true
                hum.AutoRotate = false

                local suppressedMovers = {}
                local function neutralizeMover(mover)
                    if mover:IsA("BodyVelocity") or mover:IsA("BodyPosition") or mover:IsA("BodyForce") or mover:IsA("BodyThrust") then
                        if mover.Name ~= "BlindRageDiveBV" then
                            table.insert(suppressedMovers, {mover = mover, oldMaxForce = mover.MaxForce})
                            mover.MaxForce = Vector3.zero
                        end
                    elseif mover:IsA("LinearVelocity") or mover:IsA("VectorForce") then
                        if mover.Name ~= "BlindRageDiveLV" then
                            table.insert(suppressedMovers, {mover = mover, oldEnabled = mover.Enabled})
                            mover.Enabled = false
                        end
                    end
                end

                for _, desc in ipairs(char:GetDescendants()) do
                    if desc:IsA("BodyMover") or desc:IsA("Constraint") then
                        neutralizeMover(desc)
                    end
                end

                local childConn = hrp.ChildAdded:Connect(function(child)
                    neutralizeMover(child)
                end)

                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero

                local bg = Instance.new("BodyGyro")
                bg.Name = "BlindRageDiveGyro"
                bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
                bg.P = 100000
                bg.D = 80
                bg.Parent = hrp

                local bv = Instance.new("BodyVelocity")
                bv.Name = "BlindRageDiveBV"
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.P = math.huge
                bv.Parent = hrp

                local physicsConn
                physicsConn = RunService.PreSimulation:Connect(function(dt)
                    if not track.IsPlaying or not hrp.Parent then return end

                    local camLook = Camera.CFrame.LookVector
                    local horizForward = Vector3.new(camLook.X, 0, camLook.Z)
                    if horizForward.Magnitude < 0.01 then
                        horizForward = -Vector3.zAxis
                    else
                        horizForward = horizForward.Unit
                    end

                    local downCF = CFrame.lookAt(hrp.Position, hrp.Position - Vector3.new(0, 1, 0), horizForward)
                    bg.CFrame = downCF
                    hrp.CFrame = CFrame.new(hrp.Position) * downCF.Rotation

                    local forwardVelocity = horizForward * Settings.DownslamForwardSpeed
                    local downwardVelocity = Vector3.new(0, -220, 0)
                    local currentVelocity = forwardVelocity + downwardVelocity

                    bv.Velocity = currentVelocity
                    hrp.AssemblyLinearVelocity = currentVelocity
                    hrp.AssemblyAngularVelocity = Vector3.zero
                    hrp.CFrame = hrp.CFrame + (currentVelocity * dt)
                end)

                local function cleanup()
                    if physicsConn then physicsConn:Disconnect() end
                    if childConn then childConn:Disconnect() end
                    if bv and bv.Parent then bv:Destroy() end
                    if bg and bg.Parent then bg:Destroy() end
                    if hum and hum.Parent then hum.AutoRotate = true end

                    for _, data in ipairs(suppressedMovers) do
                        if data.mover and data.mover.Parent then
                            if data.oldMaxForce then
                                data.mover.MaxForce = data.oldMaxForce
                            elseif data.oldEnabled ~= nil then
                                data.mover.Enabled = data.oldEnabled
                            end
                        end
                    end
                end

                track.Stopped:Connect(cleanup)
            end
        end)
    end

    ---------------------------------------------------------------------------
    -- FEATURE 3: Better M1 thingy
    ---------------------------------------------------------------------------
    local function executeAirCombo()
        if State.IsAirComboRunning or not Settings.BetterM1Thingy then return end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        local targetHrp = getAirComboTarget()
        if not targetHrp then return end

        State.IsAirComboRunning = true

        local lookStartTime = os.clock()
        local lookConn
        lookConn = RunService.RenderStepped:Connect(function()
            local elapsed = os.clock() - lookStartTime
            if elapsed >= 0.3 or not targetHrp.Parent or not hrp.Parent then
                lookConn:Disconnect()
                return
            end

            local lookCF = CFrame.lookAt(hrp.Position, targetHrp.Position)
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetHrp.Position)
            hrp.CFrame = CFrame.new(hrp.Position) * lookCF.Rotation
        end)

        local glideDuration = 0.13
        local glideStartTime = os.clock()

        local bv = Instance.new("BodyVelocity")
        bv.Name = "AirComboGlide"
        bv.MaxForce = Vector3.new(1e8, 1e8, 1e8)
        bv.Parent = hrp

        local glideConn
        glideConn = RunService.Heartbeat:Connect(function()
            local elapsed = os.clock() - glideStartTime
            local alpha = math.clamp(elapsed / glideDuration, 0, 1)

            if alpha >= 1 or not targetHrp.Parent or not hrp.Parent then
                glideConn:Disconnect()
                if bv and bv.Parent then bv:Destroy() end
                hrp.AssemblyLinearVelocity = Vector3.zero
                State.IsAirComboRunning = false
                return
            end

            local currentTargetPos = targetHrp.Position
            local direction = (currentTargetPos - hrp.Position)
            local distance = direction.Magnitude
            local speedNeeded = distance / math.max(0.01, (glideDuration - elapsed))

            bv.Velocity = direction.Unit * math.clamp(speedNeeded, 0, 500)
        end)
    end

