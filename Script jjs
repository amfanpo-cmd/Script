    local isFlipping = false
    local function ExecuteBackflip()
        if isFlipping then return end
        local char = LocalPlayer.Character
        local hrp = getRootPart(char)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        isFlipping = true

        local duration = math.clamp(Settings.BackflipSpeed, 0.1, 1.5)
        local rotations = Settings.BackflipRotations
        local height = Settings.BackflipHeight
        local netForward = Settings.BackflipForward - Settings.BackflipBackward

        local startCF = hrp.CFrame
        local forwardDir = startCF.LookVector
        local upDir = Vector3.new(0, 1, 0)
        local startTime = os.clock()
        local totalAngle = rotations * math.pi * 2

        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bv.Parent = hrp

        local bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(1e6, 0, 1e6)
        bg.P = 30000
        bg.D = 250
        bg.Parent = hrp

        local conn
        conn = RunService.RenderStepped:Connect(function()
            local elapsed = os.clock() - startTime
            local alpha = math.clamp(elapsed / duration, 0, 1)

            if alpha >= 1 or not hrp.Parent or hum.Health <= 0 then
                conn:Disconnect()
                bv:Destroy()
                bg:Destroy()
                if hrp.Parent then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
                isFlipping = false
                return
            end

            local verticalVel = upDir * ((4 * height / duration) * (1 - 2 * alpha))
            local forwardVel = forwardDir * (netForward / duration)

            bv.Velocity = forwardVel + verticalVel
            bg.CFrame = startCF * CFrame.Angles(-totalAngle * alpha, 0, 0)
        end)
    end

