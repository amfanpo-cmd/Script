                local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                local tHum = p.Character:FindFirstChildOfClass("Humanoid")
                if tHrp and tHum and tHum.Health > 0 then
                    local delta = tHrp.Position - myPos
                    local heightDiff = delta.Y
                    local totalDistSq = (delta.X * delta.X) + (delta.Y * delta.Y) + (delta.Z * delta.Z)

                    if heightDiff >= 15 and totalDistSq <= shortestDistSq then
                        shortestDistSq = totalDistSq
                        bestTarget = tHrp
                    end
                end
            end
        end

        if not bestTarget then
            local charsFolder = Workspace:FindFirstChild("Characters")
            local searchList = charsFolder and charsFolder:GetChildren() or Workspace:GetChildren()
            for _, obj in ipairs(searchList) do
