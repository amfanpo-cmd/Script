        local DRAG_THRESHOLD = 8
        local activeInput = nil
        local isDragging = false
        local dragStart = Vector3.zero
        local startPos = UDim2.new()
        local moveConn, endConn, cancelConn

        local function cleanupDrag()
            activeInput = nil
            isDragging = false
            if moveConn then moveConn:Disconnect() moveConn = nil end
            if endConn then endConn:Disconnect() endConn = nil end
            if cancelConn then cancelConn:Disconnect() cancelConn = nil end
        end

        btn.InputBegan:Connect(function(input)
            if activeInput ~= nil then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                activeInput = input
                isDragging = false
                dragStart = input.Position
                startPos = btn.Position

                cleanupDrag()
                activeInput = input

                moveConn = UserInputService.InputChanged:Connect(function(moveInput)
                    if moveInput == activeInput then
                        local delta = moveInput.Position - dragStart
                        if not isDragging and delta.Magnitude >= DRAG_THRESHOLD then
                            isDragging = true
                        end

                        if isDragging then
                            local camera = workspace.CurrentCamera
                            local vp = camera and camera.ViewportSize or Vector2.new(1920, 1080)
                            local bSize = btn.AbsoluteSize

                            local targetX = math.clamp(startPos.X.Offset + delta.X, 0, math.max(0, vp.X - bSize.X))
                            local targetY = math.clamp(startPos.Y.Offset + delta.Y, 0, math.max(0, vp.Y - bSize.Y))
                            btn.Position = UDim2.new(startPos.X.Scale, targetX, startPos.Y.Scale, targetY)
                        end
                    end
                end)

                local function handleRelease(endedInput)
                    if endedInput == activeInput then
                        local wasDragging = isDragging
                        cleanupDrag()

                        if not wasDragging then
                            triggerCombatTech()
                            TweenService:Create(btn, TweenInfo.new(0.08), {Size = UDim2.new(0, 52, 0, 52)}):Play()
                            task.delay(0.08, function()
                                TweenService:Create(btn, TweenInfo.new(0.08), {Size = UDim2.new(0, 60, 0, 60)}):Play()
                            end)
                        end
                    end
                end

                endConn = UserInputService.InputEnded:Connect(handleRelease)
                cancelConn = UserInputService.InputCancelled:Connect(handleRelease)
            end
        end)
