        function Tab:CreateSlider(IdOrConfig, Options)
            local Config = (type(IdOrConfig) == "table") and IdOrConfig or (Options or {})
            local name = parseTitle(IdOrConfig, "Slider")

            local min = (Config.Range and Config.Range[1]) or Config.Min or 0
            local max = (Config.Range and Config.Range[2]) or Config.Max or 100
            local Increment = Config.Increment or Config.Step or Config.Rounding or 1
            local Suffix = Config.Suffix or ""
            local Current = math.clamp(Config.CurrentValue or Config.Default or min, min, max)

            local SldFrame = Instance.new("Frame")
            SldFrame.Size = UDim2.new(1, -5, 0, 46)
            SldFrame.BackgroundColor3 = Rayfield.Theme.Element
            SldFrame.ZIndex = 4
