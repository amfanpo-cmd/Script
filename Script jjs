        itemName.Activated:Connect(function()
            self:Fire()
        end)

        if self.KeyCode then
            local conn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if gameProcessed then return end
                if input.KeyCode == self.KeyCode then
                    self:Fire()
                end
            end)
            table.insert(activeConnections, conn)
        end

        return self
    end

    function MovesetLib:Fire()
        local now = os.clock()
        if now < self.ReadyAt then return end

        local success, cdTime = self.OnActivate()
        if cdTime and cdTime > 0 then
            self:StartCooldown(cdTime)
        end
    end

    function MovesetLib:StartCooldown(duration)
        self.ReadyAt = os.clock() + duration
        if self.ActiveTween then
            self.ActiveTween:Cancel()
        end

        self.CooldownFrame.Size = UDim2.new(1, 0, 1, 0)
        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
        self.ActiveTween = TweenService:Create(self.CooldownFrame, tweenInfo, {Size = UDim2.new(1, 0, 0, 0)})
        self.ActiveTween:Play()
    end

    ----------------------------------------------------------------------------
    -- TARGET LOCK & SEQUENCE
    ----------------------------------------------------------------------------
    local function StartTargetLock(targetHRP)
        StopTargetLock()
        if not targetHRP then return end

        targetLockConnection = RunService.RenderStepped:Connect(function()
            local myChar = LocalPlayer.Character
            if not myChar or not targetHRP or not targetHRP.Parent then
                StopTargetLock()
                return
            end

            local myHRP = myChar:FindFirstChild("HumanoidRootPart")
            if not myHRP then return end

            local targetPos = targetHRP.Position
            local uprightTarget = Vector3.new(targetPos.X, myHRP.Position.Y, targetPos.Z)

            myHRP.CFrame = CFrame.lookAt(myHRP.Position, uprightTarget)

            local cam = workspace.CurrentCamera
            if cam then
                cam.CFrame = CFrame.lookAt(cam.CFrame.Position, targetPos)
            end
        end)
        table.insert(activeConnections, targetLockConnection)
    end

    local function GetValidTarget()
        local myChar = LocalPlayer.Character
        if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
        local myPos = myChar.HumanoidRootPart.Position

        local closestTarget = nil
        local closestDist = math.huge

        for _, descendant in ipairs(workspace:GetDescendants()) do
            if descendant:IsA("Humanoid") and descendant.Health > 0 then
                local model = descendant.Parent
                if model and model:IsA("Model") and model ~= myChar then
                    local targetHRP = model:FindFirstChild("HumanoidRootPart")
                    if targetHRP then
                        local dist = (targetHRP.Position - myPos).Magnitude
                        if dist >= 7 and dist <= 40 then
                            local rayParams = RaycastParams.new()
                            rayParams.FilterType = Enum.RaycastFilterType.Exclude
                            rayParams.FilterDescendantsInstances = {myChar, model}

                            local rayResult = workspace:Raycast(myPos, (targetHRP.Position - myPos), rayParams)
                            if not rayResult and dist < closestDist then
                                closestDist = dist
                                closestTarget = model
                            end
                        end
                    end
                end
            end
        end
        return closestTarget
    end

    local function SetupMovesetValues()
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
