    local function ResetVelocity(hrp)
        if hrp and hrp.Parent then
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end

    local function isTargetInvalid(targetChar)
        if not targetChar or not targetChar.Parent then return true end
        local hum = targetChar:FindFirstChildOfClass("Humanoid")
        local hrp = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso")
        if not hum or not hrp or hum.Health <= 0 then return true end

        if (targetChar:GetAttribute("Ragdoll") or 0) > 0 then
            return true
        end

        local info = targetChar:FindFirstChild("Info")
        if info then
            if info:FindFirstChild("Knockback") or info:FindFirstChild("Ragdoll") or info:FindFirstChild("Down") then
                return true
            end
        end

        return false
    end

    local function getNearestTarget(maxDist)
        local range = maxDist or Settings.AmbushRange
        local char = LocalPlayer.Character
        local myHRP = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        if not myHRP then return nil end

        local myPos = myHRP.Position
        local nearest = nil
        local shortestDist = range

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local tChar = player.Character
                if not isTargetInvalid(tChar) and not tChar:FindFirstChildOfClass("ForceField") then
                    local hrp = tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("Torso")
                    if hrp then
                        local dist = (hrp.Position - myPos).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            nearest = tChar
                        end
                    end
                end
            end
        end

        if not nearest then
            local liveFolder = Workspace:FindFirstChild("Live") or Workspace:FindFirstChild("Characters")
            if liveFolder then
                for _, model in ipairs(liveFolder:GetChildren()) do
                    if model:IsA("Model") and model ~= char and not Players:GetPlayerFromCharacter(model) then
                        if not isTargetInvalid(model) and not model:FindFirstChildOfClass("ForceField") then
                            local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
                            if hrp then
                                local dist = (hrp.Position - myPos).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    nearest = model
                                end
                            end
                        end
                    end
                end
            end
        end

        return nearest
    end

    local function fireBackstabRemote()
        pcall(function()
            local remote = getBackstabRemote()
            local char = LocalPlayer.Character
            local moveset = char and char:FindFirstChild("Moveset")
            local backstabMove = moveset and moveset:FindFirstChild("Backstab")

            if remote and backstabMove then
                remote:FireServer(backstabMove, nil)
            end
        end)
    end

    local function executeAmbush()
        if AmbushInProgress then return end
        if not hasSwordEquipped() then return end

        local targetChar = getNearestTarget(Settings.AmbushRange)
        if not targetChar or isTargetInvalid(targetChar) then return end

        local myChar = LocalPlayer.Character
        local myHRP = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if not (myHRP and myHum and myHum.Health > 0) then return end

        local tHRP = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso")
        if not tHRP then return end

        AmbushInProgress = true
        fireBackstabRemote()

        local startPos = myHRP.Position
        local initialTargetCF = tHRP.CFrame
        local initialRightVec = Vector3.new(initialTargetCF.RightVector.X, 0, initialTargetCF.RightVector.Z).Unit
        local toPlayer = startPos - tHRP.Position
        local sideSign = toPlayer:Dot(initialRightVec) >= 0 and 1 or -1

        local startTime = os.clock()
        myHum.AutoRotate = false
        local originalCamType = Camera.CameraType
        Camera.CameraType = Enum.CameraType.Custom

        local heartbeatConn
        heartbeatConn = RunService.Heartbeat:Connect(function()
            local elapsed = os.clock() - startTime
            local rawAlpha = math.clamp(elapsed / Settings.AmbushDuration, 0, 1)

            if rawAlpha >= 1 or isTargetInvalid(targetChar) or not (myHRP.Parent and myHum.Health > 0 and tHRP.Parent) then
                heartbeatConn:Disconnect()
                myHum.AutoRotate = true
                Camera.CameraType = originalCamType

                if not isTargetInvalid(targetChar) and tHRP.Parent and myHRP.Parent then
                    local targetLook = Vector3.new(tHRP.CFrame.LookVector.X, 0, tHRP.CFrame.LookVector.Z).Unit
                    local endPos = tHRP.Position - targetLook * Settings.AmbushRadius
                    myHRP.CFrame = CFrame.lookAt(Vector3.new(endPos.X, myHRP.Position.Y, endPos.Z), Vector3.new(tHRP.Position.X, myHRP.Position.Y, tHRP.Position.Z))
                    ResetVelocity(myHRP)
                else
                    ResetVelocity(myHRP)
                end

                task.delay(0.02, function()
                    AmbushInProgress = false
                end)
                return
            end

            local alpha = 1 - math.pow(1 - rawAlpha, 3)

            local currentTargetPos = tHRP.Position
            local targetLook = Vector3.new(tHRP.CFrame.LookVector.X, 0, tHRP.CFrame.LookVector.Z).Unit
            local targetRight = Vector3.new(tHRP.CFrame.RightVector.X, 0, tHRP.CFrame.RightVector.Z).Unit

            local endPos = currentTargetPos - targetLook * Settings.AmbushRadius
            local controlAnchor = currentTargetPos + targetRight * (Settings.AmbushCurve * sideSign)
            local blendedControl = controlAnchor:Lerp(endPos, alpha)

            local tInv = 1 - alpha
            local curvePos = (tInv * tInv) * startPos + (2 * tInv * alpha) * blendedControl + (alpha * alpha) * endPos
            local currentY = startPos.Y + (endPos.Y - startPos.Y) * alpha
            local targetPosition = Vector3.new(curvePos.X, currentY, curvePos.Z)

            local lookAtTarget = Vector3.new(currentTargetPos.X, currentY, currentTargetPos.Z)
            myHRP.CFrame = CFrame.lookAt(targetPosition, lookAtTarget)
            ResetVelocity(myHRP)

            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(myHRP.Position + Vector3.new(0, Settings.AmbushCamOffset, 0), currentTargetPos), 0.35)
        end)
    end

    local function fireDodgeActivated()
        if GlobalDodgeCount == 0 then
            local act, _ = getDodgeRemotes()
            if act then
                pcall(function() act:FireServer() end)
            end
        end
        GlobalDodgeCount = GlobalDodgeCount + 1
    end

    local function fireDodgeDeactivated()
        GlobalDodgeCount = math.max(0, GlobalDodgeCount - 1)
        if GlobalDodgeCount == 0 then
            local _, deact = getDodgeRemotes()
            if deact then
                pcall(function() deact:FireServer() end)
            end
        end
    end

    local function isLocalPlayerAttacking()
        local localChar = LocalPlayer.Character
        if not localChar then return false end
        local humanoid = localChar:FindFirstChildOfClass("Humanoid")
        if not humanoid then return false end
        for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
            if track.IsPlaying then
                local animName = string.lower(track.Animation.Name)
                local isMovement = false
                for i = 1, #MovementStateKeywords do
                    if string.find(animName, MovementStateKeywords[i], 1, true) then 
                        isMovement = true 
                        break 
                    end
                end
                if not isMovement then return true end
            end
        end
        return false
    end

    local function isLocalPlayerIncapacitated()
        local localChar = LocalPlayer.Character
        if not localChar then return true end
        if localChar:GetAttribute("Dead") then return true end
        local ragdollVal = localChar:GetAttribute("Ragdoll")
        if ragdollVal and ragdollVal > 0 then return true end
        return false
    end

    local function isEnemyFeinting(character)
        if not Settings.AntiFeint then return false end
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return false end
        local feintInstance = rootPart:FindFirstChild("Feint")
        if feintInstance then
            local ringParticle = feintInstance:FindFirstChild("Ring")
            if ringParticle and ringParticle:IsA("ParticleEmitter") then
                for _, keypoint in ipairs(ringParticle.Color.Keypoints) do
                    local val = keypoint.Value
                    if math.abs(val.R - val.G) < 0.05 and math.abs(val.G - val.B) < 0.05 then
                        return true
                    end
                end
            end
        end
        return false
    end

    local function getCurrentMoveset()
        local localChar = LocalPlayer.Character
        if not localChar then return nil end
        local attr = localChar:GetAttribute("Moveset")
        if attr then return attr end
        local obj = localChar:FindFirstChild("Moveset")
        if obj then
            return obj:IsA("StringValue") and obj.Value or obj.Name
        end
        return nil
    end

    local function executeCounterPunish(targetCharacter)
        if not Settings.AutoPunish or isTargetInvalid(targetCharacter) then return end
        local localChar = LocalPlayer.Character
        if not localChar then return end
        local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
        local localRoot = localChar:FindFirstChild("HumanoidRootPart")
        if not targetRoot or not localRoot then return end

        local distance = (localRoot.Position - targetRoot.Position).Magnitude
        if distance > Settings.PunishRange then return end

        local currentMoveset = getCurrentMoveset()
        if not currentMoveset then return end

        task.spawn(function()
            task.wait(0.04)
            if isTargetInvalid(targetCharacter) then return end
            pcall(function()
                local rawName = currentMoveset == "Makora" and "Mahoraga" or currentMoveset
                local cleanedName = string.gsub(rawName, "%s+", "")
                local svc = getKnitService(cleanedName .. "Service")
                if svc then
                    local re = svc:FindFirstChild("RE")
                    local activated = re and re:FindFirstChild("Activated")
                    if activated then
                        activated:FireServer(false)
                    end
                end
            end)
        end)
    end

    local function handleProjectileAnimation(character, animationTrack)
        if not Settings.ProjectileDodge or isTargetInvalid(character) then return end
        if not animationTrack or not animationTrack.Animation then return end

        local rawId = string.match(tostring(animationTrack.Animation.AnimationId), "%d+")
        if not rawId or not ProjectileAnimations[rawId] then return end

        local charPlayer = Players:GetPlayerFromCharacter(character)
        if charPlayer == LocalPlayer or isLocalPlayerIncapacitated() then return end

        local localChar = LocalPlayer.Character
        local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
        local targetRoot = character:FindFirstChild("HumanoidRootPart")
        if not (localRoot and targetRoot) then return end

        local distance = (localRoot.Position - targetRoot.Position).Magnitude
        if distance > Settings.ProjectileRange then return end

        if Settings.ProjectileFacingCheck then
            local enemyLook = targetRoot.CFrame.LookVector
            local dirToUs = (localRoot.Position - targetRoot.Position).Unit
            if enemyLook:Dot(dirToUs) < Settings.ProjectileFacingThreshold then return end
        end

        if ActiveProjectileTracks[animationTrack] then return end
        ActiveProjectileTracks[animationTrack] = true
        fireDodgeActivated()

        local conn
        conn = animationTrack.Stopped:Once(function()
            if ActiveProjectileTracks[animationTrack] then
                ActiveProjectileTracks[animationTrack] = nil
                fireDodgeDeactivated()
            end
        end)
        table.insert(ActiveConnections, conn)

        task.delay(4, function()
            if ActiveProjectileTracks[animationTrack] then
                ActiveProjectileTracks[animationTrack] = nil
                fireDodgeDeactivated()
            end
        end)
    end

    local function handleStandardAnimation(character, animationTrack)
        if not Settings.AutoDodge or isTargetInvalid(character) then return end
        if not animationTrack or not animationTrack.Animation then return end

        local animationName = animationTrack.Animation.Name
        local lowerName = string.lower(animationName)
        local rawId = string.match(tostring(animationTrack.Animation.AnimationId), "%d+")
        if rawId and ProjectileAnimations[rawId] then return end

        for i = 1, #MovementStateKeywords do
            if string.find(lowerName, MovementStateKeywords[i], 1, true) then return end
        end

        local charPlayer = Players:GetPlayerFromCharacter(character)
        if charPlayer == LocalPlayer or isLocalPlayerIncapacitated() then return end
        if not Settings.DodgeWhileAttacking and isLocalPlayerAttacking() then return end

        local localChar = LocalPlayer.Character
        local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
        local targetRoot = character:FindFirstChild("HumanoidRootPart")
        if not (localRoot and targetRoot) then return end

        local distance = (localRoot.Position - targetRoot.Position).Magnitude
        if distance > Settings.DodgeRange then return end

        if Settings.FacingCheck then
            local enemyLook = targetRoot.CFrame.LookVector
            local dirToUs = (localRoot.Position - targetRoot.Position).Unit
            if enemyLook:Dot(dirToUs) < Settings.FacingThreshold then return end
        end

        if isEnemyFeinting(character) then return end
        if ActiveDodgingTracks[animationTrack] then return end

        local isEnemyCountering = string.find(lowerName, "counter", 1, true) 
            or string.find(lowerName, "manji", 1, true) 
            or string.find(lowerName, "parry", 1, true)
            or (rawId and CounterAnimations[rawId] == true)
            or (rawId and CounterAnimeAnimations[rawId] == true)

        if (Settings.NoDodgeOnCounter or Settings.NoDodgeCounterAnime) and isEnemyCountering then
            return
        end

        ActiveDodgingTracks[animationTrack] = true
        fireDodgeActivated()

        local conn
        conn = animationTrack.Stopped:Once(function()
            if ActiveDodgingTracks[animationTrack] then
                ActiveDodgingTracks[animationTrack] = nil
                fireDodgeDeactivated()
                if not isEnemyCountering and not isTargetInvalid(character) then
                    executeCounterPunish(character)
                end
            end
        end)
        table.insert(ActiveConnections, conn)

        task.delay(4, function()
            if ActiveDodgingTracks[animationTrack] then
                ActiveDodgingTracks[animationTrack] = nil
                fireDodgeDeactivated()
            end
        end)
    end

    local function connectCharacter(char)
        if ConnectedCharacters[char] or char == LocalPlayer.Character then return end
        local hum = char:WaitForChild("Humanoid", 4)
        if hum then
            ConnectedCharacters[char] = true
            local conn = hum.AnimationPlayed:Connect(function(track)
                handleStandardAnimation(char, track)
                handleProjectileAnimation(char, track)
            end)
            table.insert(ActiveConnections, conn)
        end
    end

    local function setupWorkspaceMonitoring()
        local charsFolder = Workspace:WaitForChild("Characters", 8) or Workspace:FindFirstChild("Characters")
        if charsFolder then
            for _, c in ipairs(charsFolder:GetChildren()) do
                connectCharacter(c)
            end
            local childConn = charsFolder.ChildAdded:Connect(function(c)
                task.wait(0.2)
                connectCharacter(c)
            end)
            table.insert(ActiveConnections, childConn)
        end

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                connectCharacter(p.Character)
            end
            p.CharacterAdded:Connect(function(c)
                task.wait(0.2)
                connectCharacter(c)
            end)
        end

        Players.PlayerAdded:Connect(function(p)
            if p ~= LocalPlayer then
                p.CharacterAdded:Connect(function(c)
                    task.wait(0.2)
                    connectCharacter(c)
                end)
            end
        end)
    end

    local function startEffectsMonitor()
        local effects = Workspace:WaitForChild("Effects", 8) or Workspace:FindFirstChild("Effects")
        if not effects then return end

        local effectConn = effects.ChildAdded:Connect(function(child)
            if not Settings.AutoDodge or not Settings.HitGlowDodge then return end
            if child.Name == "HitGlow" or child.Name == "BlockHit" or child.Name == "DodgeHit" then
                local now = os.clock()
                if now - LastHitGlowTime < 0.3 then return end
                LastHitGlowTime = now

                local char = LocalPlayer.Character
                if not char then return end

                local weld = child:FindFirstChildOfClass("Weld")
                if weld then
                    local p0, p1 = weld.Part0, weld.Part1
                    if (p0 and p0:IsDescendantOf(char)) or (p1 and p1:IsDescendantOf(char)) then
                        fireDodgeActivated()
                        task.delay(0.2, fireDodgeDeactivated)
                    end
                end
            end
        end)
        table.insert(ActiveConnections, effectConn)
    end

