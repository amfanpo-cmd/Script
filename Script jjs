    -- GOJO KILL ALL EXECUTION
    -------------------------------------------------------------------------------
    local function runGojoKillAll()
        if gojoKillAllRunning then return end
        gojoKillAllRunning = true

        task.spawn(function()
            pcall(function()
                local ultEvent = ReplicatedStorage.Knit.Knit.Services.GojoService.RE.Ultimate
