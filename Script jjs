local function loadModule(name, tab, chunk)
    local ok, mod = pcall(chunk)
    if not ok then
        Rayfield:Notify({Title="Load Error", Content=name..": "..tostring(mod), Duration=5})
        return
    end
    local ok2, err = pcall(function()
        if type(mod) == "table" and type(mod.Init) == "function" then
            mod.Init(tab)
        elseif type(mod) == "function" then
            mod(tab)
        else
            error("module returned unknown type: "..type(mod))
        end
    end)
    if not ok2 then
        Rayfield:Notify({Title="Init Error", Content=name..": "..tostring(err), Duration=5})
    end
end

