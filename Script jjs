            return CachedRemotes.Backstab
        end
        local svc = getKnitService("BackstabService")
        local re = svc and svc:FindFirstChild("RE")
        CachedRemotes.Backstab = re and re:FindFirstChild("Activated")
        return CachedRemotes.Backstab
