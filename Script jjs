    end

    -- Inf Stun (Second Wind) Toggle
    local infStunParams = {
        Name = "Inf Stun (Second Wind)",
        CurrentValue = false,
        Callback = function(Value)
            state.infStunEnabled = Value
            if not state.infStunEnabled then
                unfreezeBoth()
            end
        end
    }

    if type(YutaTab.CreateToggle) == "function" then
        YutaTab:CreateToggle(infStunParams)
    elseif type(YutaTab.AddToggle) == "function" then
        YutaTab:AddToggle("Inf Stun (Second Wind)", infStunParams)
    end

    ----------------------------------------------------------------------------
    -- RUNTIME ENGINE: HEIGHT LOCK & ANIMATION DETECTOR
    ----------------------------------------------------------------------------
    if state.heartbeatConnection then
        state.heartbeatConnection:Disconnect()
    end

    state.heartbeatConnection = RunService.Heartbeat:Connect(function()
        if not state.infStunEnabled then return end

        local myChar = LocalPlayer.Character
        if not myChar then return end
        local hum = myChar:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")

        if animator and not state.isFrozen then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                local animId = track.Animation and track.Animation.AnimationId or ""

                if animId:find(TARGET_ANIM_ID) then
                    if track.TimePosition >= TRIGGER_TIME then
                        track:AdjustSpeed(0)
                        state.activeAnimTrack = track

                        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
                        if myHRP then
                            state.savedElevation = myHRP.Position.Y
                        end

                        state.frozenTargetChar = getClosestEnemy(25)
                        state.isFrozen = true

                        track.Stopped:Once(function()
                            if state.isFrozen then
                                unfreezeBoth()
                            end
                        end)
                    end
                end
            end
        end

        if state.isFrozen and state.activeAnimTrack and not state.activeAnimTrack.IsPlaying then
            unfreezeBoth()
            return
        end

        -- Altitude Lock: Prevents dropping down past saved elevation
        if state.isFrozen then
            local myHRP = myChar:FindFirstChild("HumanoidRootPart")

            if myHRP then
                if not state.savedElevation then
                    state.savedElevation = myHRP.Position.Y
                end

                -- Maintain Y position at or above activation height (prevents falling/dropping)
                if myHRP.Position.Y < state.savedElevation then
                    myHRP.CFrame = CFrame.new(myHRP.Position.X, state.savedElevation, myHRP.Position.Z) * myHRP.CFrame.Rotation
                end

                -- Arrest downward gravity vector without hard-anchoring the player
                local currentVel = myHRP.AssemblyLinearVelocity
                if currentVel.Y < 0 then
                    myHRP.AssemblyLinearVelocity = Vector3.new(currentVel.X, 0, currentVel.Z)
                end
            end

            -- Freeze Target in place at current elevation
            if state.frozenTargetChar then
                local targetHRP = state.frozenTargetChar:FindFirstChild("HumanoidRootPart")
                if targetHRP and state.savedElevation then
                    targetHRP.CFrame = CFrame.new(targetHRP.Position.X, state.savedElevation, targetHRP.Position.Z) * targetHRP.CFrame.Rotation
                    targetHRP.Anchored = true
                    targetHRP.AssemblyLinearVelocity = Vector3.zero
                end
            end
        end
    end)

    LocalPlayer.CharacterAdded:Connect(function()
        stopSealTech()
        unfreezeBoth()
    end)
end
end)

