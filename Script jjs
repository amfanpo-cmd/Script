            local gbMove = moveset and moveset:FindFirstChild("Granite Blast")
            if gbMove and gbActivated then
                gbActivated:FireServer(gbMove, nil)
            end

            preciseSchedule(0.10, function()
                if gbMove and gbDeactivated then
                    gbDeactivated:FireServer(gbMove, false)
                end
            end)
        end)

        local startTime = os.clock()
        myHumanoid.AutoRotate = false
        local originalCamType = Camera.CameraType
        Camera.CameraType = Enum.CameraType.Custom

        local heartbeatConnection
        heartbeatConnection = RunService.Heartbeat:Connect(function()
            local elapsed = os.clock() - startTime
            local rawAlpha = math.clamp(elapsed / Settings.Time, 0, 1)

            if rawAlpha >= 1 or isTargetInvalid(targetChar) or not (myHRP.Parent and myHumanoid.Health > 0 and tHRP.Parent) then
                heartbeatConnection:Disconnect()
                myHumanoid.AutoRotate = true
                Camera.CameraType = originalCamType

                if not isTargetInvalid(targetChar) and tHRP.Parent and myHRP.Parent then
                    local targetLook = Vector3.new(tHRP.CFrame.LookVector.X, 0, tHRP.CFrame.LookVector.Z).Unit
                    local endPos = tHRP.Position - targetLook * Settings.Distance
                    myHRP.CFrame = CFrame.lookAt(Vector3.new(endPos.X, myHRP.Position.Y, endPos.Z), Vector3.new(tHRP.Position.X, myHRP.Position.Y, tHRP.Position.Z))
                    ResetVelocity(myHRP)
                else
                    ResetVelocity(myHRP)
                end

                task.delay(0.02, function()
                    glideInProgress = false
                end)
                return
            end

            local alpha = 1 - math.pow(1 - rawAlpha, 3)

            local currentTargetPos = tHRP.Position
            local targetLook = Vector3.new(tHRP.CFrame.LookVector.X, 0, tHRP.CFrame.LookVector.Z).Unit
            local targetRight = Vector3.new(tHRP.CFrame.RightVector.X, 0, tHRP.CFrame.RightVector.Z).Unit

            local endPos = currentTargetPos - targetLook * Settings.Distance
            local controlAnchor = currentTargetPos + targetRight * (Settings.Curve * sideSign)
            local blendedControl = controlAnchor:Lerp(endPos, alpha)

            local tInv = 1 - alpha
            local curvePos = (tInv * tInv) * startPos + (2 * tInv * alpha) * blendedControl + (alpha * alpha) * endPos
            local currentY = startPos.Y + (endPos.Y - startPos.Y) * alpha
            local targetPosition = Vector3.new(curvePos.X, currentY, curvePos.Z)

            local lookAtTarget = Vector3.new(currentTargetPos.X, currentY, currentTargetPos.Z)
            myHRP.CFrame = CFrame.lookAt(targetPosition, lookAtTarget)
            ResetVelocity(myHRP)

            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(myHRP.Position + Vector3.new(0, Settings.CamOffset, 0), currentTargetPos), 0.3)
        end)
    end

