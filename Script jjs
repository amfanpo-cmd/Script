            Stroke.Color = Rayfield.Theme.Stroke
            Stroke.Transparency = 0.5

            local hasIcon = setupIcon(SldFrame, Config.Image or Config.Icon, UDim2.new(0, 10, 0, 4))

            local SldText = Instance.new("TextLabel")
            SldText.Size = UDim2.new(0.55, hasIcon and -22 or 0, 0, 20)
            SldText.Position = UDim2.new(0, hasIcon and 32 or 10, 0, 2)
            SldText.BackgroundTransparency = 1
            SldText.Text = name
            SldText.TextColor3 = Rayfield.Theme.Text
            SldText.Font = Rayfield.Theme.Font
            SldText.TextSize = 12
            SldText.TextXAlignment = Enum.TextXAlignment.Left
            SldText.ZIndex = 5
            SldText.Parent = SldFrame

            local ValInput = Instance.new("TextBox")
            ValInput.Size = UDim2.new(0.38, 0, 0, 20)
            ValInput.Position = UDim2.new(0.60, 0, 0, 2)
            ValInput.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
            ValInput.BackgroundTransparency = 0.5
            ValInput.Text = tostring(Current) .. Suffix
            ValInput.TextColor3 = Rayfield.Theme.Text
            ValInput.Font = Rayfield.Theme.Font
            ValInput.TextSize = 11
            ValInput.TextXAlignment = Enum.TextXAlignment.Right
            ValInput.ClearTextOnFocus = false
            ValInput.ZIndex = 5
            ValInput.Parent = SldFrame

            Instance.new("UICorner", ValInput).CornerRadius = UDim.new(0, 4)
            local ValStroke = Instance.new("UIStroke", ValInput)
            ValStroke.Color = Rayfield.Theme.Stroke
            ValStroke.Transparency = 0.5

            local Track = Instance.new("Frame")
            Track.Size = UDim2.new(1, -20, 0, 6)
            Track.Position = UDim2.new(0, 10, 0, 28)
            Track.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
            Track.ZIndex = 5
            Track.Parent = SldFrame

            Instance.new("UICorner", Track).CornerRadius = UDim.new(0, 3)

            local Fill = Instance.new("Frame")
            local initialScale = (max > min) and math.clamp((Current - min) / (max - min), 0, 1) or 0
            Fill.Size = UDim2.new(initialScale, 0, 1, 0)
            Fill.BackgroundColor3 = Rayfield.Theme.Accent
            Fill.ZIndex = 6
            Fill.Parent = Track

            Instance.new("UICorner", Fill).CornerRadius = UDim.new(0, 3)

            table.insert(TrackedElements, SldFrame)
            table.insert(TrackedAccents, Fill)

            local flag = Config.Flag or (type(IdOrConfig) == "string" and IdOrConfig)
            local function UpdateSliderValue(val, skipInputUpdate)
                notifyFeatureActivated()
                val = math.clamp(val, min, max)
                val = math.floor((val - min) / Increment + 0.5) * Increment + min

                if Increment < 1 then
                    local decStr = tostring(Increment)
                    local decPos = decStr:find("%.")
                    local decimals = decPos and (#decStr - decPos) or 2
                    val = tonumber(string.format("%." .. decimals .. "f", val)) or val
                end

                Current = val
                if not skipInputUpdate then
                    ValInput.Text = tostring(Current) .. Suffix
                end

                Fill.Size = UDim2.new((max > min) and ((Current - min) / (max - min)) or 0, 0, 1, 0)
                if flag then Rayfield.Flags[flag] = Current end
                if Config.Callback then pcall(Config.Callback, Current) end
            end

            ValInput.FocusLost:Connect(function()
                local raw = ValInput.Text:gsub("[^%d%.%-]", "")
                local parsed = tonumber(raw)
                if parsed then
                    UpdateSliderValue(parsed)
                else
                    ValInput.Text = tostring(Current) .. Suffix
                end
            end)

            local function ProcessInput(input)
                local width = Track.AbsoluteSize.X
                if width <= 0 then return end
                local pos = math.clamp((input.Position.X - Track.AbsolutePosition.X) / width, 0, 1)
                UpdateSliderValue(min + (max - min) * pos)
            end

            local sliderMoveConn, sliderEndConn
            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    ProcessInput(input)

                    if sliderMoveConn then sliderMoveConn:Disconnect() end
                    if sliderEndConn then sliderEndConn:Disconnect() end

                    sliderMoveConn = UserInputService.InputChanged:Connect(function(moveInput)
                        if moveInput.UserInputType == Enum.UserInputType.MouseMovement or moveInput.UserInputType == Enum.UserInputType.Touch then
                            ProcessInput(moveInput)
                        end
                    end)

                    sliderEndConn = UserInputService.InputEnded:Connect(function(endInput)
                        if endInput.UserInputType == Enum.UserInputType.MouseButton1 or endInput.UserInputType == Enum.UserInputType.Touch then
                            if sliderMoveConn then sliderMoveConn:Disconnect() sliderMoveConn = nil end
                            if sliderEndConn then sliderEndConn:Disconnect() sliderEndConn = nil end
                        end
                    end)
                end
            end)

            if flag then Rayfield.Flags[flag] = Current end
            queuePageUpdate()

            return {
                Set = function(_, val) UpdateSliderValue(val) end,
                SetValue = function(_, val) UpdateSliderValue(val) end,
                Destroy = function()
                    SldFrame:Destroy()
                    queuePageUpdate()
                end
            }
        end

