loadModule("All Chars", Tab_AllChars, function()
local Module = {}

local function getService(name)
    local service = game:GetService(name)
    if cloneref then
        local ok, cloned = pcall(cloneref, service)
        if ok and cloned then return cloned end
    end
    return service
end

local Players = getService("Players")
local RunService = getService("RunService")
local UserInputService = getService("UserInputService")
local Workspace = getService("Workspace")
local ReplicatedStorage = getService("ReplicatedStorage")
local CoreGui = getService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    if Workspace.CurrentCamera then
        Camera = Workspace.CurrentCamera
    end
end)

local checkcaller = checkcaller or function() return false end
local getnamecallmethod = getnamecallmethod or function() return "" end
local newcclosure = newcclosure or function(f) return f end
local hookmetamethod = hookmetamethod or (hookfunction and function(t, m, f)
    local mt = getrawmetatable(t)
    return hookfunction(mt[m], f)
end)

local function getSafeGuiParent()
    if gethui then
        local ok, hui = pcall(gethui)
        if ok and hui then return hui end
    end
    local ok, core = pcall(function() return CoreGui end)
    if ok and core then return core end
    return LocalPlayer:WaitForChild("PlayerGui", 5)
end

function Module.Init(AllCharTab)
    local Settings = {
        Fly = false,
        FlySpeed = 50,
        Noclip = false,

        DomainWalk = false,

        LockOn = false,
        BodyLock = false,
        MobileGUI = false,
        LockOnKey = Enum.KeyCode.E,
        LockOnTarget = nil,

        PredictiveLockOn = false,
        PredictionLeadTime = 0.18,

        BackflipToggle = false,
        BackflipKey = Enum.KeyCode.Z,
        BackflipHeight = 25,
        BackflipSpeed = 0.45,
        BackflipForward = 10,
        BackflipBackward = 0,
        BackflipRotations = 1.0,

        HitboxExpander = false,
        HitboxSize = 20,

        AutoInstantRespawn = false,
        AutoInstantRespawnHP = 25,

        RagdollWeight = false,
        RagdollGravity = 50,

        AntiCounter = false,
        AntiCounterDist = 12,
        AntiCounterTurn = false,
        AntiCounterStop = true,
        AntiCounterDuration = 0.40
    }

    local State = {
        OriginalGravity = Workspace.Gravity,
        RemoteBlockUntil = 0,
        SuspendedLockOnUntil = 0,
        CounterEnemy = nil,
        SavedComputerCamMode = nil,
        SavedTouchCamMode = nil,
        DomainOriginals = setmetatable({}, { __mode = "k" }),
        DomainConnections = {},
        CurrentDomainBox = nil,
        AnimHooks = {}
    }

    local CounterAnimMap = {
        ["82987093810211"] = true,
        ["72933571933445"] = true,
        ["117045209683198"] = true,
        ["92529934565092"] = true,
        ["101956908324027"] = true
    }

    pcall(function()
        if hookmetamethod then
            local oldNamecall
            oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                if not checkcaller() and Settings.AntiCounter and os.clock() < State.RemoteBlockUntil then
                    local method = getnamecallmethod()
                    if method == "FireServer" or method == "InvokeServer" then
                        return nil
                    end
                end
                return oldNamecall(self, ...)
            end))
        end
    end)

    local function getRootPart(char)
        char = char or LocalPlayer.Character
        return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
    end

    local function setPartNoCollision(part)
        if State.DomainOriginals[part] ~= nil or not part:IsA("BasePart") then return end
        State.DomainOriginals[part] = part.CanCollide
        pcall(function()
            part.CanCollide = false
        end)
    end

    local function bindDomainsFolder(folder)
        if not folder or State.CurrentDomainBox == folder then return end
        State.CurrentDomainBox = folder

        for _, desc in ipairs(folder:GetDescendants()) do
            setPartNoCollision(desc)
        end

        local conn = folder.DescendantAdded:Connect(function(desc)
            if Settings.DomainWalk then
                setPartNoCollision(desc)
            end
        end)
        table.insert(State.DomainConnections, conn)
    end

    local function setDomainWalkState(enabled)
        Settings.DomainWalk = enabled

        if not enabled then
            for _, conn in ipairs(State.DomainConnections) do
                pcall(function() conn:Disconnect() end)
            end
            table.clear(State.DomainConnections)
            State.CurrentDomainBox = nil

            for part, wasCollidable in pairs(State.DomainOriginals) do
                if part and part.Parent then
                    pcall(function()
                        part.CanCollide = wasCollidable
                    end)
                end
            end
            table.clear(State.DomainOriginals)
            return
        end

        local childConn = Workspace.ChildAdded:Connect(function(child)
            if Settings.DomainWalk and child.Name == "Domains" then
                bindDomainsFolder(child)
            end
        end)
        table.insert(State.DomainConnections, childConn)

        bindDomainsFolder(Workspace:FindFirstChild("Domains"))
    end

    local function handleCounterDetected(enemyChar)
        local myRoot = getRootPart()
        local enemyRoot = getRootPart(enemyChar)
        if not (myRoot and enemyRoot) then return end

        local dist = (enemyRoot.Position - myRoot.Position).Magnitude
        if dist > Settings.AntiCounterDist then return end

        local duration = math.clamp(Settings.AntiCounterDuration or 0.40, 0.1, 2.0)
        State.RemoteBlockUntil = os.clock() + duration
        State.CounterEnemy = enemyChar

        if Settings.AntiCounterTurn then
            State.SuspendedLockOnUntil = os.clock() + duration
        end
    end

    local function hookCharacterAnimations(char)
        if not char or char == LocalPlayer.Character then return end
        local hum = char:WaitForChild("Humanoid", 4)
        local animator = hum and (hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 4))
        if not animator then return end

        local conn = animator.AnimationPlayed:Connect(function(track)
            if not Settings.AntiCounter or not track or not track.Animation then return end
            local rawId = string.match(tostring(track.Animation.AnimationId), "%d+")
            if rawId and CounterAnimMap[rawId] then
                handleCounterDetected(char)
            end
        end)
        table.insert(State.AnimHooks, conn)
    end

    local function setupAntiCounterListeners()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                hookCharacterAnimations(p.Character)
            end
            p.CharacterAdded:Connect(hookCharacterAnimations)
        end

        Players.PlayerAdded:Connect(function(p)
            if p ~= LocalPlayer then
                p.CharacterAdded:Connect(hookCharacterAnimations)
            end
        end)

        local charsFolder = Workspace:FindFirstChild("Characters")
        if charsFolder then
            for _, c in ipairs(charsFolder:GetChildren()) do
                if c:IsA("Model") and c ~= LocalPlayer.Character then
                    hookCharacterAnimations(c)
                end
            end
            charsFolder.ChildAdded:Connect(function(c)
                if c:IsA("Model") and c ~= LocalPlayer.Character then
                    task.wait(0.1)
                    hookCharacterAnimations(c)
                end
            end)
        end
    end

    setupAntiCounterListeners()

    local originalSphereHitbox = nil
    local hitboxHooked = false

    local function HookHitboxController()
        if hitboxHooked then return end
        pcall(function()
            local ps = LocalPlayer:FindFirstChild("PlayerScripts")
            local ctrl = ps and ps:FindFirstChild("Controllers")
            local combat = ctrl and ctrl:FindFirstChild("Combat")
            local hbCtrl = combat and combat:FindFirstChild("HitboxController")
            if hbCtrl then
                local req = require(hbCtrl)
                if req and type(req.SphereHitbox) == "function" then
                    hitboxHooked = true
                    originalSphereHitbox = req.SphereHitbox
                    req.SphereHitbox = function(self, char, cf, r)
                        if Settings.HitboxExpander then
                            return originalSphereHitbox(self, char, cf, Settings.HitboxSize or r)
                        end
                        return originalSphereHitbox(self, char, cf, r)
                    end
                end
            end
        end)
    end

    local respawnBusy = false

    local function ExecuteInstantRespawn()
        local char = LocalPlayer.Character
        local hrp = getRootPart(char)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        pcall(function()
            if replicatesignal and hum:FindFirstChild("ServerBreakJoints") then
                pcall(replicatesignal, hum.ServerBreakJoints)
            end

            hrp.CFrame = CFrame.new(0, 10000, 0)
            hrp.AssemblyLinearVelocity = Vector3.zero

            local knit = ReplicatedStorage:FindFirstChild("Knit")
            local innerKnit = knit and knit:FindFirstChild("Knit")
            local services = innerKnit and innerKnit:FindFirstChild("Services")
            local joinSvc = services and services:FindFirstChild("JoinService")
            local re = joinSvc and joinSvc:FindFirstChild("RE")
            local resetRem = re and re:FindFirstChild("Reset")

            if resetRem and resetRem:IsA("RemoteEvent") then
                resetRem:FireServer()
            else
                for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
                    if desc:IsA("RemoteEvent") and desc.Name == "Reset" then
                        desc:FireServer()
                        break
                    end
                end
            end
        end)
    end

    local function CheckHealthForRespawn(hum)
        if not hum or respawnBusy or not Settings.AutoInstantRespawn then return end
        if hum.MaxHealth <= 0 then return end

        local currentPercent = (hum.Health / hum.MaxHealth) * 100

        if currentPercent >= 0 and currentPercent <= Settings.AutoInstantRespawnHP then
            respawnBusy = true
            task.spawn(function()
                ExecuteInstantRespawn()
                task.wait(1.25)
                respawnBusy = false
            end)
        end
    end

    local function HookCharacterRespawn(char)
        respawnBusy = false
        local hum = char:WaitForChild("Humanoid", 4)
        if hum then
            hum.HealthChanged:Connect(function()
                CheckHealthForRespawn(hum)
            end)
        end
    end

    local function GetNearestLockOnTarget()
        local nearest = nil
        local bestScore = math.huge
        local char = LocalPlayer.Character
        local myHRP = getRootPart(char)
        if not myHRP or not Camera then return nil end

        local playerPos = myHRP.Position
        local camCF = Camera.CFrame
        local camLook = camCF.LookVector

        local function evaluateModel(targetModel)
            local hrp = getRootPart(targetModel)
            local hum = targetModel:FindFirstChildOfClass("Humanoid")
            if not (hrp and hum and hum.Health > 0) then return end
            if targetModel:FindFirstChildOfClass("ForceField") then return end

            local diff = hrp.Position - playerPos
            local dist = diff.Magnitude
            if dist > 350 or dist < 1 then return end

            local dir = diff.Unit
            local angleFactor = 1 - math.clamp(camLook:Dot(dir), -1, 1)
            local score = dist + (angleFactor * 120)

            if score < bestScore then
                bestScore = score
                nearest = targetModel
            end
        end

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                evaluateModel(p.Character)
            end
        end

        if not nearest then
            local liveFolder = Workspace:FindFirstChild("Live") or Workspace:FindFirstChild("Characters")
            local pool = liveFolder and liveFolder:GetChildren() or Workspace:GetChildren()
            for _, obj in ipairs(pool) do
                if obj:IsA("Model") and obj ~= char and not Players:GetPlayerFromCharacter(obj) then
                    evaluateModel(obj)
                end
            end
        end

        return nearest
    end

    local function cleanupBodyLock(hrp, hum)
        local char = LocalPlayer.Character
        if char then
            for _, desc in ipairs(char:GetDescendants()) do
                if desc:IsA("BodyGyro") and (desc.Name == "LockOn_BodyGyro" or desc.Name == "BodyLockGyro") then
                    pcall(desc.Destroy, desc)
                end
            end
        end
        if hum and not Settings.Fly then
            pcall(function() hum.AutoRotate = true end)
        end
    end

    local function UpdateBodyLock()
        local char = LocalPlayer.Character
        local hrp = getRootPart(char)
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if not char or not hrp or not hum or hum.Health <= 0 then
            cleanupBodyLock(hrp, hum)
            return
        end

        local isRagdolled = (char:GetAttribute("Ragdoll") or 0) > 0
        local target = Settings.LockOnTarget
        local targetHrp = target and getRootPart(target)
        local targetHum = target and target:FindFirstChildOfClass("Humanoid")

        local shouldLockBody = Settings.LockOn 
            and Settings.BodyLock 
            and not isRagdolled 
            and not Settings.Fly 
            and targetHrp 
            and targetHum 
            and targetHum.Health > 0
            and os.clock() >= State.SuspendedLockOnUntil

        if shouldLockBody then
            hum.AutoRotate = false

            local gyro = hrp:FindFirstChild("LockOn_BodyGyro")
            if not gyro then
                gyro = Instance.new("BodyGyro")
                gyro.Name = "LockOn_BodyGyro"
                gyro.MaxTorque = Vector3.new(0, 400000, 0)
                gyro.P = 35000
                gyro.D = 300
                gyro.Parent = hrp
            end

            local targetPos = targetHrp.Position
            if Settings.PredictiveLockOn then
                targetPos = targetPos + (targetHrp.AssemblyLinearVelocity * Settings.PredictionLeadTime)
            end

            local flatLookTarget = Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z)
            gyro.CFrame = CFrame.lookAt(hrp.Position, flatLookTarget)
        else
            cleanupBodyLock(hrp, hum)
        end
    end

    local DRAG_THRESHOLD = 8

    local function makeControlledDraggable(btn, onClick)
        local activeInput = nil
        local isDragging = false
        local dragStart = Vector3.zero
        local startPos = UDim2.new()
        local moveConn, endConn, cancelConn

        local function cleanup()
            activeInput = nil
            isDragging = false
            if moveConn then moveConn:Disconnect(); moveConn = nil end
            if endConn then endConn:Disconnect(); endConn = nil end
            if cancelConn then cancelConn:Disconnect(); cancelConn = nil end
        end

        btn.InputBegan:Connect(function(input)
            if activeInput ~= nil then return end

            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                activeInput = input
                isDragging = false
                dragStart = input.Position
                startPos = btn.Position

                if moveConn then moveConn:Disconnect() end
                if endConn then endConn:Disconnect() end
                if cancelConn then cancelConn:Disconnect() end

                moveConn = UserInputService.InputChanged:Connect(function(moveInput)
                    if moveInput == activeInput then
                        local delta = moveInput.Position - dragStart

                        if not isDragging and delta.Magnitude >= DRAG_THRESHOLD then
                            isDragging = true
                        end

                        if isDragging then
                            local camera = workspace.CurrentCamera
                            local vp = camera and camera.ViewportSize or Vector2.new(1920, 1080)
                            local btnSize = btn.AbsoluteSize

                            local targetX = math.clamp(startPos.X.Offset + delta.X, 0, math.max(0, vp.X - btnSize.X))
                            local targetY = math.clamp(startPos.Y.Offset + delta.Y, 0, math.max(0, vp.Y - btnSize.Y))

                            btn.Position = UDim2.new(startPos.X.Scale, targetX, startPos.Y.Scale, targetY)
                        end
                    end
                end)

                local function handleEnd(endedInput)
                    if endedInput == activeInput then
                        local wasDragging = isDragging
                        cleanup()

                        if not wasDragging and onClick then
                            onClick()
                        end
                    end
                end

                endConn = UserInputService.InputEnded:Connect(handleEnd)
                cancelConn = UserInputService.InputCancelled:Connect(handleEnd)
            end
        end)
    end

    local parentGui = getSafeGuiParent()
    local existingGui = parentGui:FindFirstChild("LockOnMobileGui")
    if existingGui then existingGui:Destroy() end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "LockOnMobileGui"
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.Enabled = Settings.MobileGUI
    screenGui.Parent = parentGui

    local lockBtn = Instance.new("TextButton", screenGui)
    lockBtn.Name = "LockOnButton"
    lockBtn.Size = UDim2.new(0, 44, 0, 44)
    lockBtn.Position = UDim2.new(0, 605, 0, 40)
    lockBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    lockBtn.BackgroundTransparency = 0.2
    lockBtn.BorderSizePixel = 0
    lockBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
    lockBtn.Text = "LOCK\nOFF"
    lockBtn.TextSize = 10
    lockBtn.Font = Enum.Font.GothamBold
    lockBtn.Active = true

    Instance.new("UICorner", lockBtn).CornerRadius = UDim.new(0, 8)
    local lockStroke = Instance.new("UIStroke", lockBtn)
    lockStroke.Color = Color3.fromRGB(50, 50, 50)

    local function ToggleLockOn(state, predictive)
        Settings.LockOn = (state ~= nil) and state or not Settings.LockOn
        if predictive ~= nil then
            Settings.PredictiveLockOn = predictive
        end

        local char = LocalPlayer.Character
        local hrp = getRootPart(char)
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if Settings.LockOn then
            pcall(function()
                if not State.SavedComputerCamMode then
                    State.SavedComputerCamMode = LocalPlayer.DevComputerCameraMovementMode
                end
                if not State.SavedTouchCamMode then
                    State.SavedTouchCamMode = LocalPlayer.DevTouchCameraMovementMode
                end

                LocalPlayer.DevComputerCameraMovementMode = Enum.DevComputerCameraMovementMode.Classic
                LocalPlayer.DevTouchCameraMovementMode = Enum.DevTouchCameraMovementMode.Classic
                LocalPlayer.CameraMode = Enum.CameraMode.Classic
                if Camera then
                    Camera.CameraType = Enum.CameraType.Custom
                end
            end)

            local target = GetNearestLockOnTarget()
            if target then
                Settings.LockOnTarget = target
                lockBtn.Text = Settings.PredictiveLockOn and "LOCK\nPRED" or "LOCK\nON"
                lockBtn.BackgroundColor3 = Settings.PredictiveLockOn and Color3.fromRGB(0, 140, 200) or Color3.fromRGB(0, 160, 80)
                lockBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                Settings.LockOn = false
                Settings.LockOnTarget = nil
                lockBtn.Text = "LOCK\nOFF"
                lockBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                lockBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
                cleanupBodyLock(hrp, hum)
            end
        else
            Settings.LockOn = false
            Settings.LockOnTarget = nil
            State.SuspendedLockOnUntil = 0
            lockBtn.Text = "LOCK\nOFF"
            lockBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
            lockBtn.TextColor3 = Color3.fromRGB(240, 240, 240)

            cleanupBodyLock(hrp, hum)

            pcall(function()
                if State.SavedComputerCamMode then
                    LocalPlayer.DevComputerCameraMovementMode = State.SavedComputerCamMode
                    State.SavedComputerCamMode = nil
                end
                if State.SavedTouchCamMode then
                    LocalPlayer.DevTouchCameraMovementMode = State.SavedTouchCamMode
                    State.SavedTouchCamMode = nil
                end
                if Camera and hum then
                    Camera.CameraSubject = hum
                end
            end)
        end

        UpdateBodyLock()
    end

    makeControlledDraggable(lockBtn, function()
        ToggleLockOn()
    end)

    local existingFlipGui = parentGui:FindFirstChild("BackflipMobileGui")
    if existingFlipGui then existingFlipGui:Destroy() end

    local flipScreenGui = Instance.new("ScreenGui")
