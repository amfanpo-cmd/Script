    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = escapeBtn

    ---------------------------------------------------------------------------
    -- TOGGLE & COOLDOWN STATES
    ---------------------------------------------------------------------------
    local nueBsAimEnabled = false
