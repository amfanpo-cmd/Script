                Flag = "AutoSwapEnabledFlag",
                Callback = function(v) Settings.AutoSwapEnabled = v end
            })

            Tab:CreateInput({
                Name = "Target Player for Bring",
                PlaceholderText = "Username or Display Name",
                RemoveTextAfterFocusLost = false,
                Callback = function(Text) Settings.TargetPlayerName = Text end
            })

            Tab:CreateButton({
                Name = "Trigger Todo Bring",
                Callback = executeTodoBring
            })

        -- 2. Linoria / Fluent Adapted Interface
        elseif type(Tab.AddToggle) == "function" or type(Tab.AddLeftGroupbox) == "function" then
            local LeftBox = Tab.AddLeftGroupbox and Tab:AddLeftGroupbox("Auto Slide & BFC") or Tab
            local RightBox = Tab.AddRightGroupbox and Tab:AddRightGroupbox("Swap 2 & Bring") or Tab

            LeftBox:AddToggle("AutoSlideIfJump", {
                Text = "Auto slide if jump",
                Default = Settings.AutoSlideIfJump,
                Callback = function(v) Settings.AutoSlideIfJump = v end
            })

            LeftBox:AddToggle("AutoBFC", {
                Text = "Auto BFC (Brute Force 2nd Hit)",
                Default = Settings.AutoBFC,
                Callback = function(v) Settings.AutoBFC = v end
            })

            LeftBox:AddSlider("BFCDelay", {
                Text = "BFC Retrigger Delay",
                Default = Settings.BFCDelay,
                Min = 0.1,
                Max = 1.2,
                Rounding = 2,
                Increment = 0.01,
                Callback = function(v) Settings.BFCDelay = v end
            })

            LeftBox:AddButton("Trigger Brute Force", executeBruteForceSecondHit)

            LeftBox:AddToggle("AutoTodoClap", {
                Text = "Auto Perfect Clap",
                Default = Settings.AutoPerfectClap,
                Callback = function(v) Settings.AutoPerfectClap = v end
            })

            LeftBox:AddToggle("TodoM1Swap", {
                Text = "Dash After Swap (M1 Swap)",
                Default = Settings.TodoM1Swap,
