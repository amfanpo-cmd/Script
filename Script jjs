    RunService.Heartbeat:Connect(function(dt)
        local char = LocalPlayer.Character
        local hrp = getRootPart(char)

        if Settings.RagdollWeight and hrp and hrp.Parent then
            local isKnockedBack = false

            local charsFolder = Workspace:FindFirstChild("Characters")
            local myCharInFolder = charsFolder and charsFolder:FindFirstChild(LocalPlayer.Name)
            if myCharInFolder and myCharInFolder:FindFirstChild("Knockback") then
                isKnockedBack = true
            end

            if not isKnockedBack and char:FindFirstChild("Knockback") then
                isKnockedBack = true
            end

            local info = char:FindFirstChild("Info")
            if not isKnockedBack and info and (info:FindFirstChild("Knockback") or info:FindFirstChild("Ragdoll")) then
                isKnockedBack = true
            end

            if isKnockedBack then
                local targetGravity = Settings.RagdollGravity * 19.62
                Workspace.Gravity = targetGravity
            else
                if Workspace.Gravity ~= State.OriginalGravity then
                    Workspace.Gravity = State.OriginalGravity
                end
            end
        else
            if Workspace.Gravity ~= State.OriginalGravity then
                Workspace.Gravity = State.OriginalGravity
            end
        end

        if Settings.AntiCounter and os.clock() < State.RemoteBlockUntil and hrp and hrp.Parent then
            if Settings.AntiCounterStop and not Settings.AntiCounterTurn then
                local localVel = hrp.CFrame:VectorToObjectSpace(hrp.AssemblyLinearVelocity)
                if localVel.Z < 0 then
                    localVel = Vector3.new(localVel.X, localVel.Y, 0)
                    hrp.AssemblyLinearVelocity = hrp.CFrame:VectorToWorldSpace(localVel)
                end
            end
        end
    end)

    RunService.RenderStepped:Connect(function()
        local myChar = LocalPlayer.Character
        local myHrp = getRootPart(myChar)
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

        if not myChar or not myHrp or not myHum or myHum.Health <= 0 then
            if Settings.LockOn then ToggleLockOn(false) end
            cleanupBodyLock(myHrp, myHum)
            return
        end

        if Settings.AntiCounter and os.clock() < State.RemoteBlockUntil and Settings.AntiCounterTurn and State.CounterEnemy then
            local enemyHrp = getRootPart(State.CounterEnemy)
            if enemyHrp and enemyHrp.Parent then
                local awayVec = myHrp.Position - enemyHrp.Position
                local flatAway = Vector3.new(awayVec.X, 0, awayVec.Z)
                if flatAway.Magnitude > 0.1 then
                    local lookAway = flatAway.Unit
                    myHrp.CFrame = CFrame.lookAt(myHrp.Position, myHrp.Position + lookAway)
                    if Camera then
                        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, Camera.CFrame.Position + lookAway)
                    end
                end
            end
        elseif Settings.LockOn and os.clock() >= State.SuspendedLockOnUntil then
            local target = Settings.LockOnTarget
            local validTarget = target
                and target.Parent
                and getRootPart(target)
                and target:FindFirstChildOfClass("Humanoid")
                and target:FindFirstChildOfClass("Humanoid").Health > 0

            if validTarget then
                local dist = (getRootPart(target).Position - myHrp.Position).Magnitude
                if dist > 350 then validTarget = false end
            end

            if validTarget then
                local targetPosition = getRootPart(target).Position
                if Settings.PredictiveLockOn then
                    local targetVelocity = getRootPart(target).AssemblyLinearVelocity
                    targetPosition = targetPosition + (targetVelocity * Settings.PredictionLeadTime)
                end

                local cameraPosition = Camera.CFrame.Position
                if (targetPosition - cameraPosition).Magnitude > 0.1 then
                    Camera.CFrame = CFrame.lookAt(cameraPosition, targetPosition)
                end
            else
                ToggleLockOn(false)
            end
        end

        UpdateBodyLock()
    end)

