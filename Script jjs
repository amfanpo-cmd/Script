local function getSafeParent()
    local target = nil
    if gethui then
        local ok, hui = pcall(gethui)
        if ok and hui then target = hui end
    end
    if not target and syn and syn.protect_gui then
        target = CoreGui
    end
    if not target then
        local ok, core = pcall(function() return CoreGui end)
        if ok and core then
            target = core
        elseif LocalPlayer then
            target = LocalPlayer:WaitForChild("PlayerGui", 5)
        end
    end
    return target or game:GetService("CoreGui")
end

