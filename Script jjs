    local function ToggleFlyEngine(state)
        flying = state
        Settings.Fly = state
        flyGui.Enabled = state

        local char = LocalPlayer.Character
        local hrp = getRootPart(char)
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if not flying then
            for _, conn in pairs(flyConnections) do conn:Disconnect() end
            table.clear(flyConnections)
            cleanupFly()
            return
        end

        if not hrp or not hum then return end

        loadFlyAnims(hum)
        flyBV.Parent = hrp
        flyBG.Parent = hrp
        hum.PlatformStand = true

        flyConnections.inputBegan = UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            local k = input.KeyCode
            if k == Enum.KeyCode.W then flyInputs.forward = true end
            if k == Enum.KeyCode.S then flyInputs.back = true end
            if k == Enum.KeyCode.A then flyInputs.left = true end
            if k == Enum.KeyCode.D then flyInputs.right = true end
            if k == Enum.KeyCode.Space then flyInputs.up = true end
            if k == Enum.KeyCode.LeftControl then flyInputs.down = true end
        end)

        flyConnections.inputEnded = UserInputService.InputEnded:Connect(function(input)
            local k = input.KeyCode
            if k == Enum.KeyCode.W then flyInputs.forward = false end
            if k == Enum.KeyCode.S then flyInputs.back = false end
            if k == Enum.KeyCode.A then flyInputs.left = false end
            if k == Enum.KeyCode.D then flyInputs.right = false end
            if k == Enum.KeyCode.Space then flyInputs.up = false end
            if k == Enum.KeyCode.LeftControl then flyInputs.down = false end
        end)

        flyConnections.render = RunService.RenderStepped:Connect(function()
            if not flying or not hrp.Parent then cleanupFly() return end

            flyBV.Parent = hrp
            flyBG.Parent = hrp
            if hum then hum.PlatformStand = true end

            local camCF = Camera.CFrame
            local moveDir = Vector3.zero

            if flyInputs.forward then moveDir += camCF.LookVector end
            if flyInputs.back then moveDir -= camCF.LookVector end
            if flyInputs.left then moveDir -= camCF.RightVector end
            if flyInputs.right then moveDir += camCF.RightVector end

            if hum and hum.MoveDirection.Magnitude > 0 then
                local localMove = camCF:VectorToObjectSpace(hum.MoveDirection)
                moveDir += camCF.RightVector * localMove.X + camCF.LookVector * -localMove.Z
            end

            if flyInputs.up then moveDir += Vector3.new(0, 1, 0) end
            if flyInputs.down then moveDir -= Vector3.new(0, 1, 0) end

            if moveDir.Magnitude > 0 then
                flyBV.Velocity = moveDir.Unit * Settings.FlySpeed
                if flyInputs.up then
                    if flyTracks.up and not flyTracks.up.IsPlaying then stopFlyTracks(); flyTracks.up:Play() end
                elseif flyInputs.down then
                    if flyTracks.down and not flyTracks.down.IsPlaying then stopFlyTracks(); flyTracks.down:Play() end
                elseif flyInputs.back then
                    if flyTracks.back and not flyTracks.back.IsPlaying then stopFlyTracks(); flyTracks.back:Play() end
                else
                    if flyTracks.fast and not flyTracks.fast.IsPlaying then
                        stopFlyTracks()
                        flyTracks.fast:Play()
                        flyTracks.fast:AdjustSpeed(0.05)
                    end
                end
            else
                flyBV.Velocity = Vector3.zero
                if flyTracks.idle and not flyTracks.idle.IsPlaying then
                    stopFlyTracks()
                    flyTracks.idle:Play()
                    flyTracks.idle:AdjustSpeed(0)
                end
            end
            flyBG.CFrame = camCF
        end)
    end

