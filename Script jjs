            pressKey(Enum.KeyCode.Four)
            waitForAttackFinished(2.0)
            standAttacking = false
            if standEnabled and not standVanished then playStandIdle() end
        end)
    end

    ---------------------------------------------------------------------------
    -- STAND RUNTIME TRACKING LOOP
    ---------------------------------------------------------------------------
    task.spawn(function()
        while true do
            RunService.Heartbeat:Wait()
            if standEnabled and standTargetName ~= "" and not standAttacking then
                pcall(function()
                    local masterPlayer = findTargetPlayer(standTargetName)
                    local masterChar = masterPlayer and masterPlayer.Character
                    local masterHRP = masterChar and masterChar:FindFirstChild("HumanoidRootPart")

                    local myChar = LocalPlayer.Character
                    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

                    if masterHRP and myHum and standBP and standBG then
                        if standVanished then
                            standBP.Position = masterHRP.Position + VANISH_OFFSET
                            standBG.CFrame = masterHRP.CFrame
                        else
                            local goal = masterHRP.CFrame:PointToWorldSpace(standActiveOffset)
                            standBP.Position = standBP.Position:Lerp(goal, 0.28)
                            standBG.CFrame = standBG.CFrame:Lerp(masterHRP.CFrame, 0.28)
                        end
                    end
                end)
            end
        end
    end)

    ---------------------------------------------------------------------------
    -- STAND CHAT COMMAND HOOKS
    ---------------------------------------------------------------------------
    local function handleChatCommand(sender, message)
        if not standEnabled or sender.Name:lower() ~= standTargetName:lower() then return end
        local normalized = message:lower():gsub("%s+", "")

        if normalized == "!summon" then
            standVanished = false
            playStandIdle()
        elseif normalized == "!dismiss" then
            standVanished = true
            stopStandIdle()
        elseif normalized == "!m1" and not standVanished then
            local masterChar = sender.Character
            local mHRP = masterChar and masterChar:FindFirstChild("HumanoidRootPart")
            if mHRP then
                local nearestEnemy = nil
                local shortest = 60
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p ~= sender and p.Character then
                        local eHRP = p.Character:FindFirstChild("HumanoidRootPart")
                        local eHum = p.Character:FindFirstChildOfClass("Humanoid")
                        if eHRP and eHum and eHum.Health > 0 then
                            local d = (eHRP.Position - mHRP.Position).Magnitude
                            if d < shortest then
                                shortest = d
                                nearestEnemy = p
                            end
                        end
                    end
                end
                if nearestEnemy then executeM1Combo(nearestEnemy) end
            end
        elseif normalized == "!g" and not standVanished then
            standAttacking = true
            stopStandIdle()
            local mv = getMoveset()
            if mv then fireKnitRemote(mv .. "Service", "Ultimate") end
            pressKey(Enum.KeyCode.G)
            waitForAttackFinished(3.0)
            standAttacking = false
            if standEnabled and not standVanished then playStandIdle() end
        elseif not standVanished and not standAttacking then
            local key = nil
            if normalized == "!1" then key = Enum.KeyCode.One
            elseif normalized == "!2" then key = Enum.KeyCode.Two
            elseif normalized == "!3" then key = Enum.KeyCode.Three
            elseif normalized == "!4" then key = Enum.KeyCode.Four end

            if key then
                standAttacking = true
                stopStandIdle()
                standActiveOffset = FRONT_OFFSET
                pressKey(key)
                waitForAttackFinished(2.0)
                standActiveOffset = (standPositionSide == "Left") and LEFT_OFFSET or RIGHT_OFFSET
                standAttacking = false
                if standEnabled and not standVanished then playStandIdle() end
            end
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        p.Chatted:Connect(function(msg) handleChatCommand(p, msg) end)
    end
    Players.PlayerAdded:Connect(function(p)
        p.Chatted:Connect(function(msg) handleChatCommand(p, msg) end)
    end)

    LocalPlayer.CharacterAdded:Connect(function(char)
        if InvisState.Active then
            task.wait(0.5)
            startInvisibility(char)
        end
    end)

