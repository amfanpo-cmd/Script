            local char = LocalPlayer.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
                local anim = Instance.new("Animation")
                anim.AnimationId = animId
                local track = animator:LoadAnimation(anim)
                track.Priority = Enum.AnimationPriority.Action
                track:Play()
            end
        end)

        pcall(function()
            local dashRemote = getDashRemote()
            if dashRemote then
                dashRemote:FireServer(dashDir)
            end
        end)
    end

    local function isDirectlyBehind(lhrp, thrp)
        if not (lhrp and thrp and lhrp.Parent and thrp.Parent) then return false end

        local targetForward = safeFlatUnit(thrp.CFrame.LookVector, Vector3.new(0, 0, -1))
        local toPlayer = Vector3.new(lhrp.Position.X - thrp.Position.X, 0, lhrp.Position.Z - thrp.Position.Z)
        if toPlayer.Magnitude > (Settings.Radius + 4.0) or toPlayer.Magnitude < 0.1 then
            return false
        end

        local toPlayerUnit = toPlayer.Unit
        if targetForward:Dot(toPlayerUnit) > (Settings.FeintThreshold or -0.70) then
            return false
        end

        local myForward = safeFlatUnit(lhrp.CFrame.LookVector, Vector3.new(0, 0, -1))
        if myForward:Dot(-toPlayerUnit) < 0.35 then
            return false
        end

        return true
    end

    local function schedulePostTechFeintCheck(targetChar)
        if not autoFeintEnabled then return end

        feintCheckToken = feintCheckToken + 1
        local currentToken = feintCheckToken

        preciseSchedule(Settings.FeintDelay, function()
            if currentToken ~= feintCheckToken or not autoFeintEnabled then return end

            local myChar = LocalPlayer.Character
            local myHRP = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
            if not myHRP then return end

            local tChar = (targetChar and targetChar.Parent) and targetChar or getNearestTarget()
            if not tChar or isEnemyInvalid(tChar) then
                spamFeintRemote()
                return
            end

            local tHRP = tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("Torso")
            if not tHRP or not isDirectlyBehind(myHRP, tHRP) then
                spamFeintRemote()
            end
        end)
    end

    local function executeLegitBFC()
        if techInProgress then return end

        local targetChar = getNearestTarget()
        if not targetChar or isEnemyInvalid(targetChar) then return end

        local myChar = LocalPlayer.Character
        local myHRP = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
        local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")

        if not (myHRP and myHumanoid and myHumanoid.Health > 0) then return end
        local tHRP = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso")
        if not tHRP then return end

        techInProgress = true

        local tCF = tHRP.CFrame
        local tRight = safeFlatUnit(tCF.RightVector, Vector3.new(1, 0, 0))
        local tLook = safeFlatUnit(tCF.LookVector, Vector3.new(0, 0, -1))
        local sideSign = (myHRP.Position - tHRP.Position):Dot(tRight) >= 0 and 1 or -1
        local isLeft = (sideSign < 0)

        if not noDashWhenGlide then
            playReversedDirectionalAnimation(isLeft)
        end

        safeFireDivergentFist(true)
        schedulePostTechFeintCheck(targetChar)

        local targetFlankPos = tHRP.Position 
            - (tLook * Settings.Radius) 
            + (tRight * (3.5 * sideSign))

        local flankVector = (targetFlankPos - myHRP.Position)
        local moveDir = safeFlatUnit(flankVector, safeFlatUnit(myHRP.CFrame.LookVector, Vector3.new(0, 0, -1)))

        local torso = myChar:FindFirstChild("Torso") or myHRP
        for _, c in ipairs(torso:GetChildren()) do
            if c.Name == "MovementForce" then pcall(c.Destroy, c) end
        end

        local bv = Instance.new("BodyVelocity")
        bv.Name = "MovementForce"
        bv.MaxForce = Vector3.new(60000, 0, 60000)
        bv.P = 400000
        bv.Velocity = moveDir * Settings.LegitSpeed
        bv.Parent = torso
        Debris:AddItem(bv, 0.28)

        local startTime = os.clock()
        local lockConn
        lockConn = RunService.Heartbeat:Connect(function()
            local elapsed = os.clock() - startTime
            if elapsed >= 0.28 or isEnemyInvalid(targetChar) or not (myHRP.Parent and tHRP.Parent and myHumanoid.Health > 0) then
                lockConn:Disconnect()
                ResetVelocity(myHRP)
                task.delay(0.02, function()
                    techInProgress = false
                end)
                return
            end

            local enemyPos = tHRP.Position
            myHRP.CFrame = safeLookAt(myHRP.Position, Vector3.new(enemyPos.X, myHRP.Position.Y, enemyPos.Z), myHRP.CFrame)
        end)
    end

    local function executeBlatantBFC()
        if techInProgress then return end

        local targetChar = getNearestTarget()
        if not targetChar or isEnemyInvalid(targetChar) then return end

        local myChar = LocalPlayer.Character
        local myHRP = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
        local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")

        if not (myHRP and myHumanoid and myHumanoid.Health > 0) then return end
        local tHRP = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso") or targetChar.PrimaryPart
        if not tHRP then return end

        techInProgress = true

        local startPos = myHRP.Position
        local initialTargetCF = tHRP.CFrame
        local initialRightVec = safeFlatUnit(initialTargetCF.RightVector, Vector3.new(1, 0, 0))
        local sideSign = (startPos - tHRP.Position):Dot(initialRightVec) >= 0 and 1 or -1
        local isLeft = (sideSign < 0)

        if not noDashWhenGlide then
            playReversedDirectionalAnimation(isLeft)
        end

        safeFireDivergentFist(true)
        schedulePostTechFeintCheck(targetChar)

        local startTime = os.clock()
        local initialLookFlat = safeFlatUnit(initialTargetCF.LookVector, Vector3.new(0, 0, -1))

        local function getBehindPosition()
            if isEnemyInvalid(targetChar) or not (tHRP and tHRP.Parent) then return nil end
            return tHRP.Position - initialLookFlat * Settings.Radius
        end

        local function getSideControlAnchor()
            if isEnemyInvalid(targetChar) or not (tHRP and tHRP.Parent) then return nil end
            return tHRP.Position + initialRightVec * (Settings.CurveStrength * sideSign)
        end

        myHumanoid.AutoRotate = false

        local heartbeatConn
        heartbeatConn = RunService.Heartbeat:Connect(function()
            local elapsed = os.clock() - startTime
            local alpha = math.clamp(elapsed / Settings.PerfectTime, 0, 1)

            if alpha >= 1 or isEnemyInvalid(targetChar) or not (myHRP.Parent and tHRP.Parent and myHumanoid.Health > 0) then
                heartbeatConn:Disconnect()
                myHumanoid.AutoRotate = true

                if not isEnemyInvalid(targetChar) then
                    local finalPos = getBehindPosition()
                    if finalPos and myHRP.Parent then
                        myHRP.CFrame = safeLookAt(Vector3.new(finalPos.X, myHRP.Position.Y, finalPos.Z), Vector3.new(tHRP.Position.X, myHRP.Position.Y, tHRP.Position.Z), myHRP.CFrame)
                        ResetVelocity(myHRP)
                    end
                else
                    ResetVelocity(myHRP)
                end

                task.delay(0.02, function()
                    techInProgress = false
                end)
                return
            end

            local rawEnd = getBehindPosition()
            local controlAnchor = getSideControlAnchor()

            if not rawEnd or not controlAnchor then
                heartbeatConn:Disconnect()
                myHumanoid.AutoRotate = true
                ResetVelocity(myHRP)
                task.delay(0.02, function()
                    techInProgress = false
                end)
                return
            end

            local blendedControl = Vector3.new(
                controlAnchor.X * (1 - alpha) + rawEnd.X * alpha,
                myHRP.Position.Y,
                controlAnchor.Z * (1 - alpha) + rawEnd.Z * alpha
            )

            local t = 1 - (1 - alpha)^2
            local curvePosition = Vector3.new(
                (1 - t)^2 * startPos.X + 2 * (1 - t) * t * blendedControl.X + t^2 * rawEnd.X,
                myHRP.Position.Y,
                (1 - t)^2 * startPos.Z + 2 * (1 - t) * t * blendedControl.Z + t^2 * rawEnd.Z
            )

            myHRP.CFrame = safeLookAt(curvePosition, Vector3.new(tHRP.Position.X, curvePosition.Y, tHRP.Position.Z), myHRP.CFrame)
            ResetVelocity(myHRP)
        end)
    end

    local function executeBFAssist()
        local targetChar = getNearestTarget()
        if not targetChar or isEnemyInvalid(targetChar) then return end

        local myChar = LocalPlayer.Character
        local myHRP = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
        if not myChar or not myHRP then return end

        local isLeft = false
        local tHRP = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso")
        if tHRP then
            local tCF = tHRP.CFrame
            local tRight = safeFlatUnit(tCF.RightVector, Vector3.new(1, 0, 0))
            local sideSign = (myHRP.Position - tHRP.Position):Dot(tRight) >= 0 and 1 or -1
            isLeft = (sideSign < 0)
        end

        playReversedDirectionalAnimation(isLeft)
        safeFireDivergentFist(true)
        schedulePostTechFeintCheck(targetChar)
    end

    local function executeStrikesMovement(track, char)
        local myHRP = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
        if not myHRP then return end

        task.spawn(function()
            local earlyStopped = false
            local earlyConn
            earlyConn = track.Stopped:Connect(function()
                earlyStopped = true
                if earlyConn then earlyConn:Disconnect() end
            end)

            task.wait(Settings.StrikeDelay)
            if earlyConn then earlyConn:Disconnect() end

            if earlyStopped or not track.IsPlaying or not (char and char.Parent and myHRP and myHRP.Parent) then
                return
            end

            local duration = Settings.StrikeDuration
            local speed = Settings.StrikeDistance / duration
            local isStopped = false

            local stopConn
            stopConn = track.Stopped:Connect(function()
                isStopped = true
                if stopConn then stopConn:Disconnect() end
            end)

            local startTime = os.clock()
            local heartbeatConn
            heartbeatConn = RunService.Heartbeat:Connect(function(dt)
                if isStopped or (os.clock() - startTime) >= duration or not (char and char.Parent and myHRP and myHRP.Parent) then
                    heartbeatConn:Disconnect()
                    if stopConn then stopConn:Disconnect() end
                    ResetVelocity(myHRP)
                    return
                end

                ResetVelocity(myHRP)
                local camLook = Camera.CFrame.LookVector
                local moveDir = (camLook.Magnitude > 0) and camLook.Unit or myHRP.CFrame.LookVector
                myHRP.CFrame = CFrame.new(myHRP.Position + (moveDir * (speed * dt))) * (myHRP.CFrame - myHRP.Position)
            end)
        end)
    end

