local KeybindRegistry = {}
local ActiveBindingKeybind = nil

local function registerKeybind(keybindObj)
    table.insert(KeybindRegistry, keybindObj)
end

local function unregisterKeybind(keybindObj)
    for i, obj in ipairs(KeybindRegistry) do
        if obj == keybindObj then
            table.remove(KeybindRegistry, i)
            break
        end
    end
end

local function enforceAntiOverlap(sourceObj, newKeyName)
    if not newKeyName or newKeyName == "None" or newKeyName == "Unknown" then return end
    for _, other in ipairs(KeybindRegistry) do
        if other ~= sourceObj and other.GetKey() == newKeyName then
            other.SetToNone()
        end
    end
end

