    local function GetNearestTarget(maxDist, allowKnockback)
        local range = maxDist or Settings.FlankRange
        local localChar = LocalPlayer.Character
        if not localChar then return nil end

        local myHRP = localChar:FindFirstChild("HumanoidRootPart") or localChar:FindFirstChild("Torso")
        if not myHRP then return nil end

        local nearestTarget = nil
        local shortestDist = range

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                if not isTargetInvalid(char, allowKnockback) and not char:FindFirstChildOfClass("ForceField") then
                    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
                    if hrp then
                        local dist = (hrp.Position - myHRP.Position).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            nearestTarget = char
                        end
                    end
                end
            end
        end

        if not nearestTarget then
            local liveFolder = Workspace:FindFirstChild("Live") or Workspace:FindFirstChild("Characters")
            if liveFolder then
                for _, model in ipairs(liveFolder:GetChildren()) do
                    if model:IsA("Model") and model ~= localChar and not Players:GetPlayerFromCharacter(model) then
                        if not isTargetInvalid(model, allowKnockback) and not model:FindFirstChildOfClass("ForceField") then
                            local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
                            if hrp then
                                local dist = (hrp.Position - myHRP.Position).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    nearestTarget = model
                                end
                            end
                        end
                    end
                end
            end
        end

        return nearestTarget
    end

    local function executeFullSideDash(char, dir, animOnly)
