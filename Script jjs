        table.clear(ItemSettings.Billboards)
    end

    local function updateItemESP()
        if not ItemSettings.ESPEnabled then
            clearItemESP()
            return
        end

        local folder = getItemsFolder()
        if not folder then return end

        local char = LocalPlayer.Character
        local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        local myPos = hrp and hrp.Position or Vector3.zero

        for _, item in ipairs(folder:GetChildren()) do
            local part = item:IsA("BasePart") and item or (item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")))
            if part then
                local dist = (part.Position - myPos).Magnitude
                if dist <= ItemSettings.MaxDistance then
                    local hl = ItemSettings.Highlights[item]
                    if not (hl and hl.Parent) then
                        hl = Instance.new("Highlight")
                        hl.Name = "ItemCharm"
                        hl.Adornee = item
                        hl.FillColor = ItemSettings.ESPColor
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0.2
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = item
                        ItemSettings.Highlights[item] = hl
                    else
                        hl.FillColor = ItemSettings.ESPColor
                    end

                    local bb = ItemSettings.Billboards[item]
                    if not (bb and bb.Parent) then
                        bb = Instance.new("BillboardGui")
                        bb.Name = "ItemBillboard"
                        bb.Adornee = part
                        bb.Size = UDim2.new(0, 120, 0, 30)
                        bb.StudsOffset = Vector3.new(0, 2, 0)
                        bb.AlwaysOnTop = true
                        bb.Parent = item

                        local lbl = Instance.new("TextLabel")
                        lbl.Name = "Label"
                        lbl.Size = UDim2.new(1, 0, 1, 0)
                        lbl.BackgroundTransparency = 1
                        lbl.TextColor3 = ItemSettings.ESPColor
                        lbl.TextStrokeTransparency = 0
                        lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                        lbl.Font = Enum.Font.SourceSansBold
                        lbl.TextSize = 13
                        lbl.Text = string.format("%s [%dm]", item.Name, math.floor(dist))
                        lbl.Parent = bb

                        ItemSettings.Billboards[item] = bb
                    else
                        local lbl = bb:FindFirstChild("Label")
                        if lbl then
                            lbl.TextColor3 = ItemSettings.ESPColor
                            lbl.Text = string.format("%s [%dm]", item.Name, math.floor(dist))
                        end
                    end
                else
                    if ItemSettings.Highlights[item] then
                        ItemSettings.Highlights[item]:Destroy()
                        ItemSettings.Highlights[item] = nil
                    end
                    if ItemSettings.Billboards[item] then
                        ItemSettings.Billboards[item]:Destroy()
                        ItemSettings.Billboards[item] = nil
                    end
                end
            end
        end
    end

    local function getNearestEnemy(maxDist)
        local shortest = maxDist or RocketSettings.MaxAimDistance
        local nearest = nil
        local char = LocalPlayer.Character
        local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        if not hrp then return nil end

        local search = Workspace:FindFirstChild("Characters") or Workspace
        for _, obj in ipairs(search:GetChildren()) do
            if obj:IsA("Model") and obj ~= char then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local eHrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                if hum and eHrp and hum.Health > 0 and not obj:FindFirstChildOfClass("ForceField") then
                    local d = (eHrp.Position - hrp.Position).Magnitude
                    if d <= shortest then
                        shortest = d
                        nearest = obj
                    end
                end
            end
        end
        return nearest
    end

    local function calculateAvoidanceVector(origin, targetPos, ignoreList)
        local direct = targetPos - origin
        local dist = direct.Magnitude
        if dist < 1 then return direct end
        local unit = direct.Unit

        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = ignoreList or {}
        params.IgnoreWater = true

        local hit = Workspace:Raycast(origin, unit * dist, params)
        if not hit then
            return unit
        end

        local up = Vector3.new(0, 1, 0)
        local right = unit:Cross(up)
        if right.Magnitude < 0.05 then
            right = Vector3.new(1, 0, 0)
        else
            right = right.Unit
        end
        local trueUp = right:Cross(unit).Unit

        local testAngles = { 18, 32, 48, 64 }
        local bestVector = unit
        local maxClearDist = 0

        for _, ang in ipairs(testAngles) do
            local rad = math.rad(ang)
            local candidates = {
                (CFrame.fromAxisAngle(trueUp, rad) * unit).Unit,
                (CFrame.fromAxisAngle(trueUp, -rad) * unit).Unit,
                (CFrame.fromAxisAngle(right, -rad) * unit).Unit,
                (CFrame.fromAxisAngle(right, -rad) * CFrame.fromAxisAngle(trueUp, rad) * unit).Unit,
                (CFrame.fromAxisAngle(right, -rad) * CFrame.fromAxisAngle(trueUp, -rad) * unit).Unit
            }

            for _, cand in ipairs(candidates) do
                local testHit = Workspace:Raycast(origin, cand * math.min(dist, 120), params)
                if not testHit then
                    return cand
                else
                    local clearD = (testHit.Position - origin).Magnitude
                    if clearD > maxClearDist then
                        maxClearDist = clearD
                        bestVector = cand
                    end
                end
            end
        end

        return bestVector
    end

    local function attachGyroToRocket(rocket)
        local rPart = getRocketPart(rocket)
        if not rPart then return nil end

        local existing = rPart:FindFirstChild("RocketSteerGyro")
        if existing and existing:IsA("BodyGyro") then
            return existing
        end

        local bg = Instance.new("BodyGyro")
        bg.Name = "RocketSteerGyro"
        bg.MaxTorque = Vector3.new(400000, 400000, 400000)
        bg.P = 15000
        bg.D = 400
        bg.CFrame = rPart.CFrame
        bg.Parent = rPart
        return bg
    end

    local function handleRocketAdded(child)
        if not (child.Name == "Rocket" or string.lower(child.Name):find("rocket")) then return end

        local char = LocalPlayer.Character
        local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        if not hrp then return end

        task.wait(0.03)
        local rPart = getRocketPart(child)
        if rPart and (rPart.Position - hrp.Position).Magnitude <= 28 then
            State.ActiveRocket = child
            State.ActiveGyro = attachGyroToRocket(child)

            if RocketSettings.AutoRocketRide then
                hrp.CFrame = rPart.CFrame * CFrame.new(0, 3.2, 0)
                hrp.AssemblyLinearVelocity = rPart.AssemblyLinearVelocity
            end
        end
    end

    local function setupBulletsListener()
        local bullets = getBulletsFolder()
        if bullets then
            bullets.ChildAdded:Connect(handleRocketAdded)
            for _, c in ipairs(bullets:GetChildren()) do
                task.spawn(handleRocketAdded, c)
            end
        end

        Workspace.ChildAdded:Connect(function(c)
            if string.lower(c.Name) == "bullets" then
                c.ChildAdded:Connect(handleRocketAdded)
            elseif string.lower(c.Name):find("rocket") then
                handleRocketAdded(c)
            end
        end)
    end

    setupBulletsListener()

    RunService.Stepped:Connect(function()
        if not RocketSettings.AutoRocketRide then return end
        local rocket = State.ActiveRocket
        if not (rocket and rocket.Parent) then return end

        local char = LocalPlayer.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                end
            end
        end
    end)

    RunService.Heartbeat:Connect(function()
        local rocket = State.ActiveRocket
        if not (rocket and rocket.Parent) then
            if State.ActiveGyro and State.ActiveGyro.Parent then
                pcall(function() State.ActiveGyro:Destroy() end)
            end
            State.ActiveRocket = nil
            State.ActiveGyro = nil
            return
        end

        local rPart = getRocketPart(rocket)
        if not rPart then return end

        local char = LocalPlayer.Character
        local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if RocketSettings.AutoRocketRide and hrp and hum and hum.Health > 0 then
            local topCFrame = rPart.CFrame * CFrame.new(0, 3.2, 0)
            hrp.CFrame = topCFrame
            hrp.AssemblyLinearVelocity = rPart.AssemblyLinearVelocity
            hrp.AssemblyAngularVelocity = Vector3.zero

            if hum:GetState() ~= Enum.HumanoidStateType.Running then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
        end

        if not State.ActiveGyro or not State.ActiveGyro.Parent then
            State.ActiveGyro = attachGyroToRocket(rocket)
        end

        if State.ActiveGyro then
            if RocketSettings.AutoPerfectAim then
                local target = getNearestEnemy(RocketSettings.MaxAimDistance)
                if target then
                    local eHrp = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Torso")
                    if eHrp then
                        local ignoreList = { char, rocket, target }
                        local steerVector = calculateAvoidanceVector(rPart.Position, eHrp.Position, ignoreList)
                        local targetLook = CFrame.lookAt(rPart.Position, rPart.Position + steerVector)

                        State.ActiveGyro.CFrame = State.ActiveGyro.CFrame:Lerp(targetLook, RocketSettings.AimSmoothness)
                    end
                end
            elseif Camera then
                local camLook = Camera.CFrame.LookVector
                State.ActiveGyro.CFrame = State.ActiveGyro.CFrame:Lerp(CFrame.lookAt(rPart.Position, rPart.Position + camLook), 0.3)
            end
        end
    end)

    task.spawn(function()
        while true do
            task.wait(0.8)
            if ItemSettings.ESPEnabled then
                updateItemESP()
