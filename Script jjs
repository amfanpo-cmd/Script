                    activated:FireServer(focusStrike, nil)
                end
            end)
            isAutoFiring = false
        end)
    end

    -- Hook Remote Execution via __namecall
    if hookmetamethod then
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if autoBlackflashEnabled and not isAutoFiring and not checkcaller() and method == "FireServer" then
                if self.Name == "Activated" and self.Parent and self.Parent.Name == "RE" and self.Parent.Parent and self.Parent.Parent.Name == "FocusStrikeService" then
                    triggerSecondaryFocusStrike()
                end
            end
            return oldNamecall(self, ...)
        end)
    end

    MahitoTab:CreateToggle({
        Name = "Auto Blackflash",
        CurrentValue = false,
        Flag = "Mahito_AutoBlackflash",
        Callback = function(Value)
            autoBlackflashEnabled = Value
        end
    })

    --------------------------------------------------------------------------------
    -- FEATURE 2: CHUNKY BLOCKBREAKER DASH AMP
    --------------------------------------------------------------------------------
    local dashAmpEnabled = false
    local dashAmpPercent = 150
    local dashAnimId = "81786875517933"
    local activeBoostConnection = nil

    if MahitoTab.CreateSection then
        MahitoTab:CreateSection("Blockbreaker Dash Amp")
    end

    local function setupDashDetection(character)
        if not character then return end
        local humanoid = character:WaitForChild("Humanoid", 5)
        if not humanoid then return end
        local animator = humanoid:WaitForChild("Animator", 5)
        if not animator then return end

        animator.AnimationPlayed:Connect(function(animTrack)
            if not dashAmpEnabled then return end
            if animTrack.Animation and string.find(animTrack.Animation.AnimationId, dashAnimId) then
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                if not rootPart then return end

                if activeBoostConnection then activeBoostConnection:Disconnect() end

                local baseSpeed = rootPart.AssemblyLinearVelocity.Magnitude
                if baseSpeed < 10 then baseSpeed = 50 end
                local targetSpeed = baseSpeed * (dashAmpPercent / 100)

                activeBoostConnection = RunService.RenderStepped:Connect(function()
                    if not animTrack.IsPlaying or not rootPart or not rootPart.Parent then
                        if activeBoostConnection then
                            activeBoostConnection:Disconnect()
                            activeBoostConnection = nil
                        end
                        return
                    end

                    local camera = workspace.CurrentCamera
                    if camera then
                        local lookDir = camera.CFrame.LookVector
                        local moveDir = Vector3.new(lookDir.X, 0, lookDir.Z).Unit
                        rootPart.AssemblyLinearVelocity = Vector3.new(
                            moveDir.X * targetSpeed,
                            rootPart.AssemblyLinearVelocity.Y,
                            moveDir.Z * targetSpeed
                        )
                    end
                end)
            end
        end)
    end

    if LocalPlayer.Character then
        setupDashDetection(LocalPlayer.Character)
    end
    LocalPlayer.CharacterAdded:Connect(setupDashDetection)

    MahitoTab:CreateToggle({
        Name = "Chunky Blockbreaker Dash Amp",
        CurrentValue = false,
        Flag = "Mahito_DashAmp_Toggle",
        Callback = function(Value)
            dashAmpEnabled = Value
        end
    })

    MahitoTab:CreateSlider({
        Name = "Velocity Amp (%)",
        Range = {100, 500},
        Increment = 10,
        Suffix = "%",
        CurrentValue = 150,
        Flag = "Mahito_DashAmp_Value",
        Callback = function(Value)
            dashAmpPercent = Value
        end
    })
end

end)

-- ===== Auto QTE (pb5.lua) =====
loadModule("Auto QTE", Tab_AutoQTE, function()
local function safeGetService(name)
    local service = game:GetService(name)
    if cloneref then
        local ok, cloned = pcall(cloneref, service)
        if ok and cloned then return cloned end
    end
    return service
end

return function(Tab)
    local Players = safeGetService("Players")
    local ReplicatedStorage = safeGetService("ReplicatedStorage")
    local UserInputService = safeGetService("UserInputService")
    local VirtualInputManager = safeGetService("VirtualInputManager")
    local RunService = safeGetService("RunService")
    local Workspace = safeGetService("Workspace")
    local CoreGui = safeGetService("CoreGui")

    local LocalPlayer = Players.LocalPlayer

    local function getGuiContainer()
        if gethui then
            local ok, res = pcall(gethui)
            if ok and res then return res end
        end
        local ok, core = pcall(function() return CoreGui end)
        if ok and core then return core end
        return LocalPlayer:WaitForChild("PlayerGui", 5)
    end

    local Settings = {
        AutoQTE = false,
        QTESpeed = 0.05,

        VoteView = false,

        AutoVote = false,
        VoteChoice = "Silence",

        DomainWalk = false
    }

    local State = {
        IsQTERunning = false,
        QTEToken = 0,
        VoteGui = nil,
        VoteText = nil,
        VoteDomain = nil,
        VoteDomainConns = {},
        VoteWatcherConns = {},
        DomainOriginals = setmetatable({}, { __mode = "k" }),
        DomainConnections = {},
        CurrentDomainFolder = nil,
        TrialConnections = {},
        TrialSeen = setmetatable({}, { __mode = "k" }),
        TrialBusy = false
    }

    local VoteOptions = { "Silence", "Confess", "Denial", "Random" }
    local RawVotePicks = { "Silence", "Confess", "Denial" }

    local function triggerHardwareClick(guiObject)
        if not (guiObject and guiObject.Parent) then return end

        pcall(function()
            if firesignal then
                firesignal(guiObject.MouseButton1Down)
                firesignal(guiObject.MouseButton1Click)
                firesignal(guiObject.Activated)
            end
        end)

        pcall(function()
            if typeof(getconnections) == "function" then
                for _, conn in ipairs(getconnections(guiObject.MouseButton1Down)) do
                    pcall(conn.Fire, conn)
                end
                for _, conn in ipairs(getconnections(guiObject.MouseButton1Click)) do
                    pcall(conn.Fire, conn)
                end
                for _, conn in ipairs(getconnections(guiObject.Activated)) do
                    pcall(conn.Fire, conn)
                end
            end
        end)

        pcall(function()
            if VirtualInputManager and guiObject.AbsoluteSize.X > 0 then
                local center = guiObject.AbsolutePosition + (guiObject.AbsoluteSize / 2)
                VirtualInputManager:SendMouseButtonEvent(center.X, center.Y + 36, 0, true, game, 1)
                task.wait(0.015)
                VirtualInputManager:SendMouseButtonEvent(center.X, center.Y + 36, 0, false, game, 1)
            end
        end)
    end

    local function runQTE(qteGui)
        if not Settings.AutoQTE then return end
        State.QTEToken = State.QTEToken + 1
        local currentToken = State.QTEToken

        task.spawn(function()
            local start = os.clock()
            while currentToken == State.QTEToken and Settings.AutoQTE and (os.clock() - start < 15) do
                if qteGui and not qteGui.Parent then break end

                local char = LocalPlayer.Character
                if char then
                    for _, remote in ipairs(char:GetDescendants()) do
                        if remote:IsA("RemoteEvent") then
                            pcall(function() remote:FireServer(true) end)
                        end
                    end
                end

                if qteGui then
                    for _, desc in ipairs(qteGui:GetDescendants()) do
                        if desc:IsA("TextButton") or desc:IsA("ImageButton") then
                            if desc.Visible then
                                triggerHardwareClick(desc)
                            end
                        end
                    end
                end

                task.wait(math.clamp(Settings.QTESpeed, 0.02, 0.8))
            end
        end)
    end

    local function getFJRemote()
        local knit = ReplicatedStorage:FindFirstChild("Knit")
        local innerKnit = knit and (knit:FindFirstChild("Knit") or knit)
        local services = innerKnit and innerKnit:FindFirstChild("Services")
        local fjService = services and services:FindFirstChild("FinalJudgementService")
        local re = fjService and fjService:FindFirstChild("RE")
        return re and re:FindFirstChild("Activated")
    end

    local fjRemote = nil
    pcall(function() fjRemote = getFJRemote() end)

    if fjRemote then
        pcall(function()
            fjRemote.OnClientEvent:Connect(function()
                if Settings.AutoQTE then
                    local pg = LocalPlayer:FindFirstChildWhichIsA("PlayerGui")
                    local qte = pg and pg:FindFirstChild("QTE")
                    runQTE(qte)
                end
            end)
        end)
    end

    pcall(function()
        if hookmetamethod then
            local checkcaller = checkcaller or function() return false end
            local getnamecallmethod = getnamecallmethod or function() return "" end
            local oldNamecall
            oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                if not checkcaller() and Settings.AutoQTE then
                    local method = getnamecallmethod()
                    if method == "FireServer" or method == "InvokeServer" then
                        if self == fjRemote or (self.Name == "Activated" and self.Parent and self.Parent.Name == "RE" and self.Parent.Parent and self.Parent.Parent.Name == "FinalJudgementService") then
                            local pg = LocalPlayer:FindFirstChildWhichIsA("PlayerGui")
                            local qte = pg and pg:FindFirstChild("QTE")
                            runQTE(qte)
                        end
                    end
                end
                return oldNamecall(self, ...)
            end))
        end
    end)

    local function hookCharacterAnim(char)
        if not char then return end
        local hum = char:WaitForChild("Humanoid", 4)
        local animator = hum and (hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 4))
        if not animator then return end

        animator.AnimationPlayed:Connect(function(track)
            if Settings.AutoQTE and track and track.Animation then
                local id = tostring(track.Animation.AnimationId)
                if id:find("11097806") or id:find("FinalJudgement") or id:find("Judgement") then
                    local pg = LocalPlayer:FindFirstChildWhichIsA("PlayerGui")
                    local qte = pg and pg:FindFirstChild("QTE")
                    runQTE(qte)
                end
            end
        end)
    end

    if LocalPlayer.Character then task.spawn(hookCharacterAnim, LocalPlayer.Character) end
    LocalPlayer.CharacterAdded:Connect(hookCharacterAnim)

    local function getWinningPlea(dom)
        local d = dom:GetAttribute("DenialCount") or 0
        local s = dom:GetAttribute("SilenceCount") or 0
        local c = dom:GetAttribute("ConfessCount") or 0

        if d <= 0 and s <= 0 and c <= 0 then
            return nil, d, s, c
        end
        if d >= s and d >= c then return 1, d, s, c end
        if s >= c then return 2, d, s, c end
        return 3, d, s, c
    end

    local function updateVoteHUD()
        if not State.VoteText then return end
        if not State.VoteDomain or not State.VoteDomain.Parent then
            State.VoteText.Text = "Vote\nwaiting"
            State.VoteText.TextColor3 = Color3.fromRGB(150, 150, 150)
            return
        end

        local winner, d, s, c = getWinningPlea(State.VoteDomain)
        local names = { "Denial", "Silence", "Confess" }
        State.VoteText.Text = (winner and names[winner] or "Vote") .. string.format("\n%d  %d  %d", d, s, c)
        State.VoteText.TextColor3 = winner and Color3.fromRGB(240, 240, 240) or Color3.fromRGB(160, 160, 160)
    end

    local function clearVoteDomain()
        for _, conn in ipairs(State.VoteDomainConns) do
            pcall(function() conn:Disconnect() end)
        end
        table.clear(State.VoteDomainConns)
        State.VoteDomain = nil
        updateVoteHUD()
    end

    local function bindVoteDomain(dom)
        clearVoteDomain()
        if not dom then return end
        State.VoteDomain = dom

        local pleas = { "DenialCount", "SilenceCount", "ConfessCount" }
        for _, attr in ipairs(pleas) do
            table.insert(State.VoteDomainConns, dom:GetAttributeChangedSignal(attr):Connect(updateVoteHUD))
        end
        updateVoteHUD()
    end

    local function isDomainModel(obj)
        if not (obj and obj:IsA("Model")) then return false end
        if obj.Name == "Domain" then return true end
        if obj:GetAttribute("DenialCount") ~= nil or obj:GetAttribute("SilenceCount") ~= nil then return true end
        return false
    end

    local function bindVoteFolder(folder)
        table.insert(State.VoteWatcherConns, folder.ChildAdded:Connect(function(c)
            if isDomainModel(c) then bindVoteDomain(c) end
        end))
        table.insert(State.VoteWatcherConns, folder.ChildRemoved:Connect(function(c)
            if c == State.VoteDomain then clearVoteDomain() end
        end))

        for _, c in ipairs(folder:GetChildren()) do
            if isDomainModel(c) then
                bindVoteDomain(c)
                break
            end
        end
    end

    local function createVoteHUD()
        if State.VoteGui then return end

        local sg = Instance.new("ScreenGui")
        sg.Name = "VoteViewGui"
        sg.ResetOnSpawn = false
        sg.IgnoreGuiInset = true
        sg.Parent = getGuiContainer()
        State.VoteGui = sg

        local btn = Instance.new("TextButton")
        btn.Name = "VoteFrame"
        btn.AutoButtonColor = false
        btn.Text = ""
        btn.BorderSizePixel = 0
        btn.AnchorPoint = Vector2.new(0.5, 0)
        btn.Position = UDim2.new(0.5, 0, 0, 64)
        btn.Size = UDim2.fromOffset(120, 46)
        btn.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
        btn.BackgroundTransparency = 0.15
        btn.Parent = sg

        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
        local stroke = Instance.new("UIStroke", btn)
        stroke.Color = Color3.fromRGB(48, 48, 56)
        stroke.Thickness = 1.2

        local lbl = Instance.new("TextLabel")
        lbl.BackgroundTransparency = 1
        lbl.Size = UDim2.new(1, -10, 1, -8)
        lbl.Position = UDim2.fromOffset(5, 4)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 13
        lbl.TextColor3 = Color3.fromRGB(240, 240, 240)
        lbl.Text = "Vote\nwaiting"
        lbl.Parent = btn
        State.VoteText = lbl

        local dragging = false
        local dragStart = Vector3.zero
        local startPos = UDim2.new()

        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = btn.Position
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    local function setVoteView(state)
        Settings.VoteView = state
        if not state then
            clearVoteDomain()
            for _, conn in ipairs(State.VoteWatcherConns) do pcall(function() conn:Disconnect() end) end
            table.clear(State.VoteWatcherConns)
            if State.VoteGui then
                State.VoteGui:Destroy()
                State.VoteGui = nil
                State.VoteText = nil
            end
            return
        end

        createVoteHUD()
        updateVoteHUD()

        local box = Workspace:FindFirstChild("Domains")
        if box then
            bindVoteFolder(box)
        else
            table.insert(State.VoteWatcherConns, Workspace.ChildAdded:Connect(function(c)
                if c.Name == "Domains" then bindVoteFolder(c) end
            end))
        end
    end

    local function executeCourtChoice(chooseGui)
        if State.TrialBusy or not Settings.AutoVote or not (chooseGui and chooseGui.Parent) then return end

        local target = Settings.VoteChoice
        if target == "Random" then
            target = RawVotePicks[math.random(#RawVotePicks)]
        end

        local btn = chooseGui:FindFirstChild(target, true)
        if not btn then
            for _, d in ipairs(chooseGui:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) and string.lower(d.Name) == string.lower(target) then
                    btn = d
                    break
                end
            end
        end

        if not (btn and btn.Visible) then return end

        State.TrialBusy = true
        task.spawn(function()
            task.wait(0.05)
            if chooseGui.Parent and btn and btn.Visible then
                triggerHardwareClick(btn)
            end
            State.TrialBusy = false
        end)
    end

    local function watchChooseUI(chooseGui)
        local function check()
            executeCourtChoice(chooseGui)
        end

        for _, d in ipairs(chooseGui:GetDescendants()) do
            if d:IsA("GuiObject") and not State.TrialSeen[d] then
                State.TrialSeen[d] = true
                table.insert(State.TrialConnections, d:GetPropertyChangedSignal("Visible"):Connect(check))
            end
        end

        table.insert(State.TrialConnections, chooseGui.DescendantAdded:Connect(function(d)
            if d:IsA("GuiObject") and not State.TrialSeen[d] then
                State.TrialSeen[d] = true
                table.insert(State.TrialConnections, d:GetPropertyChangedSignal("Visible"):Connect(check))
                task.defer(check)
            end
        end))

        task.defer(check)
    end

    local function setupPlayerGuiWatcher()
        local pg = LocalPlayer:FindFirstChildWhichIsA("PlayerGui")
        if not pg then return end

        pg.ChildAdded:Connect(function(gui)
            if gui.Name == "QTE" and Settings.AutoQTE then
                runQTE(gui)
            elseif gui.Name == "Choose" and Settings.AutoVote then
                watchChooseUI(gui)
            end
        end)

        local existingQTE = pg:FindFirstChild("QTE")
        if existingQTE and Settings.AutoQTE then runQTE(existingQTE) end

        local existingChoose = pg:FindFirstChild("Choose")
        if existingChoose and Settings.AutoVote then watchChooseUI(existingChoose) end
    end

    setupPlayerGuiWatcher()

    local function setPartNoCollision(part)
        if State.DomainOriginals[part] ~= nil or not part:IsA("BasePart") then return end
        State.DomainOriginals[part] = part.CanCollide
        pcall(function() part.CanCollide = false end)
    end

    local function bindDomainsBox(box)
        if not box or State.CurrentDomainFolder == box then return end
        State.CurrentDomainFolder = box

        for _, desc in ipairs(box:GetDescendants()) do
            setPartNoCollision(desc)
        end

        table.insert(State.DomainConnections, box.DescendantAdded:Connect(function(d)
            if Settings.DomainWalk then setPartNoCollision(d) end
        end))
    end

    local function setDomainWalk(state)
        Settings.DomainWalk = state
        if not state then
            for _, conn in ipairs(State.DomainConnections) do pcall(function() conn:Disconnect() end) end
            table.clear(State.DomainConnections)
            State.CurrentDomainFolder = nil

            for part, collidable in pairs(State.DomainOriginals) do
                if part and part.Parent then
                    pcall(function() part.CanCollide = collidable end)
                end
            end
            table.clear(State.DomainOriginals)
            return
        end

        table.insert(State.DomainConnections, Workspace.ChildAdded:Connect(function(child)
            if Settings.DomainWalk and child.Name == "Domains" then
                bindDomainsBox(child)
            end
        end))

        bindDomainsBox(Workspace:FindFirstChild("Domains"))
    end

    if Tab then
        if type(Tab.CreateSection) == "function" then
            Tab:CreateSection("QTE")

            Tab:CreateToggle({
                Name = "Auto QTE",
                CurrentValue = Settings.AutoQTE,
                Callback = function(v)
                    Settings.AutoQTE = v
                    if v then
                        local pg = LocalPlayer:FindFirstChildWhichIsA("PlayerGui")
                        local qte = pg and pg:FindFirstChild("QTE")
                        if qte then runQTE(qte) end
                    end
                end
            })

            Tab:CreateSlider({
                Name = "QTE Speed",
                Range = {0.02, 0.80},
                Increment = 0.02,
                Suffix = "s",
                CurrentValue = Settings.QTESpeed,
                Callback = function(v)
                    Settings.QTESpeed = v
                end
            })

            Tab:CreateSection("Trial")

            Tab:CreateToggle({
                Name = "Vote View",
                CurrentValue = Settings.VoteView,
                Callback = setVoteView
            })

            Tab:CreateToggle({
                Name = "Auto Vote",
                CurrentValue = Settings.AutoVote,
                Callback = function(v)
                    Settings.AutoVote = v
                    if v then
                        local pg = LocalPlayer:FindFirstChildWhichIsA("PlayerGui")
                        local ch = pg and pg:FindFirstChild("Choose")
                        if ch then watchChooseUI(ch) end
                    else
                        for _, conn in ipairs(State.TrialConnections) do pcall(function() conn:Disconnect() end) end
                        table.clear(State.TrialConnections)
                        table.clear(State.TrialSeen)
                    end
                end
            })

            Tab:CreateDropdown({
                Name = "Vote Choice",
                Options = VoteOptions,
                CurrentOption = Settings.VoteChoice,
                Callback = function(v)
                    Settings.VoteChoice = type(v) == "table" and v[1] or tostring(v)
                end
            })

            Tab:CreateSection("Domain")

            Tab:CreateToggle({
                Name = "Domain Walk",
                CurrentValue = Settings.DomainWalk,
                Callback = setDomainWalk
            })

        elseif type(Tab.AddToggle) == "function" or type(Tab.AddLeftGroupbox) == "function" then
            local LeftBox = Tab.AddLeftGroupbox and Tab:AddLeftGroupbox("QTE & Trial") or Tab
            local RightBox = Tab.AddRightGroupbox and Tab:AddRightGroupbox("Domain") or Tab

            LeftBox:AddToggle("AutoQTE", {
                Text = "Auto QTE",
                Default = Settings.AutoQTE,
                Callback = function(v)
                    Settings.AutoQTE = v
                    if v then
                        local pg = LocalPlayer:FindFirstChildWhichIsA("PlayerGui")
                        local qte = pg and pg:FindFirstChild("QTE")
                        if qte then runQTE(qte) end
                    end
                end
            })

            LeftBox:AddSlider("QTESpeed", {
                Text = "QTE Speed",
                Min = 0.02,
                Max = 0.80,
                Default = Settings.QTESpeed,
                Rounding = 2,
                Callback = function(v) Settings.QTESpeed = v end
            })

            LeftBox:AddToggle("VoteView", {
                Text = "Vote View",
                Default = Settings.VoteView,
                Callback = setVoteView
            })

            LeftBox:AddToggle("AutoVote", {
                Text = "Auto Vote",
                Default = Settings.AutoVote,
                Callback = function(v)
                    Settings.AutoVote = v
                    if v then
                        local pg = LocalPlayer:FindFirstChildWhichIsA("PlayerGui")
                        local ch = pg and pg:FindFirstChild("Choose")
                        if ch then watchChooseUI(ch) end
                    else
                        for _, conn in ipairs(State.TrialConnections) do pcall(function() conn:Disconnect() end) end
                        table.clear(State.TrialConnections)
                        table.clear(State.TrialSeen)
                    end
                end
            })

            LeftBox:AddDropdown("VoteChoice", {
                Text = "Vote Choice",
                Values = VoteOptions,
                Default = Settings.VoteChoice,
                Callback = function(v) Settings.VoteChoice = tostring(v) end
            })

            RightBox:AddToggle("DomainWalk", {
                Text = "Domain Walk",
                Default = Settings.DomainWalk,
                Callback = setDomainWalk
            })
        end
    end

    return {
        Settings = Settings,
        SetDomainWalk = setDomainWalk,
        SetVoteView = setVoteView,
        RunQTE = runQTE
    }
end
end)

