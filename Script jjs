            task.wait(1)

            -- Step 2: Fire RightActivated Remote
            pcall(function()
                local Event = ReplicatedStorage.Knit.Knit.Services.MegumiService.RE.RightActivated
                Event:FireServer(nil)
            end)

            -- Step 3: Wait 0.3 Seconds
            task.wait(0.3)

            -- Step 4: Fire Throwable Remote with index 78
            pcall(function()
                local Event = ReplicatedStorage.Knit.Knit.Services.MovementService.RE.Throwable
                local targetItem = workspace.Map.Destructible.Throwable:GetChildren()[78]
                if targetItem then
                    Event:FireServer(targetItem)
                end
            end)

            -- Step 5: 7 Seconds Cooldown
            task.wait(7)
            isEscaping = false
            escapeBtn.ImageTransparency = 0
        end)
    end

    ---------------------------------------------------------------------------
    -- LISTENERS & TOGGLES
    ---------------------------------------------------------------------------
    escapeBtn.MouseButton1Click:Connect(function()
        if trashEscapeEnabled then
            executeTrashEscape()
        end
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if trashEscapeEnabled and pcEscapeKeybind ~= Enum.KeyCode.Unknown and input.KeyCode == pcEscapeKeybind then
            executeTrashEscape()
        end
    end)

    local function toggleNueBsAim(state)
        nueBsAimEnabled = state
        if state then
            task.spawn(function()
                while nueBsAimEnabled do
                    executeNueBsAim()
                    task.wait(0.5)
                end
            end)
        end
    end

    local function toggleNue180Tech(state)
