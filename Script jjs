            RyuTab:CreateSlider({
                Name = "Time",
                Range = {0.1, 0.6},
                Increment = 0.01,
                Suffix = "s",
                CurrentValue = Settings.Time,
                Callback = function(Value)
                    Settings.Time = Value
                end
            })

            RyuTab:CreateSlider({
                Name = "Curve",
                Range = {0, 25},
                Increment = 1,
                CurrentValue = Settings.Curve,
                Callback = function(Value)
                    Settings.Curve = Value
                end
            })

        elseif type(RyuTab.AddToggle) == "function" or type(RyuTab.AddLeftGroupbox) == "function" then
            local LeftBox = RyuTab.AddLeftGroupbox and RyuTab:AddLeftGroupbox("Combat") or RyuTab
            local RightBox = RyuTab.AddRightGroupbox and RyuTab:AddRightGroupbox("Settings") or RyuTab

            LeftBox:AddToggle("RyuTech", {
