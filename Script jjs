            local multiplier = (dm and dm.Value) or 1
            local dirVec = (dir == "Left") and Vector3.new(-1, 0, 0) or Vector3.new(1, 0, 0)

            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(40000, 0, 40000)
            bv.P = 400000
            bv.Name = "MovementForce"
            bv.Velocity = hrp.CFrame:VectorToWorldSpace(dirVec) * (200 * multiplier)
            bv.Parent = torso
