        Swap2Range = 60,          -- Studs (10 - 150)
        Swap2Cooldown = 0.2       -- Seconds
    }

    local State = {
        Connections = {},
        LastSwap2Time = 0,
        LastM1SwapTime = 0,
        LastSlideTime = 0,
        InternalBFCSend = false,
        LastBFCTrigger = 0
    }

    local SwapAnimations = {
        ["rbxassetid://131358603583212"] = true,
        ["rbxassetid://91074768993486"]  = true,
        ["rbxassetid://116040503139675"] = true
    }

    ---------------------------------------------------------------------------
    -- KNIT REMOTES RESOLUTION
    ---------------------------------------------------------------------------
    local Remotes = {
        TodoEffects = nil,
        TodoActivated = nil,
        TodoRight = nil,
        PebbleEffects = nil,
        DashRemote = nil,
        BruteForceActivated = nil
    }

    local function resolveRemotes()
        pcall(function()
            local knit = ReplicatedStorage:WaitForChild("Knit", 3)
            local services = knit and (knit:FindFirstChild("Knit") and knit.Knit:FindFirstChild("Services") or knit:FindFirstChild("Services"))
            if not services then return end

            local todoSvc = services:FindFirstChild("TodoService")
            if todoSvc and todoSvc:FindFirstChild("RE") then
                Remotes.TodoEffects = todoSvc.RE:FindFirstChild("Effects")
                Remotes.TodoActivated = todoSvc.RE:FindFirstChild("Activated")
                Remotes.TodoRight = todoSvc.RE:FindFirstChild("RightActivated")
            end

            local pebbleSvc = services:FindFirstChild("PebbleThrowService")
            if pebbleSvc and pebbleSvc:FindFirstChild("RE") then
                Remotes.PebbleEffects = pebbleSvc.RE:FindFirstChild("Effects")
            end

            local moveSvc = services:FindFirstChild("MovementService")
            if moveSvc and moveSvc:FindFirstChild("RE") then
                Remotes.DashRemote = moveSvc.RE:FindFirstChild("Dash")
            end

            local bfSvc = services:FindFirstChild("BruteForceService")
            if bfSvc and bfSvc:FindFirstChild("RE") then
                Remotes.BruteForceActivated = bfSvc.RE:FindFirstChild("Activated")
            else
                local direct = ReplicatedStorage:FindFirstChild("Knit")
                direct = direct and direct:FindFirstChild("Knit")
                direct = direct and direct:FindFirstChild("Services")
                direct = direct and direct:FindFirstChild("BruteForceService")
                direct = direct and direct:FindFirstChild("RE")
                Remotes.BruteForceActivated = direct and direct:FindFirstChild("Activated")
            end
        end)
    end

    resolveRemotes()

    ---------------------------------------------------------------------------
    -- HELPERS & UTILITIES
    ---------------------------------------------------------------------------
    local function isTodo(char)
        char = char or LocalPlayer.Character
        if not char then return false end
        return char:GetAttribute("Moveset") == "Todo" or LocalPlayer:GetAttribute("Moveset") == "Todo"
    end

    local function getHRP(char)
        return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
    end

    local function getLocalCharacterModel()
        local charsFolder = Workspace:FindFirstChild("Characters")
        if charsFolder then
            local found = charsFolder:FindFirstChild(LocalPlayer.Name)
            if found then return found end
        end
        return LocalPlayer.Character
    end

    local function getSideDirection(myHrp, targetHrp)
        local d = Vector3.new(targetHrp.Position.X - myHrp.Position.X, 0, targetHrp.Position.Z - myHrp.Position.Z).Unit
        local rv = Vector3.new(myHrp.CFrame.RightVector.X, 0, myHrp.CFrame.RightVector.Z).Unit
        return d:Dot(rv) >= 0 and "Right" or "Left"
    end

    local function executeSideDash(dir)
        local char = LocalPlayer.Character
        local hrp = getHRP(char)
        if not hrp then return end

        if Remotes.DashRemote then
            pcall(function() Remotes.DashRemote:FireServer(dir) end)
        end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                local animFld = ReplicatedStorage:FindFirstChild("Animations")
                local moveFld = animFld and animFld:FindFirstChild("Misc") and animFld.Misc:FindFirstChild("Movement")
                local anim = moveFld and moveFld:FindFirstChild("Dash" .. dir)
                if anim then
                    local track = hum:LoadAnimation(anim)
                    track.Priority = Enum.AnimationPriority.Movement
                    track:Play()
                end
            end)
        end
    end

    local function findTargetPlayer(query)
        if not query or query == "" then return nil end
        local clean = string.lower(query)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                if string.find(string.lower(p.Name), clean, 1, true) or string.find(string.lower(p.DisplayName), clean, 1, true) then
                    return p
                end
            end
        end
        return nil
    end

    ---------------------------------------------------------------------------
    -- 1. AUTO SLIDE IF JUMP (INROLL INJECTOR WITH COOLDOWN)
    ---------------------------------------------------------------------------
    local function handleAutoSlide()
        if not Settings.AutoSlideIfJump then return end

        local now = os.clock()
        if (now - State.LastSlideTime) < Settings.SlideCooldown then return end

        local char = getLocalCharacterModel()
        if not char then return end

        local info = char:FindFirstChild("Info")
        if not info then return end

        -- If InRoll is already present, do not duplicate
        if info:FindFirstChild("InRoll") then return end

        State.LastSlideTime = now

        pcall(function()
            local inRollTag = Instance.new("Folder")
            inRollTag.Name = "InRoll"
            inRollTag.Parent = info

            task.delay(Settings.SlideDuration, function()
                if inRollTag and inRollTag.Parent then
                    inRollTag:Destroy()
                end
            end)
        end)
    end

    ---------------------------------------------------------------------------
    -- 2. AUTO BFC (BRUTE FORCE CHAIN DISPATCHER)
    ---------------------------------------------------------------------------
    local function executeBruteForceSecondHit()
        State.InternalBFCSend = true

        pcall(function()
            local remote = Remotes.BruteForceActivated
            if not (remote and remote.Parent) then
                resolveRemotes()
                remote = Remotes.BruteForceActivated
            end

            local char = LocalPlayer.Character
            local moveset = char and char:FindFirstChild("Moveset")
            local move = moveset and moveset:FindFirstChild("Brute Force")

            if remote and move then
                remote:FireServer(move, nil)
            else
                local cobaltEvent = ReplicatedStorage.Knit.Knit.Services.BruteForceService.RE.Activated
                local localChar = LocalPlayer.Character
                cobaltEvent:FireServer(localChar.Moveset["Brute Force"], nil)
            end
        end)

        task.defer(function()
            State.InternalBFCSend = false
        end)
    end

    local function handleOutgoingBruteForce()
        if not Settings.AutoBFC or State.InternalBFCSend then return end
        local now = os.clock()
        if now - State.LastBFCTrigger < 0.25 then return end
        State.LastBFCTrigger = now

        task.spawn(function()
            task.wait(Settings.BFCDelay or 0.61)
            if Settings.AutoBFC then
                executeBruteForceSecondHit()
            end
        end)
    end

    pcall(function()
        if hookmetamethod then
            local oldNamecall
            oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                if checkcaller() or State.InternalBFCSend then return oldNamecall(self, ...) end

                local method = getnamecallmethod()
                if (method == "FireServer" or method == "fireServer") and self.Name == "Activated" then
                    local parentSvc = self.Parent and self.Parent.Parent
                    if parentSvc and parentSvc.Name == "BruteForceService" then
                        handleOutgoingBruteForce()
                    end
                end

                return oldNamecall(self, ...)
            end))
        end
    end)

    ---------------------------------------------------------------------------
    -- 3. XENON: SWAP 2 NEAREST ENEMIES
    ---------------------------------------------------------------------------
    local function executeSwap2Nearest()
        local char = LocalPlayer.Character
        if not isTodo(char) or not Remotes.TodoRight then return end

        local now = os.clock()
        if now - State.LastSwap2Time < Settings.Swap2Cooldown then return end

        local hrp = getHRP(char)
        if not hrp then return end

        local maxRange = Settings.Swap2Range
        local maxRangeSq = maxRange * maxRange
        local myPos = hrp.Position

        local targetA, targetB = nil, nil
        local distA, distB = math.huge, math.huge

        local charsFolder = Workspace:FindFirstChild("Characters") or Workspace:FindFirstChild("Live")
        local pool = charsFolder and charsFolder:GetChildren() or Workspace:GetChildren()

        for _, c in ipairs(pool) do
            if c:IsA("Model") and c ~= char and not Players:GetPlayerFromCharacter(c) then
                local tHrp = getHRP(c)
                local tHum = c:FindFirstChildOfClass("Humanoid")
                if tHrp and tHum and tHum.Health > 0 and not c:FindFirstChildOfClass("ForceField") then
                    local offset = tHrp.Position - myPos
                    local dSq = (offset.X * offset.X) + (offset.Y * offset.Y) + (offset.Z * offset.Z)
                    if dSq <= maxRangeSq then
                        if dSq < distA then
                            targetB, distB = targetA, distA
                            targetA, distA = c, dSq
                        elseif dSq < distB then
                            targetB, distB = c, dSq
                        end
                    end
                end
            end
        end

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local c = p.Character
                local tHrp = getHRP(c)
                local tHum = c:FindFirstChildOfClass("Humanoid")
                if tHrp and tHum and tHum.Health > 0 and not c:FindFirstChildOfClass("ForceField") then
                    local offset = tHrp.Position - myPos
                    local dSq = (offset.X * offset.X) + (offset.Y * offset.Y) + (offset.Z * offset.Z)
                    if dSq <= maxRangeSq then
                        if dSq < distA then
                            targetB, distB = targetA, distA
                            targetA, distA = c, dSq
                        elseif dSq < distB then
                            targetB, distB = c, dSq
                        end
                    end
                end
            end
        end

        if not targetA then return end
        State.LastSwap2Time = now

        pcall(function() Remotes.TodoRight:FireServer(targetA) end)
        if not targetB then return end

        task.delay(0.06, function()
            if LocalPlayer.Character == char and isTodo(char) and targetB.Parent then
                pcall(function() Remotes.TodoRight:FireServer(targetB) end)
            end
        end)
    end

    ---------------------------------------------------------------------------
    -- 4. XENON: TODO NETWORK EVENT HOOKS (PERFECT CLAP & M1 SWAP)
    ---------------------------------------------------------------------------
    local function hookTodoNetworkEvents()
        if not Remotes.TodoEffects then resolveRemotes() end
        if not Remotes.TodoEffects then return end

        local swapConn = Remotes.TodoEffects.OnClientEvent:Connect(function(eventName, attacker, target)
            if eventName ~= "Swap" then return end
            local char = LocalPlayer.Character
            if not isTodo(char) then return end

            local isLocalInvolved = (attacker == char or target == char)
            if not isLocalInvolved then return end

            if Settings.AutoPerfectClap and not Settings.TodoM1Swap then
                if Remotes.TodoActivated then
                    pcall(function() Remotes.TodoActivated:FireServer(false) end)
                end
                return
            end

            if Settings.TodoM1Swap then
                local other = (attacker == char and target ~= char and target) 
                    or (target == char and attacker ~= char and attacker) 
                    or nil

                if not (other and other.Parent) then return end

                local now = os.clock()
                if now - State.LastM1SwapTime < 0.35 then return end
                State.LastM1SwapTime = now

                task.spawn(function()
                    local myHrp = getHRP(char)
                    local otherHrp = getHRP(other)
                    if myHrp and otherHrp then
                        local dir = getSideDirection(myHrp, otherHrp)
                        executeSideDash(dir)
                    end

                    local delaySeconds = math.max(0, Settings.TodoM1SwapDelay * 0.001)
                    if delaySeconds > 0 then task.wait(delaySeconds) end

                    if other.Parent and char == LocalPlayer.Character and Remotes.TodoActivated then
                        pcall(function() Remotes.TodoActivated:FireServer(false) end)
                    end
                end)
            end
        end)
        table.insert(State.Connections, swapConn)
    end

    ---------------------------------------------------------------------------
    -- 5. XENON: AUTO R HIT (PEBBLE HIT SWAP)
    ---------------------------------------------------------------------------
    local function hookPebbleHitEvent()
        if not Remotes.PebbleEffects then resolveRemotes() end
        if not Remotes.PebbleEffects then return end

        local pebbleConn = Remotes.PebbleEffects.OnClientEvent:Connect(function(kind, victimChar)
            if not Settings.AutoRHit or kind ~= "Hit" then return end
            if not victimChar or victimChar == LocalPlayer.Character or not isTodo(LocalPlayer.Character) then return end

            task.wait(0.15)
            if Settings.AutoRHit and victimChar.Parent and Remotes.TodoRight then
                pcall(function() Remotes.TodoRight:FireServer(victimChar) end)
            end
        end)
        table.insert(State.Connections, pebbleConn)
    end

    ---------------------------------------------------------------------------
    -- 6. ANIMATION & JUMP SENSING (SLIDE, SWAP & PEBBLE R)
    ---------------------------------------------------------------------------
    local function hookCharacterLifecycle(character)
        if not character then return end
        local hum = character:WaitForChild("Humanoid", 4)
        if not hum then return end
        local animator = hum:WaitForChild("Animator", 4) or hum

        -- Jump Detection for Auto Slide
        local stateConn = hum.StateChanged:Connect(function(oldState, newState)
            if newState == Enum.HumanoidStateType.Jumping then
                handleAutoSlide()
            end
        end)
        table.insert(State.Connections, stateConn)

        -- Animation Play Detection
        local animConn = animator.AnimationPlayed:Connect(function(track)
            local anim = track.Animation
            local animId = anim and tostring(anim.AnimationId) or ""
            local animName = track.Name:lower()

            -- Auto Swap on Specific Animations
            if Settings.AutoSwapEnabled and SwapAnimations[animId] then
                task.spawn(function()
                    repeat task.wait() until track.TimePosition >= 0.55 or not track.IsPlaying
                    if not track.IsPlaying or not Settings.AutoSwapEnabled then return end
                    if Remotes.TodoActivated then
                        pcall(function() Remotes.TodoActivated:FireServer(false) end)
                    end
                end)
            end

            -- Auto R Variant on Pebble Throw
            if Settings.AutoRVariant and (string.find(animName, "pebble", 1, true) or animId == "rbxassetid://99920923658527") then
                task.spawn(function()
                    task.wait(Settings.AutoRVariantDelay)
                    if Settings.AutoRVariant and isTodo(LocalPlayer.Character) and Remotes.TodoRight then
                        pcall(function() Remotes.TodoRight:FireServer(nil) end)
                    end
                end)
            end
        end)
        table.insert(State.Connections, animConn)
    end

    ---------------------------------------------------------------------------
    -- 7. ORIGINAL TODO BRING (SWIFT KICK DISPLACEMENT LOOP)
    ---------------------------------------------------------------------------
    local function executeTodoBring()
        local target = findTargetPlayer(Settings.TargetPlayerName)
        if not target or not target.Character then return end
        local targetRoot = getHRP(target.Character)
        local localChar = LocalPlayer.Character
        local localRoot = getHRP(localChar)

        if not targetRoot or not localRoot then return end

        task.spawn(function()
            local startTime = tick()
            while tick() - startTime < 3 do
                if localRoot and targetRoot and targetRoot.Parent then
                    localRoot.CFrame = targetRoot.CFrame
                end

                pcall(function()
                    local knit = ReplicatedStorage:FindFirstChild("Knit")
                    local services = knit and knit:FindFirstChild("Knit") and knit.Knit:FindFirstChild("Services")
                    local event = services and services:FindFirstChild("SwiftKickService") and services.SwiftKickService.RE.Activated
                    local move = localChar:FindFirstChild("Moveset") and localChar.Moveset:FindFirstChild("Swift Kick")
                    if event and move then
                        event:FireServer(move, nil)
                    end
                end)

                task.wait(0.02)
            end
        end)
    end

    ---------------------------------------------------------------------------
    -- SETUP & LIFECYCLE
    ---------------------------------------------------------------------------
    if LocalPlayer.Character then
        hookCharacterLifecycle(LocalPlayer.Character)
    end

    local charAdded = LocalPlayer.CharacterAdded:Connect(function(char)
        task.wait(0.3)
        resolveRemotes()
        hookCharacterLifecycle(char)
    end)
    table.insert(State.Connections, charAdded)

    task.spawn(hookTodoNetworkEvents)
    task.spawn(hookPebbleHitEvent)

    ---------------------------------------------------------------------------
    -- MULTI-UI FRAMEWORK POPULATION (RAYFIELD / FLUENT / LINORIA)
    ---------------------------------------------------------------------------
    if Tab then
        -- 1. Native Rayfield Interface
        if type(Tab.CreateSection) == "function" then
            Tab:CreateSection("Auto Slide Mechanics")

            Tab:CreateToggle({
                Name = "Auto slide if jump",
                CurrentValue = Settings.AutoSlideIfJump,
                Flag = "AutoSlideIfJumpFlag",
                Callback = function(v) Settings.AutoSlideIfJump = v end
            })

            Tab:CreateSection("Auto BFC (Brute Force Chain)")

            Tab:CreateToggle({
                Name = "Auto BFC (Brute Force 2nd Hit)",
                CurrentValue = Settings.AutoBFC,
                Flag = "AutoBFCFlag",
                Callback = function(v) Settings.AutoBFC = v end
            })

            Tab:CreateSlider({
                Name = "BFC Retrigger Delay",
                Range = {0.1, 1.2},
                Increment = 0.01,
                Suffix = "s",
                CurrentValue = Settings.BFCDelay,
                Flag = "BFCDelayFlag",
                Callback = function(v) Settings.BFCDelay = v end
            })

            Tab:CreateButton({
                Name = "Trigger Brute Force (2nd Hit)",
                Callback = executeBruteForceSecondHit
            })

            Tab:CreateKeybind({
                Name = "Manual BFC Key",
                CurrentKeybind = "None",
                Hold = false,
                Flag = "ManualBFCKeyFlag",
                Callback = executeBruteForceSecondHit
            })

            Tab:CreateSection("Xenon Auto Techs")

            Tab:CreateToggle({
                Name = "Auto Perfect Clap",
                CurrentValue = Settings.AutoPerfectClap,
                Flag = "AutoTodoClapFlag",
                Callback = function(v) Settings.AutoPerfectClap = v end
            })

            Tab:CreateToggle({
                Name = "Dash After Swap (Todo M1 Swap)",
                CurrentValue = Settings.TodoM1Swap,
                Flag = "TodoM1SwapFlag",
                Callback = function(v) Settings.TodoM1Swap = v end
            })

            Tab:CreateSlider({
                Name = "M1 Swap Delay",
                Range = {0, 600},
                Increment = 5,
                Suffix = "ms",
                CurrentValue = Settings.TodoM1SwapDelay,
                Flag = "TodoM1SwapDelayFlag",
                Callback = function(v) Settings.TodoM1SwapDelay = v end
