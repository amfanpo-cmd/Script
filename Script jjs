            })

            LeftBox:AddSlider("TodoM1SwapDelay", {
                Text = "M1 Swap Delay",
                Default = Settings.TodoM1SwapDelay,
                Min = 0,
                Max = 600,
                Rounding = 0,
                Increment = 5,
                Callback = function(v) Settings.TodoM1SwapDelay = v end
            })

            LeftBox:AddToggle("AutoRHit", {
                Text = "Auto R Hit (Pebble Swap)",
                Default = Settings.AutoRHit,
                Callback = function(v) Settings.AutoRHit = v end
            })

            LeftBox:AddToggle("AutoRVariant", {
                Text = "Auto R Variant (Pebble)",
                Default = Settings.AutoRVariant,
                Callback = function(v) Settings.AutoRVariant = v end
            })

            RightBox:AddButton("Swap 2 Nearest", executeSwap2Nearest)
            if RightBox.AddKeypicker then
                RightBox:AddKeypicker("Swap2Key", {
                    Default = "V",
                    Text = "Swap 2 Keybind",
                    Mode = "Hold",
                    Callback = executeSwap2Nearest
                })
