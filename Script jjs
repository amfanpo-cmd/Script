end

local function trim(s)
    if type(s) ~= "string" then return "" end
    return (s:gsub("^%s*(.-)%s*$", "%1"))
end

local function parseAssetId(asset)
    if not asset or asset == "" then return "" end
    local str = tostring(asset)
    if str:find("rbxassetid://") or str:find("http") then
        return str
    end
    local clean = str:gsub("%D", "")
    if clean ~= "" then
        return "rbxassetid://" .. clean
    end
    return str
end

local function safeReadFile(path)
    if isfile then
        local ok, exists = pcall(isfile, path)
        if not ok or not exists then return nil end
    end
    if readfile then
        local ok, result = pcall(readfile, path)
        if ok and result then
            return trim(tostring(result))
        end
    end
    return nil
end

local function safeWriteFile(path, content)
    if writefile then
        pcall(writefile, path, content)
    end
end

local function copyToClipboard(text)
    pcall(function()
        if setclipboard then
            setclipboard(text)
        elseif toclipboard then
            toclipboard(text)
        elseif set_clipboard then
            set_clipboard(text)
        elseif Clipboard and Clipboard.set then
            Clipboard.set(text)
        elseif syn and syn.write_to_clipboard then
            syn.write_to_clipboard(text)
        end
    end)
end

