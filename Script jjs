            local escapeToggle = group:AddToggle("Megumi_TrashEscape", {
                Text = "I CAN'T FIGHT PLEASE I NEED TO ESCAAAAPE!!!",
                Default = false,
                Callback = toggleTrashEscape,
            })

            escapeToggle:AddKeypicker("Megumi_EscapeKeybind", {
                Default = "None",
                SyncToggleState = false,
                Mode = "Toggle",
                Text = "Escape Keybind",
