        bg.Name = "DetroitSmashUpsideDownGyro"
        bg.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
        bg.P = 60000
        bg.D = 60
        bg.Parent = hrp

        local preSimConn
        preSimConn = RunService.PreSimulation:Connect(function()
            if not track.IsPlaying or not hrp.Parent then return end

            local curPos = hrp.Position
            if curPos.Y ~= lockedY then
                hrp.CFrame = CFrame.new(curPos.X, lockedY, curPos.Z) * hrp.CFrame.Rotation
            end

            local vel = hrp.AssemblyLinearVelocity
            if vel.Y > 0 then
                hrp.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
            end
        end)

        local renderConn
        renderConn = RunService.RenderStepped:Connect(function()
            if not Settings.DetroitSmash or not track.IsPlaying or not hrp.Parent then
                if preSimConn then preSimConn:Disconnect() end
                if renderConn then renderConn:Disconnect() end
                if bp and bp.Parent then bp:Destroy() end
                if bg and bg.Parent then bg:Destroy() end
                if hum and hum.Parent then hum.AutoRotate = true end
                return
            end

            local forwardDir = Camera.CFrame.LookVector
            local horizForward = Vector3.new(forwardDir.X, 0, forwardDir.Z)
            if horizForward.Magnitude < 0.01 then
                horizForward = -Vector3.zAxis
            else
                horizForward = horizForward.Unit
            end

            local upVector = -horizForward
            local backVector = Vector3.new(0, -1, 0)
            local rightVector = upVector:Cross(backVector).Unit
            local upsideDownCF = CFrame.fromMatrix(hrp.Position, rightVector, upVector, backVector)

            bg.CFrame = upsideDownCF
            hrp.CFrame = upsideDownCF
        end)

        track.Stopped:Connect(function()
            if preSimConn then preSimConn:Disconnect() end
            if renderConn then renderConn:Disconnect() end
            if bp and bp.Parent then bp:Destroy() end
