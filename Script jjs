    local function parseCommand(sender, message)
        if not Config.Enabled then return end
        if not State.MasterPlayer or sender ~= State.MasterPlayer then return end

        local raw = message:lower():gsub("%s+", "")

        if raw == Config.CmdSummon then
            State.IsVanished = false
        elseif raw == Config.CmdDismiss then
            State.IsVanished = true
        elseif raw == Config.CmdUltimate then
            pressKey(Enum.KeyCode.G)
        elseif raw == Config.CmdAttack then
            -- Rush forward in front of master and barrage
            State.ActiveOffset = OFFSETS.Front
            sendMouseClick(0)
            task.delay(1.2, function()
                State.ActiveOffset = OFFSETS[Config.PositionMode] or OFFSETS.Right
            end)
        else
            for idx, word in ipairs(Config.CmdSkills) do
                if raw == word and not State.IsVanished then
                    State.ActiveOffset = OFFSETS.Front
                    if idx == 1 then pressKey(Enum.KeyCode.One)
                    elseif idx == 2 then pressKey(Enum.KeyCode.Two)
                    elseif idx == 3 then pressKey(Enum.KeyCode.Three)
                    elseif idx == 4 then pressKey(Enum.KeyCode.Four) end

                    task.delay(1.0, function()
                        State.ActiveOffset = OFFSETS[Config.PositionMode] or OFFSETS.Right
                    end)
                    break
                end
            end
        end
    end

    -- Hook Modern TextChatService
    if TextChatService and TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        TextChatService.MessageReceived:Connect(function(msg)
            if not msg.TextSource then return end
            local sender = Players:GetPlayerByUserId(msg.TextSource.UserId)
            if sender then parseCommand(sender, msg.Text) end
        end)
    end

    -- Hook Legacy Chat
    local function hookChat(p)
        p.Chatted:Connect(function(msg)
            parseCommand(p, msg)
        end)
    end

    for _, p in ipairs(Players:GetPlayers()) do hookChat(p) end
    Players.PlayerAdded:Connect(hookChat)

    -- ========================================================================
    -- MAIN RUNTIME LOOP (HEARTBEAT)
    -- ========================================================================
    RunService.Heartbeat:Connect(function(dt)
        if not Config.Enabled then return end

        local char = LocalPlayer.Character
        local hrp = getHRP(char)
        local hum = getHumanoid(char)
        if not (char and hrp and hum and hum.Health > 0) then return end

        -- 1. Anti-Ragdoll Wakeup Check
        local now = os.clock()
        if Config.AutoWakeup and (now - State.LastWakeupTick >= Config.WakeupInterval) then
            State.LastWakeupTick = now
            if isRagdolled(char) then
                executeWakeup()
            end
        end

        -- 2. Resolve Master if unassigned
        if not State.MasterPlayer or not State.MasterPlayer.Parent then
            State.MasterPlayer = resolvePlayer(Config.MasterName)
        end

        local master = State.MasterPlayer
        if master and master.Character then
            local masterHRP = getHRP(master.Character)
            if masterHRP then
                -- Check Low HP Retreat
                if Config.LowHPRetreat and (hum.Health / hum.MaxHealth) <= (Config.LowHPThreshold / 100) then
                    State.IsVanished = true
                end

                -- Compute Goal Position
                local goalCFrame
                if State.IsVanished then
                    -- Safe Vanish: Hover high in the sky (does not hit -500 void floor)
                    local safeHigh = masterHRP.Position + Vector3.new(0, 450, 0)
                    goalCFrame = CFrame.new(safeHigh, safeHigh + masterHRP.CFrame.LookVector)
                else
                    local targetPos = masterHRP.CFrame:PointToWorldSpace(State.ActiveOffset)
                    local threat = getNearestThreat(masterHRP)

                    if threat then
                        -- Face towards the threat in combat
                        goalCFrame = CFrame.lookAt(targetPos, threat.Position)

                        -- Combat Executions
                        if now - State.LastAttackTick >= 0.12 then
                            State.LastAttackTick = now

                            if Config.AutoRightClick then
                                sendMouseClick(1)
                            end

                            if Config.AutoM1Attack then
                                sendMouseClick(0)
                            end

                            if Config.SpamSkillsOnCombat then
                                for _, k in ipairs({Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four}) do
                                    pressKey(k)
                                end
                            end
                        end
                    else
                        -- Idle: Mirror Master's look direction
                        goalCFrame = CFrame.lookAt(targetPos, targetPos + masterHRP.CFrame.LookVector)
                    end
                end

                -- Smooth Delta-Time Interpolation (Zero Rubberbanding)
                local currentPos = hrp.Position
                local targetPos = goalCFrame.Position
                local dist = (targetPos - currentPos).Magnitude

                if dist > 0.05 then
                    local step = math.clamp((Config.FollowSmoothness * dt) / dist, 0, 1)
                    local newPos = currentPos:Lerp(targetPos, step)
                    local newRot = hrp.CFrame:Lerp(goalCFrame, math.clamp(dt * 15, 0.05, 1))
                    hrp.CFrame = CFrame.new(newPos) * (newRot - newRot.Position)
                end

                resetVelocity(hrp)
                return
            end
        end

        resetVelocity(hrp)
    end)

    -- Auto-Rehook across respawns
    LocalPlayer.CharacterAdded:Connect(function(newChar)
        newChar:WaitForChild("HumanoidRootPart", 5)
        local hum = newChar:WaitForChild("Humanoid", 5)
        task.wait(0.5)

        if Config.Enabled and hum then
            hum.PlatformStand = true
            hum.AutoRotate = false
        end
    end)
end
end)

