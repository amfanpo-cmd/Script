    local function HandleEnemyDashForCatch(enemyChar)
        if not Settings.M1Catch then return end
        if isTargetInvalid(enemyChar, false) then return end
        local now = os.clock()
        if (now - lastM1CatchTime) < Settings.CatchDebounce then return end

        local localChar = LocalPlayer.Character
        local myHRP = localChar and (localChar:FindFirstChild("HumanoidRootPart") or localChar:FindFirstChild("Torso"))
        local myHum = localChar and localChar:FindFirstChildOfClass("Humanoid")
        if not myHRP or not myHum or myHum.Health <= 0 then return end

        local eHRP = enemyChar:FindFirstChild("HumanoidRootPart") or enemyChar:FindFirstChild("Torso")
        local eHum = enemyChar:FindFirstChildOfClass("Humanoid")
        if not eHRP or not eHum or eHum.Health <= 0 then return end

        local dist = (eHRP.Position - myHRP.Position).Magnitude
        if dist > Settings.CatchRange then return end

        lastM1CatchTime = now

        if Settings.CatchAutoFace then
            local lookPos = Vector3.new(eHRP.Position.X, myHRP.Position.Y, eHRP.Position.Z)
            myHRP.CFrame = CFrame.lookAt(myHRP.Position, lookPos)
        end

        TriggerM1()
    end

    local function ExecuteUltM1Glide()
        if not Settings.UltM1 or ultM1IsGliding then return end
        if (os.clock() - ultM1LastTime) < 0.2 then return end

        local char = LocalPlayer.Character
        if not char then return end

        local myHRP = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
        local myHum = char and char:FindFirstChildOfClass("Humanoid")
        if not myHRP or not myHum or myHum.Health <= 0 then return end

        local targetModel = GetNearestTarget(Settings.UltM1Range, false)
        if not targetModel or isTargetInvalid(targetModel, false) then return end

        local targetHRP = targetModel:FindFirstChild("HumanoidRootPart") or targetModel:FindFirstChild("Torso")
        if not targetHRP then return end

        ultM1LastTime = os.clock()
        ultM1IsGliding = true

        local startTime = os.clock()
        local renderConn

        renderConn = RunService.RenderStepped:Connect(function(dt)
            local elapsed = os.clock() - startTime

            if elapsed >= Settings.UltM1Duration or isTargetInvalid(targetModel, false) or not char.Parent or not targetHRP.Parent or myHum.Health <= 0 then
                renderConn:Disconnect()
                ultM1IsGliding = false
                return
            end

            local currentPos = myHRP.Position
            local targetPos = Vector3.new(targetHRP.Position.X, currentPos.Y, targetHRP.Position.Z)
            local delta = targetPos - currentPos
            local distance = delta.Magnitude

            if distance > 0.05 then
                local moveStep = math.min(distance, Settings.UltM1Speed * dt)
                local newPos = currentPos + (delta.Unit * moveStep)
                myHRP.CFrame = CFrame.new(newPos) * myHRP.CFrame.Rotation
            end
        end)
    end

    local function ExecuteM1SurfArc(targetChar)
        local localChar = LocalPlayer.Character
        if not localChar then return end
        local myHRP = localChar:FindFirstChild("HumanoidRootPart") or localChar:FindFirstChild("Torso")
