    local function PerformFlank(isManual)
        if flankInProgress then return end

        local localChar = LocalPlayer.Character
        local myHRP = localChar and (localChar:FindFirstChild("HumanoidRootPart") or localChar:FindFirstChild("Torso"))
        local myHum = localChar and localChar:FindFirstChildOfClass("Humanoid")
        if not myHRP or not myHum or myHum.Health <= 0 then return end

        local effectiveRange = Settings.FlankRange
        if Settings.SideDashBehind then
            effectiveRange = math.max(effectiveRange, Settings.BehindRange)
        end

        local targetChar = GetNearestTarget(effectiveRange, false)
        if not targetChar or isTargetInvalid(targetChar, false) then
            if isManual then
                executeFullSideDash(localChar, "Right", Settings.NoDashForce)
            end
            return
        end

        local tHRP = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso")
        local tHum = targetChar:FindFirstChildOfClass("Humanoid")
        if not tHRP or not tHum or tHum.Health <= 0 then return end

        local distToTarget = (tHRP.Position - myHRP.Position).Magnitude

        if Settings.SideDashBehind then
            if distToTarget > Settings.BehindRange then
                if isManual then
                    executeFullSideDash(localChar, "Right", false)
                end
                return
            end
        elseif not isManual and not Settings.AutoFlank and not Settings.LegitFlank then
            return
        end

        flankInProgress = true

        local startPos = myHRP.Position
        local initialTargetCF = tHRP.CFrame
        local initialRightVec = Vector3.new(initialTargetCF.RightVector.X, 0, initialTargetCF.RightVector.Z).Unit
        local sideSign = (startPos - tHRP.Position):Dot(initialRightVec) >= 0 and 1 or -1
        local dashDir = (sideSign < 0) and "Left" or "Right"

        if Settings.LegitFlank then
            executeFullSideDash(localChar, dashDir, false)

            local sideTargetPos = tHRP.Position + (initialRightVec * (sideSign * 4.0))
            local toSide = (sideTargetPos - myHRP.Position)
            local flatToSide = Vector3.new(toSide.X, 0, toSide.Z)
            local moveVector = (flatToSide.Magnitude > 0.1) and flatToSide.Unit or myHRP.CFrame.LookVector

            local torso = localChar:FindFirstChild("Torso") or myHRP
            for _, c in ipairs(torso:GetChildren()) do
                if c.Name == "MovementForce" then pcall(c.Destroy, c) end
            end

            local bv = Instance.new("BodyVelocity")
            bv.Name = "MovementForce"
            bv.MaxForce = Vector3.new(50000, 0, 50000)
            bv.P = 400000
            bv.Velocity = moveVector * 70
            bv.Parent = torso
            Debris:AddItem(bv, 0.25)

            local startL = os.clock()
            local legitConn
            legitConn = RunService.Heartbeat:Connect(function()
                local el = os.clock() - startL
                if el >= 0.25 or isTargetInvalid(targetChar, false) or not myHRP.Parent or not tHRP.Parent or myHum.Health <= 0 then
                    legitConn:Disconnect()
                    ResetVelocity(myHRP)
                    flankInProgress = false
                    if Settings.AutoM1 and not isTargetInvalid(targetChar, false) then
                        task.delay(0.02, TriggerM1)
                    end
                    return
                end

                local enemyPos = tHRP.Position
                myHRP.CFrame = CFrame.lookAt(myHRP.Position, Vector3.new(enemyPos.X, myHRP.Position.Y, enemyPos.Z))
            end)
            return
        end

        myHum.AutoRotate = false
        executeFullSideDash(localChar, dashDir, Settings.NoDashForce)

        local startTime = os.clock()
        local duration = math.clamp(Settings.FlankDuration, 0.12, 0.5)

        local heartbeatConn
        heartbeatConn = RunService.Heartbeat:Connect(function()
            local elapsed = os.clock() - startTime
            local alpha = math.clamp(elapsed / duration, 0, 1)

            if alpha >= 1 or isTargetInvalid(targetChar, false) or not myHRP.Parent or not tHRP.Parent or myHum.Health <= 0 then
                heartbeatConn:Disconnect()
                if myHum and myHum.Parent then myHum.AutoRotate = true end

                if not isTargetInvalid(targetChar, false) and tHRP and tHRP.Parent and myHRP and myHRP.Parent then
                    local tLook = Vector3.new(tHRP.CFrame.LookVector.X, 0, tHRP.CFrame.LookVector.Z).Unit
                    local endPos = tHRP.Position - (tLook * Settings.FlankRadius)
                    if Settings.FlankFace then
                        myHRP.CFrame = CFrame.lookAt(Vector3.new(endPos.X, myHRP.Position.Y, endPos.Z), Vector3.new(tHRP.Position.X, myHRP.Position.Y, tHRP.Position.Z))
                    else
                        myHRP.CFrame = CFrame.new(Vector3.new(endPos.X, myHRP.Position.Y, endPos.Z)) * myHRP.CFrame.Rotation
                    end
                    ResetVelocity(myHRP)
                else
                    ResetVelocity(myHRP)
                end

                flankInProgress = false

                if Settings.AutoM1 and not isTargetInvalid(targetChar, false) then
                    task.delay(0.02, TriggerM1)
                end
                return
            end

            local currentTargetCF = tHRP.CFrame
            local tLook = Vector3.new(currentTargetCF.LookVector.X, 0, currentTargetCF.LookVector.Z).Unit
            local tRight = Vector3.new(currentTargetCF.RightVector.X, 0, currentTargetCF.RightVector.Z).Unit

            local rawEnd = tHRP.Position - (tLook * Settings.FlankRadius)
            local controlAnchor = tHRP.Position + (tRight * (Settings.FlankCurve * sideSign))
            local blended = controlAnchor:Lerp(rawEnd, alpha)

            local t = 1 - (1 - alpha)^2
            local curvePosition = (1 - t)^2 * startPos + 2 * (1 - t) * t * blended + t^2 * rawEnd

            if Settings.FlankFace then
                myHRP.CFrame = CFrame.lookAt(curvePosition, Vector3.new(tHRP.Position.X, curvePosition.Y, tHRP.Position.Z))
            else
                myHRP.CFrame = CFrame.new(curvePosition) * myHRP.CFrame.Rotation
            end

            ResetVelocity(myHRP)
        end)
    end

    local DRAG_THRESHOLD = 8

    local function makeControlledDraggable(btn, onClick)
        local activeInput = nil
        local isDragging = false
        local dragStart = Vector3.zero
        local startPos = UDim2.new()
        local moveConn, endConn, cancelConn

        local function cleanup()
            activeInput = nil
            isDragging = false
            if moveConn then moveConn:Disconnect(); moveConn = nil end
            if endConn then endConn:Disconnect(); endConn = nil end
            if cancelConn then cancelConn:Disconnect(); cancelConn = nil end
        end

        btn.InputBegan:Connect(function(input)
            if activeInput ~= nil then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                activeInput = input
                isDragging = false
                dragStart = input.Position
                startPos = btn.Position

                cleanup()
                activeInput = input

                moveConn = UserInputService.InputChanged:Connect(function(moveInput)
                    if moveInput == activeInput then
                        local delta = moveInput.Position - dragStart
                        if not isDragging and delta.Magnitude >= DRAG_THRESHOLD then
                            isDragging = true
                        end

                        if isDragging then
                            local camera = workspace.CurrentCamera
                            local vp = camera and camera.ViewportSize or Vector2.new(1920, 1080)
                            local bSize = btn.AbsoluteSize

                            local targetX = math.clamp(startPos.X.Offset + delta.X, 0, math.max(0, vp.X - bSize.X))
                            local targetY = math.clamp(startPos.Y.Offset + delta.Y, 0, math.max(0, vp.Y - bSize.Y))
                            btn.Position = UDim2.new(startPos.X.Scale, targetX, startPos.Y.Scale, targetY)
                        end
                    end
                end)

                local function handleRelease(endedInput)
                    if endedInput == activeInput then
                        local wasDragging = isDragging
                        cleanup()

                        if not wasDragging and onClick then
                            onClick()
                        end
                    end
                end

                endConn = UserInputService.InputEnded:Connect(handleRelease)
                cancelConn = UserInputService.InputCancelled:Connect(handleRelease)
            end
        end)
    end

