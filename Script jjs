                Callback = function(Value)
                    AutoBlock.Settings.DetectionRange = Value
                end,
            })

            AutoBlockTab:CreateToggle({
                Name = "Facing Check",
                CurrentValue = false,
                Flag = "AutoBlock_FacingCheck",
                Callback = function(Value)
                    AutoBlock.Settings.FacingCheckEnabled = Value
                end,
            })

            AutoBlockTab:CreateSlider({
                Name = "Facing Angle",
                Range = {0, 1},
                Increment = 0.05,
                CurrentValue = 0.7,
                Flag = "AutoBlock_FacingThreshold",
                Callback = function(Value)
                    AutoBlock.Settings.FacingAngleThreshold = Value
                end,
            })

            AutoBlockTab:CreateSection("Projectile")

            AutoBlockTab:CreateToggle({
