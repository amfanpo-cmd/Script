    local function hasSwordEquipped()
        local char = LocalPlayer.Character
        if not char then return false end

        if char:GetAttribute("Sword") ~= nil and char:GetAttribute("Sword") ~= false then
            return true
        end
        if char:GetAttribute("sword") ~= nil and char:GetAttribute("sword") ~= false then
            return true
        end

        local charsFolder = Workspace:FindFirstChild("Characters")
        local myCharInFolder = charsFolder and charsFolder:FindFirstChild(LocalPlayer.Name)
        if myCharInFolder then
            if myCharInFolder:GetAttribute("Sword") ~= nil and myCharInFolder:GetAttribute("Sword") ~= false then
                return true
            end
            if myCharInFolder:GetAttribute("sword") ~= nil and myCharInFolder:GetAttribute("sword") ~= false then
                return true
            end
        end

        return false
