        local hl = model:FindFirstChild("Dummy_ESP_Highlight")
        if hl then hl:Destroy() end
    end

    local function clearAllDummyEsp()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") then
                removeDummyEsp(obj)
            end
        end
    end

    local function applyDummyEsp(model)
        if not dummyEspActive or not isNPC(model) then return end

        removeDummyEsp(model)

        local hl = Instance.new("Highlight")
        hl.Name = "Dummy_ESP_Highlight"
        hl.Adornee = model
        hl.FillColor = COLOR_WHITE
        hl.OutlineColor = Color3.fromRGB(180, 180, 180)
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.Parent = model

        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum then
            local npcDiedConn
            npcDiedConn = hum.Died:Connect(function()
                removeDummyEsp(model)
                if npcDiedConn then npcDiedConn:Disconnect() end
            end)
            table.insert(dummyConnections, npcDiedConn)
        end
    end

    local function enableDummyEsp()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and isNPC(obj) then
                applyDummyEsp(obj)
            end
        end

        local descAdded = Workspace.DescendantAdded:Connect(function(desc)
            if dummyEspActive and desc:IsA("Model") then
                task.wait(0.05)
                if isNPC(desc) then
                    applyDummyEsp(desc)
                end
            end
        end)
        table.insert(dummyConnections, descAdded)
    end

    if VisualsTab then
        VisualsTab:CreateSection("Freecam")

        VisualsTab:CreateToggle({
            Name = "Freecam",
            CurrentValue = false,
            Flag = "FreecamFlag",
            Callback = function(Value)
                setFreecamActive(Value)
            end
        })

        VisualsTab:CreateSlider({
            Name = "Speed",
            Range = {0.5, 20.0},
            Increment = 0.5,
            Suffix = "x",
            CurrentValue = 3.0,
            Flag = "FreecamSpeedFlag",
            Callback = function(Value)
                targetSpeed = Value
                if speedLabel then speedLabel.Text = string.format("%.1fx", targetSpeed) end
            end
        })

        VisualsTab:CreateSlider({
            Name = "Smoothness",
            Range = {0.05, 1.0},
            Increment = 0.01,
            Suffix = " lerp",
            CurrentValue = 0.22,
            Flag = "FreecamSmoothnessFlag",
            Callback = function(Value)
                freecamSmoothness = Value
            end
        })

        VisualsTab:CreateSlider({
            Name = "FOV",
            Range = {15, 120},
            Increment = 1,
            Suffix = "Â°",
            CurrentValue = 70,
            Flag = "FreecamFOVFlag",
            Callback = function(Value)
                targetFOV = Value
            end
        })

        VisualsTab:CreateButton({
            Name = "Teleport to Cam",
            Callback = function()
                local char = LocalPlayer.Character
                local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
                if root and Camera then
                    root.CFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + Camera.CFrame.LookVector)
                end
            end
        })

        VisualsTab:CreateSection("Debris Cleaner")

        VisualsTab:CreateButton({
            Name = "Clear Debris",
            Callback = function()
                executeNoDebris()
            end
        })

        VisualsTab:CreateToggle({
            Name = "Auto Clear Debris",
            CurrentValue = false,
            Flag = "AutoClearDebrisFlag",
            Callback = function(Value)
                noDebrisLoop = Value
                if Value then
                    task.spawn(function()
                        while noDebrisLoop do
                            executeNoDebris()
                            task.wait(3.0)
                        end
                    end)
                end
            end
        })

        VisualsTab:CreateSection("ESP")

        VisualsTab:CreateToggle({
            Name = "Player ESP",
            CurrentValue = false,
            Flag = "PlayerESPFlag",
            Callback = function(Value)
                hpEspActive = Value
                if hpEspActive then
                    enableHPEsp()
                else
                    disconnectTable(hpConnections)
                    clearAllHPEsp()
                end
            end
        })

        VisualsTab:CreateToggle({
            Name = "Dummy ESP",
            CurrentValue = false,
            Flag = "DummyESPFlag",
            Callback = function(Value)
                dummyEspActive = Value
                if dummyEspActive then
                    enableDummyEsp()
                else
                    disconnectTable(dummyConnections)
                    clearAllDummyEsp()
                end
            end
        })

        VisualsTab:CreateSection("Performance")

        VisualsTab:CreateToggle({
            Name = "FPS Boost",
            CurrentValue = false,
            Flag = "FPSBoostFlag",
            Callback = function(Value)
                fpsBoostActive = Value

                if fpsBoostActive then
                    applyFullBoost()

                    local descAdded = Workspace.DescendantAdded:Connect(function(desc)
                        if fpsBoostActive then
                            task.defer(function()
                                if desc and desc.Parent then
                                    optimizeObject(desc)
                                end
                            end)
                        end
                    end)
                    table.insert(boostConnections, descAdded)

                    task.spawn(function()
                        while fpsBoostActive do
                            for _, v in ipairs(Workspace:GetChildren()) do
                                local lower = string.lower(v.Name)
                                if lower == "debris" or lower == "rubble" then
                                    pcall(function() v:Destroy() end)
                                end
                            end
                            task.wait(1)
                        end
                    end)
                else
                    disconnectTable(boostConnections)
                end
            end
        })
    end
end
end)

