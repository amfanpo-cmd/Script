    local function getOneWayPing()
        if not Settings.PingCompensation then return 0 end
        local success, pingMs = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        if success and pingMs and pingMs > 0 then
            return (pingMs / 1000) * 0.5
        end
        return 0.03
    end

    local function triggerSkyDistortion()
        local now = os.clock()
        if (now - State.LastCounterTime) < COOLDOWN_DEBOUNCE then return end

        local char = LocalPlayer.Character
        if not char then return end

        local moveset = char:FindFirstChild("Moveset")
        local skillObj = moveset and moveset:FindFirstChild("Sky Distortion")
        if not skillObj then return end

        State.LastCounterTime = now

        task.spawn(function()
            pcall(function()
                local knit = ReplicatedStorage:WaitForChild("Knit", 2)
                local services = knit and knit:WaitForChild("Knit", 2):WaitForChild("Services", 2)
                local skyService = services and services:FindFirstChild("SkyDistortionService")
                local activatedRE = skyService and skyService:FindFirstChild("RE") and skyService.RE:FindFirstChild("Activated")

                if activatedRE and activatedRE:IsA("RemoteEvent") then
                    activatedRE:FireServer(skillObj, nil)
                end
            end)
        end)
    end

    local function matchProjectileProfile(name)
        local clean = string.lower(name):gsub("%s+", ""):gsub("[^%a%d]", "")
        for key, data in pairs(PROJECTILE_DEFINITIONS) do
            if string.find(clean, key, 1, true) then
                return data, key
            end
        end
        return nil
    end

    local function getRootPart(instance)
        if instance:IsA("BasePart") then
            return instance
        elseif instance:IsA("Model") then
            if instance.PrimaryPart then return instance.PrimaryPart end
            return instance:FindFirstChildWhichIsA("BasePart")
        end
        return nil
    end

    local function registerProjectile(instance)
        if not instance or not instance.Parent then return end

        local profile, matchedKey = matchProjectileProfile(instance.Name)
        if not profile and instance.Parent and instance.Parent:IsA("Model") then
            profile, matchedKey = matchProjectileProfile(instance.Parent.Name)
        end

        if profile then
            local root = getRootPart(instance)
            if root and not State.TrackedProjectiles[root] then
                State.TrackedProjectiles[root] = {
                    profile = profile,
                    name = matchedKey,
                    lastPos = root.Position,
                    lastTime = os.clock()
                }
            end
        end
    end

    local function processProjectileTrajectories()
        if not Settings.AutoSkyDistortion then return end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        local myPos = hrp.Position
        local now = os.clock()
        local pingDelay = getOneWayPing()

        for part, data in pairs(State.TrackedProjectiles) do
            if not part:IsDescendantOf(Workspace) then
                State.TrackedProjectiles[part] = nil
            else
                local curPos = part.Position
                local vel = part.AssemblyLinearVelocity

                if vel.Magnitude < 10 then
                    local dt = math.max(0.001, now - data.lastTime)
                    vel = (curPos - data.lastPos) / dt
                end

                data.lastPos = curPos
                data.lastTime = now

                local speed = vel.Magnitude
                local toPlayer = myPos - curPos
                local distance = toPlayer.Magnitude

                if distance <= Settings.MaxDetectionRange and speed > 15 then
                    local projDir = vel.Unit
                    local targetDir = toPlayer.Unit
                    local alignment = projDir:Dot(targetDir)

                    if alignment >= 0.70 then
                        local projScalar = toPlayer:Dot(projDir)
                        local closestPointOnRay = curPos + (projDir * projScalar)
                        local missDistance = (myPos - closestPointOnRay).Magnitude

                        if missDistance <= Settings.HitboxRadius then
                            local earlyHitStuds = data.profile.earlyHitStuds or 6
                            if speed >= 190 then
                                earlyHitStuds = 12
                            elseif speed >= 130 then
                                earlyHitStuds = math.clamp(earlyHitStuds, 8, 12)
                            end

                            local effectiveDistance = math.max(0, distance - earlyHitStuds)
                            local timeToImpact = effectiveDistance / speed
                            local targetTriggerTime = Settings.BaseWindupTime + pingDelay

                            if timeToImpact <= targetTriggerTime and timeToImpact >= (targetTriggerTime - Settings.ActiveWindowDuration) then
                                triggerSkyDistortion()
                                State.TrackedProjectiles[part] = nil
                            end
                        end
                    end
                end
            end
        end
    end

