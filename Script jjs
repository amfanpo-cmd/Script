        -- 3. Projectile Tech (Upward Lock & Glide)
        UPWARD_GLIDE = {
            WAIT_DELAY       = 0.18,
            MAX_RANGE        = 25,
            LOCK_DURATION    = 0.22,
            GLIDE_SPEED      = 130,
            PITCH_ANGLE      = 90,
        },
        -- 4. Speedblitz R Anim ID
        SPEEDBLITZ_ANIM = {
            TARGET_ANIM_ID   = "118607369830566",
            TARGET_TIMESTAMP = 2.1,
        },
        -- 5. Super Lock-On (Shift Lock Override Bypass)
        SUPER_LOCK = {
            TARGET_ANIM_ID   = "86045680364061",
            MAX_DISTANCE     = 500,
            BIND_NAME        = "SuperShiftLockBypassLock",
        }
    }

    ---------------------------------------------------------------------------
    -- TOGGLE & STATE VARIABLES
    ---------------------------------------------------------------------------
    local firstMoveTechEnabled = false
    local speedblitzREnabled   = false
    local bleedoutTechEnabled  = false
    local superLockEnabled     = false

    local isTurning     = false
    local isLocking     = false
    local isSuperLocked = false

    local stopSuperConnection = nil
    local currentSuperGyro    = nil
    local connections         = {}

    local function registerConnection(conn)
        table.insert(connections, conn)
        return conn
    end

    local function resetVelocity(hrp)
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end

    ---------------------------------------------------------------------------
    -- OPTIMIZED NEAREST TARGET SCANNER
    ---------------------------------------------------------------------------
    local function getNearestTarget(myHRP, maxRange)
        local myPos = myHRP.Position
        local shortestDistSq = maxRange * maxRange
        local nearestHRP = nil

        local function evaluateModel(model)
            if not model or not model:IsA("Model") then return end
            if LocalPlayer.Character and model == LocalPlayer.Character then return end

            local hum = model:FindFirstChildOfClass("Humanoid")
            local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")

            if hum and hrp and hum.Health > 0 and not model:FindFirstChildOfClass("ForceField") then
                local delta = hrp.Position - myPos
                local distSq = (delta.X * delta.X) + (delta.Y * delta.Y) + (delta.Z * delta.Z)

                if distSq <= shortestDistSq then
                    shortestDistSq = distSq
                    nearestHRP = hrp
                end
            end
        end

        local charFolder = Workspace:FindFirstChild("Characters") or Workspace
        for _, obj in ipairs(charFolder:GetChildren()) do
            evaluateModel(obj)
        end

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                evaluateModel(player.Character)
            end
        end

        return nearestHRP
    end

    ---------------------------------------------------------------------------
    -- SUPER LOCK-ON (SHIFTLOCK BYPASS ENGINE)
    ---------------------------------------------------------------------------
    local function unlockSuperTarget(humanoid)
        isSuperLocked = false

        pcall(function()
            RunService:UnbindFromRenderStep(CONFIG.SUPER_LOCK.BIND_NAME)
        end)

        if stopSuperConnection then
            stopSuperConnection:Disconnect()
            stopSuperConnection = nil
        end

        if currentSuperGyro then
            pcall(function() currentSuperGyro:Destroy() end)
            currentSuperGyro = nil
        end

        if humanoid and humanoid.Parent then
            humanoid.AutoRotate = true
        end
    end

    local function lockOntoSuperTarget(character, track)
        if not superLockEnabled then return end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local hrp = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
        if not humanoid or not hrp then return end

        local targetHRP = getNearestTarget(hrp, CONFIG.SUPER_LOCK.MAX_DISTANCE)
        if not targetHRP then return end

        unlockSuperTarget(humanoid)
        isSuperLocked = true

        -- Damped gyro to eliminate jitter
        local gyro = Instance.new("BodyGyro")
        gyro.Name = "SuperLockGyro"
        gyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        gyro.P = 50000
        gyro.D = 100
        gyro.Parent = hrp
        currentSuperGyro = gyro

        stopSuperConnection = track.Stopped:Connect(function()
            unlockSuperTarget(humanoid)
        end)
        registerConnection(stopSuperConnection)

        -- Binds after Camera & Shiftlock pipeline to guarantee orientation override
        RunService:BindToRenderStep(
            CONFIG.SUPER_LOCK.BIND_NAME,
            Enum.RenderPriority.Camera.Value + 100,
            function()
                if not track.IsPlaying or not isSuperLocked or not superLockEnabled or not hrp.Parent then
                    unlockSuperTarget(humanoid)
                    return
                end

                humanoid.AutoRotate = false

                if not targetHRP or not targetHRP.Parent then
                    targetHRP = getNearestTarget(hrp, CONFIG.SUPER_LOCK.MAX_DISTANCE)
                    if not targetHRP then
                        unlockSuperTarget(humanoid)
                        return
                    end
                end

                local targetPos = Vector3.new(targetHRP.Position.X, hrp.Position.Y, targetHRP.Position.Z)
                local dir = (targetPos - hrp.Position)
                if dir.Magnitude > 0.05 then
                    local targetCFrame = CFrame.lookAt(hrp.Position, targetPos)
                    gyro.CFrame = targetCFrame
                    hrp.CFrame = targetCFrame
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end
        )
    end

    ---------------------------------------------------------------------------
    -- TECH EXECUTIONS
    ---------------------------------------------------------------------------

    -- 1. SPEEDBLITZ R: TELEPORT BEHIND
    local function executeTeleportBehind()
        if not speedblitzREnabled then return end

        local char = LocalPlayer.Character
        local myHRP = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        if not myHRP then return end

        local targetHRP = getNearestTarget(myHRP, CONFIG.TP_BEHIND.MAX_RANGE)
        if not targetHRP then return end

        -- Calculate flat look vector so target height tilt doesn't pitch you
        local tLook = Vector3.new(targetHRP.CFrame.LookVector.X, 0, targetHRP.CFrame.LookVector.Z)
        tLook = (tLook.Magnitude > 0.01) and tLook.Unit or -Vector3.zAxis

        local behindPos = targetHRP.Position - (tLook * CONFIG.TP_BEHIND.DISTANCE_BEHIND)
        local behindCFrame = CFrame.lookAt(behindPos, Vector3.new(targetHRP.Position.X, behindPos.Y, targetHRP.Position.Z))

        resetVelocity(myHRP)
        myHRP.CFrame = behindCFrame
        resetVelocity(myHRP)
    end

    -- 2. BLEEDOUT TECH: 180Â° TURN (SHIFTLOCK OVERRIDE)
    local function execute180Turn()
        if not bleedoutTechEnabled or isTurning then return end

        local char = LocalPlayer.Character
        local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        isTurning = true

        local oldAutoRotate = hum.AutoRotate
        hum.AutoRotate = false

        local currentCF = hrp.CFrame
        local targetCFrame = currentCF * CFrame.Angles(0, math.rad(CONFIG.TURN_180.TURN_ANGLE), 0)

        resetVelocity(hrp)

        local startTime = os.clock()
        RunService:BindToRenderStep(
            CONFIG.TURN_180.BIND_NAME,
            Enum.RenderPriority.Camera.Value + 100,
            function()
                local elapsed = os.clock() - startTime

                if elapsed >= CONFIG.TURN_180.LOCK_DURATION or not hrp.Parent then
                    pcall(function() RunService:UnbindFromRenderStep(CONFIG.TURN_180.BIND_NAME) end)
                    if hum and hum.Parent then
                        hum.AutoRotate = oldAutoRotate
                    end
                    resetVelocity(hrp)
                    isTurning = false
                    return
                end

                hrp.CFrame = CFrame.new(hrp.Position) * targetCFrame.Rotation
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        )
    end

    -- 3. PROJECTILE TECH: UPWARD LOCK & GLIDE
    local function triggerLockAndGlide()
        if not firstMoveTechEnabled or isLocking then return end

        local char = LocalPlayer.Character
        local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        local targetHRP = getNearestTarget(hrp, CONFIG.UPWARD_GLIDE.MAX_RANGE)
        if not targetHRP then return end

        isLocking = true

        local oldAutoRotate = hum.AutoRotate
        hum.AutoRotate = false

        local startTime = os.clock()
        local renderConn

        renderConn = RunService.PreSimulation:Connect(function(dt)
            local elapsed = os.clock() - startTime

            if elapsed >= CONFIG.UPWARD_GLIDE.LOCK_DURATION or not char.Parent or hum.Health <= 0 then
                renderConn:Disconnect()
                if hum and hum.Parent then
                    hum.AutoRotate = oldAutoRotate
                end
                resetVelocity(hrp)
                isLocking = false
                return
            end

            local currentPos = hrp.Position
            local targetPos = targetHRP.Position
            local flatDir = Vector3.new(targetPos.X - currentPos.X, 0, targetPos.Z - currentPos.Z)
            local moveDir = (flatDir.Magnitude > 0.05) and flatDir.Unit or hrp.CFrame.LookVector

            local nextPos = currentPos + (moveDir * CONFIG.UPWARD_GLIDE.GLIDE_SPEED * dt)

            -- Gimbal-lock safe pitch up 90Â° orientation
            local baseFacing = CFrame.lookAt(nextPos, nextPos + moveDir)
            local targetRotation = baseFacing * CFrame.Angles(math.rad(CONFIG.UPWARD_GLIDE.PITCH_ANGLE), 0, 0)

            hrp.CFrame = targetRotation

            -- Clamp falling gravity so the glide stays level
            local currentVel = hrp.AssemblyLinearVelocity
            hrp.AssemblyLinearVelocity = Vector3.new(moveDir.X * CONFIG.UPWARD_GLIDE.GLIDE_SPEED, math.max(0, currentVel.Y), moveDir.Z * CONFIG.UPWARD_GLIDE.GLIDE_SPEED)
        end)

        registerConnection(renderConn)
    end

    ---------------------------------------------------------------------------
    -- REMOTE SENSING METATABLE HOOK
    ---------------------------------------------------------------------------
    if not _G.LarpNaoyaHooked then
        _G.LarpNaoyaHooked = true
        local gmt = getrawmetatable and getrawmetatable(game)
        if gmt then
            local setreadonly = setreadonly or make_writeable or function() end
            local getnamecallmethod = getnamecallmethod or get_namecall_method

            setreadonly(gmt, false)
            local oldNamecall = gmt.__namecall

            gmt.__namecall = newcclosure(function(self, ...)
                local method = getnamecallmethod and getnamecallmethod() or ""

                if not checkcaller() and method == "FireServer" then
                    -- Intercept AntiCheat Teleport trigger
                    if self and self.Name == "Teleport" then
                        local parent = self.Parent
                        if parent and parent.Name == "RE" and parent.Parent and parent.Parent.Name == "AntiCheatService" then
                            task.spawn(function()
                                task.wait(CONFIG.UPWARD_GLIDE.WAIT_DELAY)
                                triggerLockAndGlide()
                            end)
                        end
                    end
                end

                return oldNamecall(self, ...)
            end)
            setreadonly(gmt, true)
        end
    end

    ---------------------------------------------------------------------------
    -- ANIMATION SENSING ENGINE
    ---------------------------------------------------------------------------
    local function setupAnimator(animator)
        local function checkTrack(track)
            local anim = track.Animation
            local animId = anim and tostring(anim.AnimationId) or ""

            -- Super Lock-On Match (Shift Lock Bypass)
            if string.find(animId, CONFIG.SUPER_LOCK.TARGET_ANIM_ID, 1, true) then
                if superLockEnabled and LocalPlayer.Character then
                    lockOntoSuperTarget(LocalPlayer.Character, track)
                end
            end

            -- Speedblitz R Match -> TP Behind
            if string.find(animId, CONFIG.SPEEDBLITZ_ANIM.TARGET_ANIM_ID, 1, true) then
                local triggered = false
                local stepConn

                stepConn = RunService.Heartbeat:Connect(function()
                    if not track.IsPlaying then
                        stepConn:Disconnect()
                        return
                    end

                    if track.TimePosition >= CONFIG.SPEEDBLITZ_ANIM.TARGET_TIMESTAMP and not triggered then
                        triggered = true
                        stepConn:Disconnect()
                        executeTeleportBehind()
                    end
                end)
                registerConnection(stepConn)
            end

            -- Bleedout Tech Match -> 180 Turn
            if string.find(animId, CONFIG.TURN_180.TARGET_ANIM_ID, 1, true) then
                local triggered = false
                local stepConn

                stepConn = RunService.Heartbeat:Connect(function()
                    if not track.IsPlaying then
                        stepConn:Disconnect()
                        return
                    end

                    if track.TimePosition >= CONFIG.TURN_180.TARGET_TIMESTAMP and not triggered then
                        triggered = true
                        stepConn:Disconnect()
                        execute180Turn()
                    end
                end)
                registerConnection(stepConn)
            end
        end

        registerConnection(animator.AnimationPlayed:Connect(checkTrack))

        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            checkTrack(track)
        end
    end

    local function onCharacterAdded(char)
        local hum = char:WaitForChild("Humanoid", 10)
        if hum then
            local animator = hum:WaitForChild("Animator", 10) or hum
            setupAnimator(animator)
        end
    end

    if LocalPlayer.Character then
        onCharacterAdded(LocalPlayer.Character)
    end

    registerConnection(LocalPlayer.CharacterAdded:Connect(onCharacterAdded))

    ---------------------------------------------------------------------------
