    end

    -- Create Button UI Element
    if type(Tab.CreateButton) == "function" then
        Tab:CreateButton({
            Name = "Trigger Ichigo",
            Callback = TriggerIchigo
        })
    elseif type(Tab.AddButton) == "function" then
        Tab:AddButton("Trigger Ichigo", {
            Text = "Trigger Ichigo",
            Callback = TriggerIchigo
        })
    end
end

