                        if Fallback then pcall(Fallback, Tab) end
                    end
                elseif type(Source) == "string" and Source ~= "" and Source ~= "URL_HERE" then
                    local urls = string.split(Source, ",")
                    local anySucceeded = false

                    for _, url in ipairs(urls) do
                        local cleanUrl = trim(url)
                        if cleanUrl ~= "" then
                            local getOk, rawCode = pcall(function() return game:HttpGet(cleanUrl) end)
                            if getOk and rawCode and rawCode ~= "" then
                                local compiled, syntaxErr = loadstring(rawCode)
                                if compiled then
                                    local execOk, moduleRet = pcall(compiled)
                                    if execOk then
                                        if type(moduleRet) == "function" then
                                            local runOk, runErr = pcall(moduleRet, Tab)
                                            if runOk then anySucceeded = true else warn("[Rayfield] Tab callback error: " .. tostring(runErr)) end
                                        elseif type(moduleRet) == "table" then
                                            if type(moduleRet.Init) == "function" then
                                                local runOk = pcall(moduleRet.Init, Tab)
                                                if runOk then anySucceeded = true end
                                            elseif getmetatable(moduleRet) and getmetatable(moduleRet).__call then
                                                local runOk = pcall(moduleRet, Tab)
                                                if runOk then anySucceeded = true end
                                            end
                                        else
                                            anySucceeded = true
                                        end
                                    else
                                        warn("[Rayfield] Runtime error (" .. cleanUrl .. "): " .. tostring(moduleRet))
                                    end
                                else
                                    warn("[Rayfield] Syntax error (" .. cleanUrl .. "): " .. tostring(syntaxErr))
                                end
                            else
                                warn("[Rayfield] Download failed (" .. cleanUrl .. ")")
                            end
                        end
                    end

                    if not anySucceeded and Fallback then
                        pcall(Fallback, Tab)
                    end
                elseif Fallback then
