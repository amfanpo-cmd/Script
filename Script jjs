    ----------------------------------------------------------------------------
    local function getClosestEnemy(maxDistance)
        local myChar = LocalPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return nil end

        local closestChar = nil
        local shortestDist = maxDistance or 25

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local targetHRP = player.Character:FindFirstChild("HumanoidRootPart")
                local targetHum = player.Character:FindFirstChildOfClass("Humanoid")

                if targetHRP and targetHum and targetHum.Health > 0 then
                    local distance = (targetHRP.Position - myHRP.Position).Magnitude
                    if distance < shortestDist then
                        shortestDist = distance
                        closestChar = player.Character
                    end
                end
            end
        end

        return closestChar
    end

    local function unfreezeBoth()
        state.isFrozen = false
        state.savedElevation = nil

        if state.activeAnimTrack then
            pcall(function()
                state.activeAnimTrack:AdjustSpeed(1)
            end)
            state.activeAnimTrack = nil
        end

        local myChar = LocalPlayer.Character
        if myChar then
            local myHRP = myChar:FindFirstChild("HumanoidRootPart")
            if myHRP then
                myHRP.Anchored = false
            end
        end

        if state.frozenTargetChar then
            local targetHRP = state.frozenTargetChar:FindFirstChild("HumanoidRootPart")
            if targetHRP then
