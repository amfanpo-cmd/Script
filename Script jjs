    -- OPTIMIZED NEAREST TARGET SCANNER
    ---------------------------------------------------------------------------
    local function getNearestTarget(maxRange)
        maxRange = maxRange or 200
        local char = LocalPlayer.Character
        if not char then return nil end

        local myHRP = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
        if not myHRP then return nil end

        local nearestModel = nil
        local shortestDistance = maxRange

        local charsFolder = workspace:FindFirstChild("Characters")
        local searchTargets = charsFolder and charsFolder:GetChildren() or workspace:GetChildren()

        for _, obj in ipairs(searchTargets) do
            if obj:IsA("Model") and obj ~= char then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj.PrimaryPart

                if hum and hrp and hum.Health > 0 and not obj:FindFirstChildOfClass("ForceField") then
                    local dist = (hrp.Position - myHRP.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        nearestModel = obj
                    end
                end
            end
        end

        if not nearestModel then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local pChar = player.Character
                    local hum = pChar:FindFirstChildOfClass("Humanoid")
                    local hrp = pChar:FindFirstChild("HumanoidRootPart") or pChar:FindFirstChild("Torso")

                    if hum and hrp and hum.Health > 0 then
                        local dist = (hrp.Position - myHRP.Position).Magnitude
                        if dist < shortestDistance then
                            shortestDistance = dist
                            nearestModel = pChar
                        end
                    end
                end
            end
        end

        return nearestModel
    end

    ---------------------------------------------------------------------------
    -- FEATURE 1: NUE! USE BS AIM!
    ---------------------------------------------------------------------------
    local function executeNueBsAim()
        local targetChar = getNearestTarget(250)
        if not targetChar then return end

        pcall(function()
            local char = LocalPlayer.Character
            local move = nil

            if char then
                local moveset = char:FindFirstChild("Moveset") or LocalPlayer:FindFirstChild("Moveset")
                if moveset then
                    move = moveset:FindFirstChild("Nue")
                end
                if not move then
                    move = char:FindFirstChild("Nue") or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Nue"))
                end
            end

            local nueRemote = ReplicatedStorage.Knit.Knit.Services.NueService.RE.Activated
            if nueRemote then
                nueRemote:FireServer(move, targetChar)
            end
        end)
    end

    ---------------------------------------------------------------------------
    -- FEATURE 2: NUE! 180 DEGREES TECH!
    ---------------------------------------------------------------------------
    local function executeNue180Tech()
        executeNueBsAim()

        local startTime = os.clock()
        local renderConnection

        renderConnection = RunService.RenderStepped:Connect(function()
            if (os.clock() - startTime) >= 1.0 then
                if renderConnection then renderConnection:Disconnect() end
                return
            end

            local currentCF = Camera.CFrame
            Camera.CFrame = CFrame.new(currentCF.Position, currentCF.Position - currentCF.LookVector)
        end)
    end

    ---------------------------------------------------------------------------
    -- FEATURE 3: REWORKED ESCAPE SEQUENCE (1s -> Remote1 -> 0.3s -> Remote2 -> 7s CD)
    ---------------------------------------------------------------------------
    local function executeTrashEscape()
        if isEscaping then return end
        isEscaping = true

        escapeBtn.ImageTransparency = 0.6

        task.spawn(function()
