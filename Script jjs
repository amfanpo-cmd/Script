    end

    local function toggleTrashEscape(state)
        trashEscapeEnabled = state
        escapeBtn.Visible = state
    end

    ---------------------------------------------------------------------------
    -- MULTI-UI FRAMEWORK POPULATION (RAYFIELD, FLUENT, LINORIA)
    ---------------------------------------------------------------------------
    if MegumiTab then
        local isRayfield = type(MegumiTab) == "table" and (MegumiTab.CreateToggle ~= nil or MegumiTab.CreateButton ~= nil)
        local isFluent   = type(MegumiTab) == "table" and MegumiTab.AddToggle ~= nil
        local isLinoria  = type(MegumiTab) == "table" and MegumiTab.AddLeftGroupbox ~= nil

        if isRayfield then
            if MegumiTab.CreateSection then
                MegumiTab:CreateSection("Ten Shadows / Megumi Engine")
            end

            MegumiTab:CreateToggle({
                Name = "NUE! USE BS AIM!",
                CurrentValue = false,
                Flag = "Megumi_NueBsAim",
                Callback = toggleNueBsAim,
            })

            MegumiTab:CreateToggle({
                Name = "NUE! 180 DEGREES TECH!",
                CurrentValue = false,
                Flag = "Megumi_Nue180",
                Callback = toggleNue180Tech,
            })

            MegumiTab:CreateToggle({
                Name = "I CAN'T FIGHT PLEASE I NEED TO ESCAAAAPE!!!",
                CurrentValue = false,
                Flag = "Megumi_TrashEscape",
                Callback = toggleTrashEscape,
            })

            MegumiTab:CreateKeybind({
                Name = "Escape PC Keybind (Optional)",
                CurrentKeybind = "None",
                HoldToInteract = false,
                Callback = function(key)
                    pcEscapeKeybind = key
                end,
            })

        elseif isFluent then
            MegumiTab:AddToggle("Megumi_NueBsAim", {
                Title = "NUE! USE BS AIM!",
                Default = false,
                Callback = toggleNueBsAim,
            })

            MegumiTab:AddToggle("Megumi_Nue180", {
                Title = "NUE! 180 DEGREES TECH!",
                Default = false,
                Callback = toggleNue180Tech,
            })

            MegumiTab:AddToggle("Megumi_TrashEscape", {
                Title = "I CAN'T FIGHT PLEASE I NEED TO ESCAAAAPE!!!",
                Default = false,
                Callback = toggleTrashEscape,
            })

            MegumiTab:AddKeybind("Megumi_EscapeKeybind", {
                Title = "Escape PC Keybind (Optional)",
                Mode = "Toggle",
                Default = "None",
                Callback = function(key)
                    pcEscapeKeybind = Enum.KeyCode[key] or Enum.KeyCode.Unknown
                end,
            })

        elseif isLinoria then
            local group = MegumiTab:AddLeftGroupbox("Ten Shadows / Megumi Engine")

            group:AddToggle("Megumi_NueBsAim", {
                Text = "NUE! USE BS AIM!",
                Default = false,
                Callback = toggleNueBsAim,
