local function buildGradientSequence(mode)
    if mode == "Linear" then
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(40, 40, 40)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 15, 15))
        })
    elseif mode == "Stripes" then
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(45, 45, 45)),
            ColorSequenceKeypoint.new(0.24, Color3.fromRGB(45, 45, 45)),
            ColorSequenceKeypoint.new(0.25, Color3.fromRGB(20, 20, 20)),
            ColorSequenceKeypoint.new(0.49, Color3.fromRGB(20, 20, 20)),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(45, 45, 45)),
            ColorSequenceKeypoint.new(0.74, Color3.fromRGB(45, 45, 45)),
            ColorSequenceKeypoint.new(0.75, Color3.fromRGB(20, 20, 20)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 20, 20))
        })
    elseif mode == "Midnight" then
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(15, 20, 35)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(8, 8, 12))
        })
    elseif mode == "Sunset" then
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(50, 20, 35)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 10, 18))
        })
    elseif mode == "Amethyst" then
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(42, 18, 55)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(14, 10, 18))
        })
    elseif mode == "Emerald" then
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(14, 38, 25)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(8, 16, 12))
        })
    end
    return nil
end

