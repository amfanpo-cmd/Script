        createBtn("SUMM", function() standVanished = false; playStandIdle() end)
        createBtn("DISM", function() standVanished = true; stopStandIdle() end)
        createBtn("M1", function()
            local target = findTargetPlayer(standTargetName)
            if target then executeM1Combo(target) end
        end)
        createBtn("ULT", function()
            standAttacking = true
            stopStandIdle()
            local mv = getMoveset()
            if mv then fireKnitRemote(mv .. "Service", "Ultimate") end
            pressKey(Enum.KeyCode.G)
            waitForAttackFinished(3.0)
            standAttacking = false
            if standEnabled and not standVanished then playStandIdle() end
        end)
        createBtn("1", function()
            standAttacking = true
            stopStandIdle()
            pressKey(Enum.KeyCode.One)
            waitForAttackFinished(2.0)
            standAttacking = false
            if standEnabled and not standVanished then playStandIdle() end
        end)
        createBtn("2", function()
            standAttacking = true
            stopStandIdle()
            pressKey(Enum.KeyCode.Two)
            waitForAttackFinished(2.0)
            standAttacking = false
            if standEnabled and not standVanished then playStandIdle() end
        end)
        createBtn("3", function()
