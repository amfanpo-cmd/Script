    local function LockFacingTowardThreat(threatPos)
        if not AutoBlock.Settings.AutoLockOnBlock or not threatPos then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local flatThreat = Vector3.new(threatPos.X, hrp.Position.Y, threatPos.Z)
        local dir = (flatThreat - hrp.Position)
        if dir.Magnitude > 0.2 then
            hrp.CFrame = CFrame.lookAt(hrp.Position, flatThreat)
        end
    end

    local function GetCurrentMoveset()
        local char = LocalPlayer.Character
        if not char then return nil end
        local ms = char:GetAttribute("Moveset") or LocalPlayer:GetAttribute("Moveset")
        if ms then return ms end

        local movesetFolder = char:FindFirstChild("Moveset")
        if movesetFolder then
            return movesetFolder:IsA("StringValue") and movesetFolder.Value or movesetFolder.Name
        end
        return nil
    end

    local function FireMovesetM1(targetChar)
        local char = LocalPlayer.Character
        if not char then return false end
        local moveset = GetCurrentMoveset()
        if not moveset then return false end

        local rawName = (moveset == "Makora" and "Mahoraga") or moveset
        local cleanName = string.gsub(rawName, "%s+", "")

        local knit = ReplicatedStorage:FindFirstChild("Knit")
        local services = knit and ((knit:FindFirstChild("Knit") and knit.Knit:FindFirstChild("Services")) or knit:FindFirstChild("Services"))
        local svc = services and services:FindFirstChild(cleanName .. "Service")
        local re = svc and svc:FindFirstChild("RE")
        local activated = re and re:FindFirstChild("Activated")

        if activated then
            pcall(function()
                activated:FireServer(false, targetChar)
            end)
            return true
        end
        return false
    end

    local function TriggerVirtualM1()
        local isPC = UserInputService.KeyboardEnabled and UserInputService.MouseEnabled
        if not isPC then return end

        if mouse1click then
            pcall(mouse1click)
        elseif VirtualInputManager then
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                task.wait(0.02)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
            end)
        end
    end

    local function ExecuteXenoPunish(targetChar)
        if not AutoBlock.Settings.AutoPunishEnabled or PunishBusy then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not hrp then return end

        local target = targetChar
        if not (target and target.Parent and not isTargetInvalid(target)) then
            local shortestDist = (AutoBlock.Settings.PunishRange or 25)
            local charsFolder = Workspace:FindFirstChild("Characters") or Workspace
            for _, c in ipairs(charsFolder:GetChildren()) do
                if c:IsA("Model") and c ~= char and not isTargetInvalid(c) and not c:FindFirstChildOfClass("ForceField") then
                    local tHrp = c:FindFirstChild("HumanoidRootPart")
                    if tHrp then
                        local d = (tHrp.Position - hrp.Position).Magnitude
                        if d <= shortestDist then
                            shortestDist = d
                            target = c
                        end
                    end
                end
            end
        end

        if not target or isTargetInvalid(target) then return end
        local targetRoot = target:FindFirstChild("HumanoidRootPart")
        if not targetRoot then return end

        local dist = (targetRoot.Position - hrp.Position).Magnitude
        if dist > AutoBlock.Settings.PunishRange then return end

        PunishBusy = true
        task.spawn(function()
            if AutoBlock.Settings.PunishDelay > 0 then
                task.wait(AutoBlock.Settings.PunishDelay)
            end

            if isTargetInvalid(target) then
                PunishBusy = false
                return
            end

            if AutoBlock.Settings.AutoLockOnBlock then
                LockFacingTowardThreat(targetRoot.Position)
            end

            local success = FireMovesetM1(target)
            if not success or UserInputService.KeyboardEnabled then
                TriggerVirtualM1()
            end

            task.wait(0.2)
            PunishBusy = false
        end)
    end

    local function FireBlockActivated(threatPos)
        if threatPos then
            LockFacingTowardThreat(threatPos)
        end

        if not IsPhysicallyBlocking then
            IsPhysicallyBlocking = true
            if not ActivatedRemote then ResolveBlockRemotes() end

            if ActivatedRemote then
                pcall(function() ActivatedRemote:FireServer(nil) end)
            end
        end
        GlobalBlockCount = GlobalBlockCount + 1
    end

    local function FireBlockDeactivated(sourceChar)
        GlobalBlockCount = math.max(0, GlobalBlockCount - 1)
        if GlobalBlockCount == 0 and IsPhysicallyBlocking then
            IsPhysicallyBlocking = false
            if not DeactivatedRemote then ResolveBlockRemotes() end

            if DeactivatedRemote then
                pcall(function() DeactivatedRemote:FireServer() end)
            end

            if sourceChar and not isTargetInvalid(sourceChar) then
                ExecuteXenoPunish(sourceChar)
            end
        end
    end

    local function TimedBlock(duration, threatPos)
        FireBlockActivated(threatPos)
        local releaseAt = os.clock() + duration
        if releaseAt > BlockScheduledReleaseTime then
            BlockScheduledReleaseTime = releaseAt
        end

        task.delay(duration, function()
            if os.clock() >= BlockScheduledReleaseTime then
                FireBlockDeactivated(nil)
            end
        end)
    end

    local function getOneWayPing()
        if not AutoBlock.Settings.PingCompensation then return 0 end
        local success, pingMs = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        if success and pingMs and pingMs > 0 then
            return (pingMs / 1000) * 0.5
        end
        return 0.025
    end

    local function IsLocalPlayerAttacking()
        local localChar = LocalPlayer.Character
        if not localChar then return false end
        local humanoid = localChar:FindFirstChildOfClass("Humanoid")
        if not humanoid then return false end
        for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
            if track.IsPlaying then
                local animName = string.lower(track.Animation.Name)
                local isMovement = false
                for i = 1, #MovementStateKeywords do
                    if string.find(animName, MovementStateKeywords[i], 1, true) then 
                        isMovement = true 
                        break 
                    end
                end
                if not isMovement then return true end
            end
        end
        return false
    end

    local function IsLocalPlayerIncapacitated()
        local localChar = LocalPlayer.Character
        if not localChar then return true end
        if localChar:GetAttribute("Dead") then return true end
        local ragdollVal = localChar:GetAttribute("Ragdoll")
        if ragdollVal and ragdollVal > 0 then return true end
        return false
    end

    local function IsEnemyFeinting(character)
        if not AutoBlock.Settings.AntiFeintEnabled then return false end
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return false end
        local feintInstance = rootPart:FindFirstChild("Feint")
        if feintInstance then
            local ringParticle = feintInstance:FindFirstChild("Ring")
            if ringParticle and ringParticle:IsA("ParticleEmitter") then
                for _, keypoint in ipairs(ringParticle.Color.Keypoints) do
                    local val = keypoint.Value
                    if math.abs(val.R - val.G) < 0.05 and math.abs(val.G - val.B) < 0.05 then
                        return true
                    end
                end
            end
        end
        return false
    end

    local function matchValidProjectile(name)
        local clean = string.lower(name):gsub("%s+", ""):gsub("[^%a%d]", "")
        for key, data in pairs(VALID_PROJECTILES) do
            if string.find(clean, key, 1, true) then
                return data, key
            end
        end
        return nil
    end

    local function getRootPart(instance)
        if instance:IsA("BasePart") then
            return instance
        elseif instance:IsA("Model") then
            if instance.PrimaryPart then return instance.PrimaryPart end
            return instance:FindFirstChildWhichIsA("BasePart")
        end
        return nil
    end

    local function registerProjectile(instance)
        if not AutoBlock.Settings.ProjectileBlock or not instance or not instance.Parent then return end

        local profile, matchedKey = matchValidProjectile(instance.Name)
        if not profile and instance.Parent and instance.Parent:IsA("Model") then
            profile, matchedKey = matchValidProjectile(instance.Parent.Name)
        end

        if profile then
            local root = getRootPart(instance)
            if root and not TrackedProjectiles[root] then
                TrackedProjectiles[root] = {
                    profile = profile,
                    name = matchedKey,
                    lastPos = root.Position,
                    lastTime = os.clock()
                }
            end
        end
    end

    local function processProjectileTrajectories()
        if not AutoBlock.Settings.ProjectileBlock then return end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 or IsLocalPlayerIncapacitated() then return end

        local myLook = hrp.CFrame.LookVector
        local blockBoxCenter = hrp.Position + (myLook * 1.0)
        local blockBoxRadius = 1.42

        local now = os.clock()
        local pingDelay = getOneWayPing()
        local requiredAlignment = 1.0 - math.clamp(AutoBlock.Settings.ProjectileFacingSensitivity, 0.05, 0.95)

        for part, data in pairs(TrackedProjectiles) do
            if not part:IsDescendantOf(Workspace) then
                TrackedProjectiles[part] = nil
            else
                local curPos = part.Position
                local vel = part.AssemblyLinearVelocity

                if vel.Magnitude < 10 then
                    local dt = math.max(0.001, now - data.lastTime)
                    vel = (curPos - data.lastPos) / dt
                end

                data.lastPos = curPos
                data.lastTime = now

                local speed = vel.Magnitude
                local toBlockBox = blockBoxCenter - curPos
                local distance = toBlockBox.Magnitude

                if distance <= AutoBlock.Settings.ProjectileMaxRange and speed > 8 then
                    local projDir = vel.Unit
                    local targetDir = toBlockBox.Unit

                    local projApproachDot = projDir:Dot(targetDir)
                    local playerFacingDot = myLook:Dot((curPos - hrp.Position).Unit)

                    if projApproachDot >= requiredAlignment and playerFacingDot >= requiredAlignment then
                        local projScalar = toBlockBox:Dot(projDir)
                        local closestPoint = curPos + (projDir * projScalar)
                        local missDistance = (blockBoxCenter - closestPoint).Magnitude

                        local partLeeway = math.clamp(part.Size.Magnitude * 0.35, 0.8, 3.5)
                        local effectiveHitboxRadius = blockBoxRadius + partLeeway

                        if missDistance <= effectiveHitboxRadius then
                            local earlyHit = data.profile.earlyHitStuds or 1.0
                            local effectiveDistance = math.max(0, distance - earlyHit)
                            local tti = effectiveDistance / speed

                            local frameSafetyMargin = math.clamp((speed * 0.025) / speed, 0.05, 0.15)
                            local triggerThreshold = 0.12 + pingDelay + frameSafetyMargin

                            if tti <= triggerThreshold and tti >= -0.05 then
                                local holdDuration = AutoBlock.Settings.CustomBlockDurationEnabled 
                                    and AutoBlock.Settings.CustomBlockDuration 
                                    or math.clamp(tti + 0.28, 0.22, 0.48)

                                TimedBlock(holdDuration, curPos)
                                TrackedProjectiles[part] = nil
                            end
                        end
                    end
                end
            end
        end
    end

    local function HandleStandardAnimationPlay(character, animationTrack)
        if not AutoBlock.Settings.AutoBlockEnabled then return end
        if not animationTrack or not animationTrack.Animation then return end
        
        local animationName = animationTrack.Animation.Name
        local lowerName = string.lower(animationName)
        local rawId = string.match(tostring(animationTrack.Animation.AnimationId), "%d+")
        
        for i = 1, #MovementStateKeywords do
            if string.find(lowerName, MovementStateKeywords[i], 1, true) then return end
        end
        
        local charPlayer = Players:GetPlayerFromCharacter(character)
        if charPlayer == LocalPlayer then return end
        if not AutoBlock.Settings.BlockWhileAttacking and IsLocalPlayerAttacking() then return end
        if IsLocalPlayerIncapacitated() then return end
        if isTargetInvalid(character) then return end
        
        local localChar = LocalPlayer.Character
        if not localChar then return end
        local localRoot = localChar:FindFirstChild("HumanoidRootPart")
        local targetRoot = character:FindFirstChild("HumanoidRootPart")
        if not localRoot or not targetRoot then return end
        
        local distance = (localRoot.Position - targetRoot.Position).Magnitude
        if distance > AutoBlock.Settings.DetectionRange then return end
        
        if AutoBlock.Settings.FacingCheckEnabled then
            local enemyLookVector = targetRoot.CFrame.LookVector
            local directionToUs = (localRoot.Position - targetRoot.Position).Unit
            local facingDotProduct = enemyLookVector:Dot(directionToUs)
            if facingDotProduct < AutoBlock.Settings.FacingAngleThreshold then return end
        end
        
        if IsEnemyFeinting(character) then return end
        if table.find(AutoBlock.Settings.ExcludedAnimations, animationName) then return end
        if ActiveBlockingTracks[animationTrack] then return end
        
        local isEnemyCountering = string.find(lowerName, "counter", 1, true) 
            or string.find(lowerName, "manji", 1, true) 
            or string.find(lowerName, "parry", 1, true)
            or (rawId and AutoBlock.Settings.CounterAnimations[rawId] == true)
            or (rawId and AutoBlock.Settings.CounterAnimeAnimations[rawId] == true)

        if (AutoBlock.Settings.NoBlockOnCounter or AutoBlock.Settings.NoBlockAndCounterAnime) and isEnemyCountering then
            return
        end

        ActiveBlockingTracks[animationTrack] = true
        FireBlockActivated(targetRoot.Position)
        
        if AutoBlock.Settings.BlockForAnimation then
            local connection
            connection = animationTrack.Stopped:Once(function()
                if ActiveBlockingTracks[animationTrack] then
                    ActiveBlockingTracks[animationTrack] = nil
                    FireBlockDeactivated(character)
                end
            end)
            table.insert(ActiveConnections, connection)
            
            task.delay(5, function()
                if ActiveBlockingTracks[animationTrack] then
                    ActiveBlockingTracks[animationTrack] = nil
                    FireBlockDeactivated(character)
                end
            end)
        elseif AutoBlock.Settings.BlockForDuration then
            task.spawn(function()
                task.wait(AutoBlock.Settings.BlockDuration)
                if ActiveBlockingTracks[animationTrack] then
                    ActiveBlockingTracks[animationTrack] = nil
                    FireBlockDeactivated(character)
                end
            end)
        end
    end

    local function ConnectLocalCharacter(char)
        if not char then return end
        local humanoid = char:WaitForChild("Humanoid", 5)
        if humanoid then
            local conn = humanoid.AnimationPlayed:Connect(function(track)
                if not AutoBlock.Settings.NoBlockAndCounterAnime then return end
                if not track or not track.Animation then return end
                local rawId = string.match(tostring(track.Animation.AnimationId), "%d+")
                if rawId and AutoBlock.Settings.CounterAnimeAnimations[rawId] then
                    track:Stop()
                end
            end)
            table.insert(ActiveConnections, conn)
        end
        ResolveBlockRemotes()
    end

    local function ConnectCharacter(char)
        if ConnectedCharacters[char] then return end
        local charPlayer = Players:GetPlayerFromCharacter(char)
        if charPlayer == LocalPlayer then return end
        
        local humanoid = char:WaitForChild('Humanoid', 5)
        if humanoid then
            ConnectedCharacters[char] = true
            local conn = humanoid.AnimationPlayed:Connect(function(track)
                HandleStandardAnimationPlay(char, track)
            end)
            table.insert(ActiveConnections, conn)
        end
    end

    local function SetupWorkspaceConnections()
        local CharactersFolder = Workspace:WaitForChild('Characters', 10) or Workspace:FindFirstChild('Characters')
        if CharactersFolder then
            for _, char in ipairs(CharactersFolder:GetChildren()) do 
                ConnectCharacter(char) 
            end
            
            local childAddedConn = CharactersFolder.ChildAdded:Connect(function(newChar)
                task.wait(0.3)
                ConnectCharacter(newChar)
            end)
            table.insert(ActiveConnections, childAddedConn)
        end

        local bullets = Workspace:FindFirstChild("Bullets")
        if bullets then
            bullets.ChildAdded:Connect(registerProjectile)
            for _, b in ipairs(bullets:GetChildren()) do
                registerProjectile(b)
            end
        end

        local effects = Workspace:FindFirstChild("Effects")
        if effects then
            effects.ChildAdded:Connect(registerProjectile)
        end

        local workspaceChildConn = Workspace.ChildAdded:Connect(function(child)
            if child.Name == "Bullets" then
                child.ChildAdded:Connect(registerProjectile)
            else
                registerProjectile(child)
            end
        end)
        table.insert(ActiveConnections, workspaceChildConn)

        local heartbeat = RunService.Heartbeat:Connect(processProjectileTrajectories)
        table.insert(ActiveConnections, heartbeat)
    end

    local function StartEffectsMonitor()
        local EffectsFolder = Workspace:WaitForChild("Effects", 10) or Workspace:FindFirstChild("Effects")
        if not EffectsFolder then return end
        
        local effectConn = EffectsFolder.ChildAdded:Connect(function(child)
            if not AutoBlock.Settings.AutoBlockEnabled or not AutoBlock.Settings.HitGlowBlock then return end
            
            if child.Name == "HitGlow" or child.Name == "BlockHit" then
                local now = os.clock()
                if now - LastHitGlowTime < 0.3 then return end
                LastHitGlowTime = now
                
                local localChar = LocalPlayer.Character
                if not localChar then return end
                
                local weld = child:FindFirstChildOfClass("Weld")
                if weld then
                    local p0 = weld.Part0
                    local p1 = weld.Part1
                    if (p0 and p0:IsDescendantOf(localChar)) or (p1 and p1:IsDescendantOf(localChar)) then
                        TimedBlock(0.2, nil)
                    end
                end
            end
        end)
        table.insert(ActiveConnections, effectConn)
    end

    function AutoBlock.Init()
        if LocalPlayer.Character then
            ConnectLocalCharacter(LocalPlayer.Character)
        end
        local charAddedConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
            task.wait(0.5)
            ConnectLocalCharacter(newChar)
            table.clear(TrackedProjectiles)
            if IsPhysicallyBlocking then
                IsPhysicallyBlocking = false
                GlobalBlockCount = 0
                FireBlockDeactivated(nil)
            end
        end)
        table.insert(ActiveConnections, charAddedConn)

        task.spawn(SetupWorkspaceConnections)
        task.spawn(StartEffectsMonitor)
    end

    AutoBlock.Init()

    if AutoBlockTab then
        if type(AutoBlockTab.CreateSection) == "function" then
            AutoBlockTab:CreateSection("Melee")

            AutoBlockTab:CreateToggle({
                Name = "Auto Block",
                CurrentValue = false,
