loadModule("Events", Tab_Events, function()
local Module = {}

local function safeGetService(name)
    local service = game:GetService(name)
    if cloneref then
        local ok, cloned = pcall(cloneref, service)
        if ok and cloned then return cloned end
    end
    return service
end

local ProximityPromptService = safeGetService("ProximityPromptService")
local Workspace = safeGetService("Workspace")
local Players = safeGetService("Players")
local RunService = safeGetService("RunService")
local CoreGui = safeGetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

function Module.Init(EventTab)
    if not EventTab then return end

    local Settings = {
        InstantPP = false,
        BoostReach = false,
        MaxReachDistance = 25,
        DoorESP = false,
        ESPMaxDistance = 5000
    }

    local State = {
        PPConnections = {},
        OriginalHoldDurations = setmetatable({}, { __mode = "k" }),
        OriginalLOS = setmetatable({}, { __mode = "k" }),
        OriginalDistances = setmetatable({}, { __mode = "k" }),
        ESPConnections = {},
        HighlightedDoors = {},
        DistanceLoopThread = nil,
        IsGrabbingAll = false
    }

    local COLOR_PUMPKIN = Color3.fromRGB(255, 115, 0)
    local COLOR_TEXT = Color3.fromRGB(255, 170, 0)
    local TARGET_DOOR_NAME = "halloweendoor"

    local function getRootPart(char)
        char = char or LocalPlayer.Character
        return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char.PrimaryPart)
    end

    local function isDoorModel(obj)
        if not obj then return false end
        local name = string.lower(obj.Name)
        return name == TARGET_DOOR_NAME or string.find(name, TARGET_DOOR_NAME, 1, true) ~= nil
    end

    local function applyInstantPrompt(prompt)
        if not prompt or not prompt:IsA("ProximityPrompt") then return end

        pcall(function()
            if State.OriginalHoldDurations[prompt] == nil then
                State.OriginalHoldDurations[prompt] = prompt.HoldDuration
            end
            if State.OriginalLOS[prompt] == nil then
                State.OriginalLOS[prompt] = prompt.RequiresLineOfSight
            end
            if State.OriginalDistances[prompt] == nil then
                State.OriginalDistances[prompt] = prompt.MaxActivationDistance
            end

            if Settings.InstantPP then
                prompt.HoldDuration = 0
                prompt.RequiresLineOfSight = false

                if Settings.BoostReach and prompt.MaxActivationDistance < Settings.MaxReachDistance then
                    prompt.MaxActivationDistance = Settings.MaxReachDistance
                end
            end
        end)
    end

    local function restorePrompt(prompt)
        if not prompt or not prompt:IsA("ProximityPrompt") then return end
        pcall(function()
            if State.OriginalHoldDurations[prompt] ~= nil then
                prompt.HoldDuration = State.OriginalHoldDurations[prompt]
            end
            if State.OriginalLOS[prompt] ~= nil then
                prompt.RequiresLineOfSight = State.OriginalLOS[prompt]
            end
            if State.OriginalDistances[prompt] ~= nil then
                prompt.MaxActivationDistance = State.OriginalDistances[prompt]
            end
        end)
    end

    local function setInstantPPState(enabled)
        Settings.InstantPP = enabled

        if enabled then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") then
                    applyInstantPrompt(obj)
                end
            end

            local addedConn = Workspace.DescendantAdded:Connect(function(desc)
                if desc:IsA("ProximityPrompt") then
                    task.defer(applyInstantPrompt, desc)
                end
            end)
            table.insert(State.PPConnections, addedConn)

            local holdBegan = ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
                if not Settings.InstantPP then return end
                pcall(function()
                    prompt.HoldDuration = 0
                    prompt.RequiresLineOfSight = false
                    if fireproximityprompt then
                        fireproximityprompt(prompt)
                    end
                end)
            end)
            table.insert(State.PPConnections, holdBegan)
        else
            for _, conn in ipairs(State.PPConnections) do
                if typeof(conn) == "RBXScriptConnection" and conn.Connected then
                    conn:Disconnect()
                end
            end
            table.clear(State.PPConnections)

            for prompt in pairs(State.OriginalHoldDurations) do
                if prompt and prompt.Parent then
                    restorePrompt(prompt)
                end
            end
            table.clear(State.OriginalHoldDurations)
            table.clear(State.OriginalLOS)
            table.clear(State.OriginalDistances)
        end
    end

    local function removeSingleDoorESP(door)
        if not door then return end

        local hl = door:FindFirstChild("HalloweenDoor_Highlight")
        if hl then pcall(hl.Destroy, hl) end

        local bb = door:FindFirstChild("HalloweenDoor_Billboard")
        if bb then pcall(bb.Destroy, bb) end

        State.HighlightedDoors[door] = nil
    end

    local function clearAllDoorESP()
        for door in pairs(State.HighlightedDoors) do
            removeSingleDoorESP(door)
        end
        table.clear(State.HighlightedDoors)
    end

    local function applyDoorESP(door)
        if not Settings.DoorESP or not door or not door.Parent or not isDoorModel(door) then return end
        if State.HighlightedDoors[door] then return end

        local targetPart = door:IsA("BasePart") and door 
            or (door:IsA("Model") and (door.PrimaryPart or door:FindFirstChildWhichIsA("BasePart", true)))

        if not targetPart then return end

        removeSingleDoorESP(door)
        State.HighlightedDoors[door] = targetPart

        pcall(function()
            local highlight = Instance.new("Highlight")
            highlight.Name = "HalloweenDoor_Highlight"
            highlight.Adornee = door
            highlight.FillColor = COLOR_PUMPKIN
            highlight.FillTransparency = 0.55
            highlight.OutlineTransparency = 1
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Parent = door

            local billboard = Instance.new("BillboardGui")
            billboard.Name = "HalloweenDoor_Billboard"
            billboard.Adornee = targetPart
            billboard.Size = UDim2.new(0, 160, 0, 36)
            billboard.StudsOffset = Vector3.new(0, 3.5, 0)
            billboard.AlwaysOnTop = true
            billboard.MaxDistance = Settings.ESPMaxDistance
            billboard.Parent = door

            local label = Instance.new("TextLabel")
            label.Name = "InfoLabel"
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.Text = "ðŸŽƒ Door\n[...]"
            label.TextColor3 = COLOR_TEXT
            label.TextStrokeTransparency = 1
            label.TextSize = 13
            label.Font = Enum.Font.GothamBold
            label.Parent = billboard

            local cleanConn = door.AncestryChanged:Connect(function(_, parent)
                if not parent then
                    removeSingleDoorESP(door)
                end
            end)
            table.insert(State.ESPConnections, cleanConn)
        end)
    end

    local function setDoorESPState(enabled)
        Settings.DoorESP = enabled

        if enabled then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if isDoorModel(obj) then
                    task.spawn(applyDoorESP, obj)
                end
            end

            local addedConn = Workspace.DescendantAdded:Connect(function(desc)
                if isDoorModel(desc) then
                    task.wait(0.05)
                    applyDoorESP(desc)
                end
            end)
            table.insert(State.ESPConnections, addedConn)

            State.DistanceLoopThread = task.spawn(function()
                while Settings.DoorESP do
                    local root = getRootPart()
                    local myPos = root and root.Position

                    if myPos then
                        for model, part in pairs(State.HighlightedDoors) do
                            if model and model.Parent and part and part.Parent then
                                local bb = model:FindFirstChild("HalloweenDoor_Billboard")
                                local lbl = bb and bb:FindFirstChild("InfoLabel")

                                if lbl then
                                    local dist = math.floor((part.Position - myPos).Magnitude)
                                    lbl.Text = string.format("ðŸŽƒ Door\n[%d studs]", dist)
                                end
                            else
                                removeSingleDoorESP(model)
                            end
                        end
                    end
                    task.wait(0.1)
                end
            end)
        else
            if State.DistanceLoopThread then
                task.cancel(State.DistanceLoopThread)
                State.DistanceLoopThread = nil
            end

            for _, conn in ipairs(State.ESPConnections) do
                if typeof(conn) == "RBXScriptConnection" and conn.Connected then
                    conn:Disconnect()
                end
            end
            table.clear(State.ESPConnections)
            clearAllDoorESP()
        end
    end

    local function getNearestDoor()
        local root = getRootPart()
        if not root then return nil, math.huge end

        local nearestDoor = nil
        local shortestDist = math.huge

        for _, obj in ipairs(Workspace:GetDescendants()) do
            if isDoorModel(obj) then
                local part = obj:IsA("BasePart") and obj 
                    or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)))

                if part then
                    local dist = (part.Position - root.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearestDoor = obj
                    end
                end
            end
        end

        return nearestDoor, shortestDist
    end

    local function teleportToNearestDoor()
        local door, dist = getNearestDoor()
        local root = getRootPart()
        if not door or not root then return end

        local part = door:IsA("BasePart") and door 
            or (door:IsA("Model") and (door.PrimaryPart or door:FindFirstChildWhichIsA("BasePart", true)))

        if part then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = CFrame.lookAt(part.Position + (part.CFrame.LookVector * 4), part.Position)
        end
    end

    local function interactNearestDoor()
        local door = getNearestDoor()
        if not door then return end

        local prompt = door:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            pcall(function()
                prompt.HoldDuration = 0
                prompt.RequiresLineOfSight = false
                if fireproximityprompt then
                    fireproximityprompt(prompt)
                end
            end)
        end
    end

    local function getAllDoors()
        if State.IsGrabbingAll then return end
        State.IsGrabbingAll = true

        task.spawn(function()
            local root = getRootPart()
            if not root then
                State.IsGrabbingAll = false
                return
            end

            local doors = {}
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if isDoorModel(obj) then
                    local part = obj:IsA("BasePart") and obj 
                        or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)))
                    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)

                    if part and prompt then
                        table.insert(doors, {
                            Model = obj,
                            Part = part,
                            Prompt = prompt
                        })
                    end
                end
            end

            for _, entry in ipairs(doors) do
                if not State.IsGrabbingAll then break end
                if entry.Model.Parent and entry.Part.Parent and root.Parent then
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    root.CFrame = entry.Part.CFrame + Vector3.new(0, 1, 0)

                    for _ = 1, 3 do
                        pcall(function()
                            entry.Prompt.HoldDuration = 0
                            entry.Prompt.RequiresLineOfSight = false
                            if fireproximityprompt then
                                fireproximityprompt(entry.Prompt, 0)
                            end
                        end)
                        task.wait(0.05)
                    end
                    task.wait(0.15)
                end
            end

            State.IsGrabbingAll = false
        end)
    end

    if EventTab then
        if type(EventTab.CreateSection) == "function" then
            EventTab:CreateSection("Doors")

            EventTab:CreateToggle({
                Name = "Door ESP",
                CurrentValue = Settings.DoorESP,
                Flag = "EventDoorESPFlag",
                Callback = setDoorESPState
            })

            EventTab:CreateButton({
                Name = "Get All Doors",
                Callback = getAllDoors
            })

            EventTab:CreateButton({
                Name = "TP to Door",
                Callback = teleportToNearestDoor
            })

            EventTab:CreateButton({
                Name = "Interact Door",
                Callback = interactNearestDoor
            })

            EventTab:CreateSection("Prompts")

            EventTab:CreateToggle({
                Name = "Instant Prompts",
                CurrentValue = Settings.InstantPP,
                Flag = "EventInstantPPFlag",
                Callback = setInstantPPState
            })

            EventTab:CreateToggle({
                Name = "Boost Reach",
                CurrentValue = Settings.BoostReach,
                Flag = "EventBoostReachFlag",
                Callback = function(v)
                    Settings.BoostReach = v
                    if Settings.InstantPP then
                        setInstantPPState(true)
                    end
                end
            })

            EventTab:CreateSlider({
                Name = "Reach Distance",
                Range = {10, 60},
                Increment = 1,
                Suffix = " studs",
                CurrentValue = Settings.MaxReachDistance,
                Flag = "EventReachDistanceFlag",
                Callback = function(v)
                    Settings.MaxReachDistance = v
                    if Settings.InstantPP and Settings.BoostReach then
                        setInstantPPState(true)
                    end
                end
            })

        elseif type(EventTab.AddToggle) == "function" or type(EventTab.AddLeftGroupbox) == "function" then
            local LeftBox = EventTab.AddLeftGroupbox and EventTab:AddLeftGroupbox("Doors") or EventTab
            local RightBox = EventTab.AddRightGroupbox and EventTab:AddRightGroupbox("Prompts") or EventTab

            LeftBox:AddToggle("DoorESP", {
                Text = "Door ESP",
                Default = Settings.DoorESP,
                Callback = setDoorESPState
            })

            LeftBox:AddButton("Get All Doors", getAllDoors)
            LeftBox:AddButton("TP to Door", teleportToNearestDoor)
            LeftBox:AddButton("Interact Door", interactNearestDoor)

            RightBox:AddToggle("InstantPP", {
                Text = "Instant Prompts",
                Default = Settings.InstantPP,
                Callback = setInstantPPState
            })

            RightBox:AddToggle("BoostReach", {
                Text = "Boost Reach",
                Default = Settings.BoostReach,
                Callback = function(v)
                    Settings.BoostReach = v
                    if Settings.InstantPP then setInstantPPState(true) end
                end
            })

            RightBox:AddSlider("MaxReachDist", {
                Text = "Reach Distance",
                Default = Settings.MaxReachDistance,
                Min = 10,
                Max = 60,
                Rounding = 0,
                Increment = 1,
                Callback = function(v)
                    Settings.MaxReachDistance = v
                    if Settings.InstantPP and Settings.BoostReach then setInstantPPState(true) end
                end
            })
        end
    end

    return {
        Settings = Settings,
        TeleportDoor = teleportToNearestDoor,
        InteractDoor = interactNearestDoor,
        GetAllDoors = getAllDoors,
        Unload = function()
            State.IsGrabbingAll = false
            setInstantPPState(false)
            setDoorESPState(false)
        end
    }
end

setmetatable(Module, {
