            })

            RightBox:AddInput("TargetPlayer", {
                Text = "Target Player",
                Default = "",
                Placeholder = "Username or Display Name",
                Callback = function(v) Settings.TargetPlayerName = v end
            })

            RightBox:AddButton("Trigger Todo Bring", executeTodoBring)
        end
    end

    ---------------------------------------------------------------------------
    -- PUBLIC MODULE INTERFACE
    ---------------------------------------------------------------------------
    return {
        Settings = Settings,
        TriggerBFC = executeBruteForceSecondHit,
        TriggerBring = executeTodoBring,
        Swap2Nearest = executeSwap2Nearest,
        Unload = function()
            for _, conn in ipairs(State.Connections) do
                if conn and conn.Disconnect then conn:Disconnect() end
            end
            table.clear(State.Connections)
        end
    }
end
end)

