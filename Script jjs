            local lastTouchPos = nil
            local touchStart = UserInputService.InputBegan:Connect(function(input, gpe)
                if gpe or not freecamActive then return end
                if input.UserInputType == Enum.UserInputType.Touch then
                    lastTouchPos = input.Position
                end
            end)
            table.insert(freecamConnections, touchStart)

            local touchChange = UserInputService.InputChanged:Connect(function(input, gpe)
                if not freecamActive then return end
                if input.UserInputType == Enum.UserInputType.MouseMovement and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                    rotY = rotY - input.Delta.X * 0.32
                    rotX = math.clamp(rotX - input.Delta.Y * 0.32, -88, 88)
                elseif input.UserInputType == Enum.UserInputType.Touch and lastTouchPos and not gpe then
                    local delta = input.Position - lastTouchPos
                    if delta.Magnitude > 3 then
                        lastTouchPos = input.Position
                        rotY = rotY - delta.X * 0.28
                        rotX = math.clamp(rotX - delta.Y * 0.28, -88, 88)
                    end
                end
            end)
            table.insert(freecamConnections, touchChange)

            local touchEnd = UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch then
                    lastTouchPos = nil
                end
            end)
            table.insert(freecamConnections, touchEnd)

            local renderStep = RunService.RenderStepped:Connect(function(dt)
                if not freecamActive then return end
                Camera.CameraType = Enum.CameraType.Scriptable

                local speedMultiplier = 1.0
                if keys.Sprint then speedMultiplier = 2.5
                elseif keys.Slow then speedMultiplier = 0.35 end

                local effectiveSpeed = targetSpeed * speedMultiplier

                local rawInputVector = Vector3.new(
                    (keys.Right and 1 or 0) - (keys.Left and 1 or 0),
                    (keys.Up and 1 or 0) - (keys.Down and 1 or 0),
                    (keys.Backward and 1 or 0) - (keys.Forward and 1 or 0)
                )

                if rawInputVector.Magnitude > 0 then
                    rawInputVector = rawInputVector.Unit
                end

                local rotationCFrame = CFrame.Angles(0, math.rad(rotY), 0) * CFrame.Angles(math.rad(rotX), 0, 0)
                local targetWorldVelocity = rotationCFrame:VectorToWorldSpace(rawInputVector * (effectiveSpeed * 60))

                currentVelocity = currentVelocity:Lerp(targetWorldVelocity, math.clamp(dt * (freecamSmoothness * 60), 0.05, 1.0))
                Camera.CFrame = CFrame.new(Camera.CFrame.Position + (currentVelocity * dt)) * rotationCFrame

                Camera.FieldOfView = Camera.FieldOfView + (targetFOV - Camera.FieldOfView) * math.clamp(dt * 12, 0.05, 1.0)
            end)
            table.insert(freecamConnections, renderStep)

            local respawnConn = LocalPlayer.CharacterAdded:Connect(function()
                if freecamActive then
                    task.wait(0.2)
                    setCharacterFrozen(true)
                end
            end)
            table.insert(freecamConnections, respawnConn)
        else
            destroyFreecamGui()
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            LocalPlayer.DevCameraOcclusionMode = savedOcclusion

            Camera.CameraType = Enum.CameraType.Custom
            Camera.FieldOfView = defaultFOV

            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                Camera.CameraSubject = hum
            end

            setCharacterFrozen(false)
            for k in pairs(keys) do keys[k] = false end
        end
    end

    local function optimizeObject(obj)
        if not fpsBoostActive or not obj or not obj.Parent then return end

        pcall(function()
            local name = string.lower(obj.Name)
            if name == "debris" or name == "rubble" or name == "brokenparts" then
                obj:Destroy()
                return
            end

            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                obj.Enabled = false
            elseif obj:IsA("Highlight") or obj:IsA("Explosion") then
                if not string.find(obj.Name, "_ESP_") then
                    obj:Destroy()
                end
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = 1
            elseif obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character) then
                obj.Material = Enum.Material.SmoothPlastic
                obj.CastShadow = false
                obj.Reflectance = 0
            end
        end)
    end

    local function applyFullBoost()
        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9

            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") or v:IsA("Atmosphere") then
                    v.Enabled = false
                end
            end
        end)

        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            pcall(function()
                terrain.WaterWaveSize = 0
                terrain.WaterWaveSpeed = 0
                terrain.WaterReflectance = 0
                terrain.WaterTransparency = 0
            end)
        end

        for _, v in ipairs(Workspace:GetDescendants()) do
            optimizeObject(v)
        end
    end

    local function removeHPEsp(char)
        if not char then return end
        local hl = char:FindFirstChild("HP_ESP_Highlight")
        if hl then hl:Destroy() end
    end

    local function clearAllHPEsp()
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character then
                removeHPEsp(player.Character)
            end
        end
    end

    local function applyHPEspToCharacter(char)
        if not char or not hpEspActive then return end
        local hum = char:WaitForChild("Humanoid", 3)
        if not hum then return end

        removeHPEsp(char)

        local hl = Instance.new("Highlight")
        hl.Name = "HP_ESP_Highlight"
        hl.Adornee = char
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0

        local function updateColor()
            if hum and hum.Health > 0 and hum.MaxHealth > 0 then
                local percent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                local currentColor = COLOR_RED:Lerp(COLOR_GREEN, percent)
                hl.FillColor = currentColor
                hl.OutlineColor = currentColor
            end
        end

        updateColor()
        local healthConn = hum.HealthChanged:Connect(updateColor)
        table.insert(hpConnections, healthConn)

        local diedConn
        diedConn = hum.Died:Connect(function()
            removeHPEsp(char)
            if diedConn then diedConn:Disconnect() end
        end)
        table.insert(hpConnections, diedConn)

        hl.Parent = char
    end

    local function enableHPEsp()
        local function hookPlayer(player)
            if player == LocalPlayer then return end

            if player.Character then
                applyHPEspToCharacter(player.Character)
            end

            local charConn = player.CharacterAdded:Connect(function(char)
                if hpEspActive then
                    task.wait(0.05)
                    applyHPEspToCharacter(char)
                end
            end)
            table.insert(hpConnections, charConn)
        end

        for _, player in ipairs(Players:GetPlayers()) do
            hookPlayer(player)
        end

        local playerAddedConn = Players.PlayerAdded:Connect(hookPlayer)
        table.insert(hpConnections, playerAddedConn)
    end

    local function isNPC(model)
        if not model or not model:IsA("Model") then return false end
        if Players:GetPlayerFromCharacter(model) then return false end
        local hum = model:FindFirstChildOfClass("Humanoid")
        local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
        return hum ~= nil and hrp ~= nil and hum.Health > 0
    end

    local function removeDummyEsp(model)
